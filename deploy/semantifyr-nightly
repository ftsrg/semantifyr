set -euf

usage() {
    echo "usage: run <sha> | results <sha>" >&2
    exit 64
}

set -- ${SSH_ORIGINAL_COMMAND:-}
[ $# -eq 2 ] || usage

action=$1
sha=$2
echo "$sha" | grep -Eqx '[0-9a-f]{40}' || usage

checkout=$HOME/semantifyr

case "$action" in
    run)
        exec 9> "$HOME/nightly.lock"
        if ! flock -n 9; then
            echo "a nightly is already running" >&2
            exit 75
        fi
        [ -d "$checkout/.git" ] || git clone --quiet https://github.com/ftsrg/semantifyr.git "$checkout"
        cd "$checkout"
        git fetch --quiet origin main
        git merge-base --is-ancestor "$sha" origin/main || usage
        git checkout --quiet --force --detach "$sha"
        git clean -ffdxq
        export PATH="$HOME/tools/bin:$PATH"
        export THETA_JAVA_OPTS="-Xss512M -Xms256M -Xmx1500M"
        # half the cores at low priority keeps headroom for live; a daemon idling until the next night would hold memory
        exec nice -n 10 taskset -c 0-3 ./gradlew --no-daemon --continue integrationTest nightlyTest \
            -Ptests.requiredBackends=theta,spin,nuxmv,uppaal
        ;;
    results)
        cd "$checkout"
        [ "$(git rev-parse HEAD)" = "$sha" ] || usage
        find subprojects -path '*/build/test-results/*' -name '*.xml' | tar -czf - -T -
        ;;
    *) usage ;;
esac
