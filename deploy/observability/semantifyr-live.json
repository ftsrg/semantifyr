    {
      "type": "stat",
      "id": 5,
      "title": "Problems in the last hour",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 15,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(semantifyr_live_verification_seconds_count{instance=\"$instance\",verdict=~\"timeout|errored\"}[1h])) or vector(0)",
          "legendFormat": "timeouts and errors",
          "refId": "A",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(semantifyr_live_sessions_rejected_total{instance=\"$instance\"}[1h])) or vector(0)",
          "legendFormat": "rejected sessions",
          "refId": "B",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(ktor_http_server_requests_seconds_count{instance=\"$instance\",status=~\"5..|429\"}[1h])) or vector(0)",
          "legendFormat": "HTTP 5xx and 429",
          "refId": "C",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto",
        "showPercentChange": false
      },
      "description": "Timed out or errored verifications, sessions refused at the session limit, and HTTP answers 5xx or 429 (handshake rate limit)."
    },
    {
