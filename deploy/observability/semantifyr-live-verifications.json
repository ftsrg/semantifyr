          "expr": "sum by (kind, verdict) (increase(semantifyr_live_verification_seconds_count{instance=\"$instance\",verdict=~\"timeout|errored|not_supported|inconclusive\"}[1m]))",
          "legendFormat": "{{kind}} {{verdict}}",
