          "expr": "clamp_min(rate(semantifyr_live_container_cpu_usage_seconds_total{instance=\"@instance@\"}[$__rate_interval]) - on (instance) rate(process_cpu_time_ns_total{instance=\"@instance@\"}[$__rate_interval]) / 1e9, 0)",
          "legendFormat": "backend processes",
