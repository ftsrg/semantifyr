package semantifyr::verification::lang::temporal

@VerificationCase
@Tag("expect-pass")
class EFReach {
    var x: int := 0

    redefine tran {
        assume(x < 5)
        x := x + 1
    }

    prop {
        return EF x == 5
    }
}

@VerificationCase
@Tag("expect-pass")
class EFBoundedByGuard {
    var x: int := 0

    redefine tran {
        assume(x < 5)
        x := x + 1
    }

    prop {
        return AG x <= 5
    }
}

@VerificationCase
@Tag("expect-pass")
class AGInvariant {
    var x: int := 0

    redefine tran {
        x := 1 - x
    }

    prop {
        return AG (x == 0 || x == 1)
    }
}

@VerificationCase
@Tag("expect-pass")
class AGEndpoint1Reach {
    var x: int := 0

    redefine tran {
        x := 1 - x
    }

    prop {
        return EF x == 1
    }
}

@VerificationCase
@Tag("expect-pass")
class AGEndpoint0Reach {
    var x: int := 1

    redefine tran {
        x := 1 - x
    }

    prop {
        return EF x == 0
    }
}

@VerificationCase
@Tag("expect-pass")
class AGDisjunction {
    var x: int := 0

    redefine tran {
        choice {
            x := 1
        } or {
            x := 2
        } or {
            x := 3
        }
    }

    prop {
        return AG (x == 0 || x == 1 || x == 2 || x == 3)
    }
}

@VerificationCase
@Tag("expect-pass")
class EFAGBound {
    var x: int := 0

    redefine tran {
        choice {
            assume(x < 3)
            x := x + 1
        } or {
            assume(x == 3)
        }
    }

    prop {
        return AG (x >= 0 && x <= 3)
    }
}

@VerificationCase
@Tag("expect-fail")
class AGViolated {
    var x: int := 0

    redefine tran {
        x := 1 - x
    }

    prop {
        return AG x == 0
    }
}

@VerificationCase
@Tag("expect-fail")
class EFUnreachable {
    var x: int := 0

    redefine tran {
        x := 1 - x
    }

    prop {
        return EF x == 2
    }
}
