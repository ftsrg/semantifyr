package semantifyr::verification::lang::feature_kinds

class Lamp {
    var on: bool := false

    tran switchOn() {
        on := true
    }
}

class Switch {
    refers lamp: Lamp[1]

    tran press() {
        inline lamp.switchOn()
    }
}

@VerificationCase
@Tag("expect-pass")
class ReferenceBindingReach {
    contains kitchen: Lamp[1]
    contains hall: Lamp[1]
    contains button: Switch[1] {
        redefine refers lamp: Lamp[1] = kitchen
    }

    redefine tran {
        inline button.press()
    }

    prop {
        return EF kitchen.on
    }
}

@VerificationCase
@Tag("expect-fail")
class ReferenceBindingOtherUnreachable {
    contains kitchen: Lamp[1]
    contains hall: Lamp[1]
    contains button: Switch[1] {
        redefine refers lamp: Lamp[1] = kitchen
    }

    redefine tran {
        inline button.press()
    }

    prop {
        return EF hall.on
    }
}

class Limited {
    refers limit: int = 2
    var count: int := 0

    tran step() {
        assume(count < limit)
        count := count + 1
    }
}

@VerificationCase
@Tag("expect-pass")
class DataBindingReach {
    contains limited: Limited[1] {
        redefine refers limit: int = 3
    }

    redefine tran {
        inline limited.step()
    }

    prop {
        return EF limited.count == 3
    }
}

@VerificationCase
@Tag("expect-fail")
class DataBindingViolated {
    contains limited: Limited[1] {
        redefine refers limit: int = 3
    }

    redefine tran {
        inline limited.step()
    }

    prop {
        return AG limited.count <= 2
    }
}

class Node {
    derived refers incoming: Edge[0..*] opposite to
}

class Edge {
    refers to: Node[1] opposite incoming
    var used: bool := false
}

class Graph {
    contains n1: Node[1]
    contains n2: Node[1]
    contains e1: Edge[1] {
        redefine refers to: Node[1] = n2
    }
    contains e2: Edge[1] {
        redefine refers to: Node[1] = n2
    }
    contains e3: Edge[1] {
        redefine refers to: Node[1] = n1
    }

    tran useIncomingOfSecond() {
        inline for (e in n2.incoming) {
            e.used := true
        }
    }
}

@VerificationCase
@Tag("expect-pass")
class DerivedReferenceReach {
    contains graph: Graph[1]

    redefine tran {
        inline graph.useIncomingOfSecond()
    }

    prop {
        return EF (graph.e1.used && graph.e2.used)
    }
}

@VerificationCase
@Tag("expect-fail")
class DerivedReferenceUnreachable {
    contains graph: Graph[1]

    redefine tran {
        inline graph.useIncomingOfSecond()
    }

    prop {
        return EF graph.e3.used
    }
}

class Item {
    var hits: int := 0

    tran act() {
        assume(hits < 1)
        hits := hits + 1
    }
}

class SpecialItem : Item {
    var special: int := 0

    redefine tran act() {
        assume(special < 1)
        special := special + 1
    }
}

abstract class Slot {
    features payload: Item

    tran run() {
        inline payload.act()
    }
}

class FilledSlot : Slot {
    redefine contains payload: SpecialItem[1]
}

@VerificationCase
@Tag("expect-pass")
class AbstractFeatureReach {
    contains slot: FilledSlot[1]

    redefine tran {
        inline slot.run()
    }

    prop {
        return EF slot.payload.special == 1
    }
}

@VerificationCase
@Tag("expect-fail")
class AbstractFeatureBaseUnreachable {
    contains slot: FilledSlot[1]

    redefine tran {
        inline slot.run()
    }

    prop {
        return EF slot.payload.hits == 1
    }
}

class Pair {
    contains a: Item[1]

    tran run() {
        inline a.act()
    }
}

class RenamedPair : Pair {
    contains replacement: SpecialItem[1] redefines a
}

@VerificationCase
@Tag("expect-pass")
class RedefinesReach {
    contains pair: RenamedPair[1]

    redefine tran {
        inline pair.run()
    }

    prop {
        return EF pair.replacement.special == 1
    }
}

@VerificationCase
@Tag("expect-fail")
class RedefinesBaseUnreachable {
    contains pair: RenamedPair[1]

    redefine tran {
        inline pair.run()
    }

    prop {
        return EF pair.replacement.hits == 1
    }
}

class Counter {
    var count: int := 0
}

class User {
    @Shared
    contains shared: Counter[1]
    contains own: Counter[1]

    tran bump() {
        assume(shared.count < 2)
        shared.count := shared.count + 1
        own.count := 1
    }
}

@VerificationCase
@Tag("expect-pass")
class SharedReach {
    contains first: User[1]
    contains second: User[1]

    redefine tran {
        inline first.bump()
    }

    prop {
        return EF second.shared.count == 2
    }
}

@VerificationCase
@Tag("expect-fail")
class SharedOwnUnreachable {
    contains first: User[1]
    contains second: User[1]

    redefine tran {
        inline first.bump()
    }

    prop {
        return EF second.own.count == 1
    }
}
