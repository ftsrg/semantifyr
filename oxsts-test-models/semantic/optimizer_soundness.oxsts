package semantifyr::verification::lang::optimizer_soundness

// Copy propagation: the copy keeps the value the source had at the copy, not the value it has at the read.
@VerificationCase
@Tag("expect-pass")
class CopyAcrossSourceWrite {
    var source: int := 0
    var copy: int := 0
    var seen: bool := false

    redefine tran {
        copy := source
        source := 1 - source
        assume(copy == 0)
        seen := true
    }

    prop {
        return EF seen
    }
}

// Copy propagation: a copy made in init does not follow later writes of its source in tran.
@VerificationCase
@Tag("expect-pass")
class CopyFromInitAcrossSourceWrite {
    var source: int := 0
    var copy: int := 0
    var seen: bool := false

    redefine init {
        copy := source
    }

    redefine tran {
        source := 1 - source
        assume(copy == 0)
        seen := true
    }

    prop {
        return EF seen
    }
}

// Variable liveness: a local's initializer is evaluated at the declaration, before the write to its source.
@VerificationCase
@Tag("expect-pass")
class LocalInitializerBeforeSourceWrite {
    var source: int := 0
    var seen: int := 0

    redefine tran {
        var snapshot: int := source
        source := 1 - source
        seen := snapshot
    }

    prop {
        return EF (source == 1 && seen == 0)
    }
}

// Cone of influence: the writes to the source stay live because the local's initializer reads it.
@VerificationCase
@Tag("expect-pass")
class LocalInitializerSourceInCone {
    var source: int := 0
    var seen: int := 0

    redefine tran {
        source := 1 - source
        var snapshot: int := source
        seen := snapshot
    }

    prop {
        return EF seen == 1
    }
}

// Copy propagation in init: the write on one branch does not reach the read along the other.
@VerificationCase
@Tag("expect-pass")
class InitCopyOnOneBranch {
    var branch: bool := false
    var source: int := 0
    var copy: int := 9

    redefine init {
        havoc(branch)
        if (branch) {
            source := 5
        }
        copy := source
    }

    prop {
        return EF copy == 0
    }
}

// Cone of influence: the guard of an if around an assumption decides whether the assumption blocks, so the guard's writes stay.
@VerificationCase
@Tag("expect-fail")
class GuardAroundAssumption {
    var x: int := 0
    var y: int := 0

    redefine tran {
        choice {
            if (x < 10) {
                x := x + 1
            }
        } or {
            if (x <= 5) {
                assume(false)
            }
            y := 1
        }
    }

    prop {
        return AG y == 0
    }
}
