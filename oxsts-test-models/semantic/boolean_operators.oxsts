package semantifyr::verification::lang::boolean_operators

@VerificationCase
@Tag("expect-pass")
class AndTrueReach {
    var left: bool := false
    var right: bool := false
    var result: bool := false

    redefine tran {
        havoc(left)
        havoc(right)
        result := left && right
    }

    prop {
        return EF result == true
    }
}

@VerificationCase
@Tag("expect-pass")
class AndTrueImpliesBoth {
    var left: bool := false
    var right: bool := false
    var result: bool := false

    redefine tran {
        havoc(left)
        havoc(right)
        result := left && right
    }

    prop {
        return AG (result == false || (left == true && right == true))
    }
}

@VerificationCase
@Tag("expect-pass")
class OrTrueReach {
    var left: bool := false
    var right: bool := false
    var result: bool := false

    redefine tran {
        havoc(left)
        havoc(right)
        result := left || right
    }

    prop {
        return EF result == true
    }
}

@VerificationCase
@Tag("expect-pass")
class OrFalseImpliesBothFalse {
    var left: bool := false
    var right: bool := false
    var result: bool := false

    redefine tran {
        havoc(left)
        havoc(right)
        result := left || right
    }

    prop {
        return AG (result == true || (left == false && right == false))
    }
}

@VerificationCase
@Tag("expect-pass")
class XorTrueReach {
    var left: bool := false
    var right: bool := false
    var result: bool := false

    redefine tran {
        havoc(left)
        havoc(right)
        result := left ^^ right
    }

    prop {
        return EF result == true
    }
}

@VerificationCase
@Tag("expect-pass")
class XorTrueImpliesDiffer {
    var left: bool := false
    var right: bool := false
    var result: bool := false

    redefine tran {
        havoc(left)
        havoc(right)
        result := left ^^ right
    }

    prop {
        return AG (result == false || left != right)
    }
}

@VerificationCase
@Tag("expect-pass")
class NegationReach {
    var operand: bool := true

    redefine tran {
        operand := !operand
    }

    prop {
        return EF operand == false
    }
}

@VerificationCase
@Tag("expect-pass")
class NegationBound {
    var operand: bool := true

    redefine tran {
        operand := !operand
    }

    prop {
        return AG (operand == true || operand == false)
    }
}

@VerificationCase
@Tag("expect-pass")
class TautologyAlwaysTrue {
    var left: bool := false
    var right: bool := false
    var result: bool := false

    redefine tran {
        havoc(left)
        havoc(right)
        result := (left && right) || !left
    }

    prop {
        return AG (result == false || result == true)
    }
}

@VerificationCase
@Tag("expect-pass")
class DoubleNegationTrueReach {
    var operand: bool := true
    var result: bool := false

    redefine tran {
        result := !(!operand)
    }

    prop {
        return EF result == true
    }
}

@VerificationCase
@Tag("expect-pass")
class DoubleNegationMatchesInput {
    var operand: bool := false
    var result: bool := false

    redefine tran {
        havoc(operand)
        result := !(!operand)
    }

    prop {
        return AG (result == false || operand == true)
    }
}

@VerificationCase
@Tag("expect-fail")
class AndWithFalseOperandUnreachable {
    var left: bool := false
    var right: bool := false
    var result: bool := false

    redefine tran {
        havoc(left)
        havoc(right)
        result := left && right
    }

    prop {
        return EF (result == true && right == false)
    }
}

@VerificationCase
@Tag("expect-fail")
class OrWithTrueOperandViolated {
    var left: bool := false
    var right: bool := false
    var result: bool := false

    redefine tran {
        havoc(left)
        havoc(right)
        result := left || right
    }

    prop {
        return AG (result == false || left == true)
    }
}

@VerificationCase
@Tag("expect-fail")
class XorOfEqualOperandsUnreachable {
    var left: bool := false
    var right: bool := false
    var result: bool := false

    redefine tran {
        havoc(left)
        havoc(right)
        result := left ^^ right
    }

    prop {
        return EF (result == true && left == right)
    }
}

@VerificationCase
@Tag("expect-fail")
class NegationViolated {
    var operand: bool := true

    redefine tran {
        operand := !operand
    }

    prop {
        return AG operand == true
    }
}
