package semantifyr::verification::lang::primitives

@VerificationCase
@Tag("expect-pass")
class IntegerCounterReach {
    var x: int := 0

    redefine tran {
        assume(x < 10)
        x := x + 1
    }

    prop {
        return EF x == 10
    }
}

@VerificationCase
@Tag("expect-pass")
class IntegerCounterBound {
    var x: int := 0

    redefine tran {
        assume(x < 10)
        x := x + 1
    }

    prop {
        return AG (x >= 0 && x <= 10)
    }
}

@VerificationCase
@Tag("expect-pass")
class BooleanHavocTrueReach {
    var flag: bool := false

    redefine tran {
        havoc(flag)
    }

    prop {
        return EF flag == true
    }
}

@VerificationCase
@Tag("expect-pass")
class BooleanHavocFalseReach {
    var flag: bool := true

    redefine tran {
        havoc(flag)
    }

    prop {
        return EF flag == false
    }
}

@VerificationCase
@Tag("expect-pass")
class BoundedDecrementReach {
    var x: int := 5

    redefine tran {
        assume(x > 0)
        x := x - 1
    }

    prop {
        return EF x == 0
    }
}

@VerificationCase
@Tag("expect-pass")
class BoundedDecrementBound {
    var x: int := 5

    redefine tran {
        choice {
            assume(x > 0)
            x := x - 1
        } or {
            assume(x == 0)
        }
    }

    prop {
        return AG (x >= 0 && x <= 5)
    }
}

@VerificationCase
@Tag("expect-fail")
class IntegerCounterViolated {
    var x: int := 0

    redefine tran {
        assume(x < 10)
        x := x + 1
    }

    prop {
        return AG x <= 9
    }
}

@VerificationCase
@Tag("expect-fail")
class BooleanHavocViolated {
    var flag: bool := false

    redefine tran {
        havoc(flag)
    }

    prop {
        return AG flag == false
    }
}
