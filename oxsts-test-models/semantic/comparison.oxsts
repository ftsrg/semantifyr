package semantifyr::verification::lang::comparison

@VerificationCase
@Tag("expect-pass")
class LessTrueReach {
    var x: int := 0
    var y: int := 0
    var result: bool := false

    redefine tran {
        havoc(x)
        havoc(y)
        assume(x >= 0 && x <= 3)
        assume(y >= 0 && y <= 3)
        result := x < y
    }

    prop {
        return EF result == true
    }
}

@VerificationCase
@Tag("expect-pass")
class LessTrueImpliesOrder {
    var x: int := 0
    var y: int := 0
    var result: bool := false

    redefine tran {
        havoc(x)
        havoc(y)
        assume(x >= 0 && x <= 3)
        assume(y >= 0 && y <= 3)
        result := x < y
    }

    prop {
        return AG (result == false || x < y)
    }
}

@VerificationCase
@Tag("expect-pass")
class LessOrEqualOfEqualOperandsIsTrue {
    var result: bool := false

    redefine tran {
        result := 3 <= 3
    }

    prop {
        return EF result == true
    }
}

@VerificationCase
@Tag("expect-pass")
class LessOrEqualOfGreaterOperandIsFalse {
    var result: bool := true

    redefine tran {
        result := 4 <= 3
    }

    prop {
        return EF result == false
    }
}

@VerificationCase
@Tag("expect-pass")
class GreaterTrueReach {
    var x: int := 0
    var y: int := 0
    var result: bool := false

    redefine tran {
        havoc(x)
        havoc(y)
        assume(x >= 0 && x <= 3)
        assume(y >= 0 && y <= 3)
        result := x > y
    }

    prop {
        return EF result == true
    }
}

@VerificationCase
@Tag("expect-pass")
class GreaterTrueImpliesOrder {
    var x: int := 0
    var y: int := 0
    var result: bool := false

    redefine tran {
        havoc(x)
        havoc(y)
        assume(x >= 0 && x <= 3)
        assume(y >= 0 && y <= 3)
        result := x > y
    }

    prop {
        return AG (result == false || x > y)
    }
}

@VerificationCase
@Tag("expect-pass")
class GreaterOrEqualOfEqualOperandsIsTrue {
    var result: bool := false

    redefine tran {
        result := 3 >= 3
    }

    prop {
        return EF result == true
    }
}

@VerificationCase
@Tag("expect-pass")
class EqualOfSameOperandsIsTrue {
    var result: bool := false

    redefine tran {
        result := 5 == 5
    }

    prop {
        return EF result == true
    }
}

@VerificationCase
@Tag("expect-pass")
class EqualOfDifferentOperandsIsFalse {
    var result: bool := true

    redefine tran {
        result := 5 == 4
    }

    prop {
        return EF result == false
    }
}

@VerificationCase
@Tag("expect-pass")
class NotEqualTrueReach {
    var x: int := 0
    var y: int := 0
    var result: bool := false

    redefine tran {
        havoc(x)
        havoc(y)
        assume(x >= 0 && x <= 3)
        assume(y >= 0 && y <= 3)
        result := x != y
    }

    prop {
        return EF result == true
    }
}

@VerificationCase
@Tag("expect-pass")
class NotEqualTrueImpliesDiffer {
    var x: int := 0
    var y: int := 0
    var result: bool := false

    redefine tran {
        havoc(x)
        havoc(y)
        assume(x >= 0 && x <= 3)
        assume(y >= 0 && y <= 3)
        result := x != y
    }

    prop {
        return AG (result == false || x != y)
    }
}

@VerificationCase
@Tag("expect-fail")
class LessOfEqualOperandsUnreachable {
    var x: int := 0
    var y: int := 0
    var result: bool := false

    redefine tran {
        havoc(x)
        havoc(y)
        assume(x >= 0 && x <= 3)
        assume(y >= 0 && y <= 3)
        result := x < y
    }

    prop {
        return EF (result == true && x == y)
    }
}

@VerificationCase
@Tag("expect-fail")
class LessOrEqualOfGreaterOperandUnreachable {
    var x: int := 0
    var y: int := 0
    var result: bool := false

    redefine tran {
        havoc(x)
        havoc(y)
        assume(x >= 0 && x <= 3)
        assume(y >= 0 && y <= 3)
        result := x <= y
    }

    prop {
        return EF (result == true && x > y)
    }
}

@VerificationCase
@Tag("expect-fail")
class GreaterOrEqualOfLessOperandUnreachable {
    var x: int := 0
    var y: int := 0
    var result: bool := false

    redefine tran {
        havoc(x)
        havoc(y)
        assume(x >= 0 && x <= 3)
        assume(y >= 0 && y <= 3)
        result := x >= y
    }

    prop {
        return EF (result == true && x < y)
    }
}

@VerificationCase
@Tag("expect-fail")
class NotEqualOfEqualOperandsUnreachable {
    var x: int := 0
    var y: int := 0
    var result: bool := false

    redefine tran {
        havoc(x)
        havoc(y)
        assume(x >= 0 && x <= 3)
        assume(y >= 0 && y <= 3)
        result := x != y
    }

    prop {
        return EF (result == true && x == y)
    }
}

@VerificationCase
@Tag("expect-fail")
class EqualViolated {
    var x: int := 0
    var y: int := 0
    var result: bool := false

    redefine tran {
        havoc(x)
        havoc(y)
        assume(x >= 0 && x <= 3)
        assume(y >= 0 && y <= 3)
        result := x == y
    }

    prop {
        return AG result == false
    }
}
