package semantifyr::verification::lang::arithmetic

@VerificationCase
@Tag("expect-pass")
class AddReach {
    var result: int := 0

    redefine tran {
        result := 3 + 4
    }

    prop {
        return EF result == 7
    }
}

@VerificationCase
@Tag("expect-pass")
class AddBound {
    var result: int := 0

    redefine tran {
        result := 3 + 4
    }

    prop {
        return AG (result == 0 || result == 7)
    }
}

@VerificationCase
@Tag("expect-pass")
class SubtractReach {
    var result: int := 0

    redefine tran {
        result := 10 - 3
    }

    prop {
        return EF result == 7
    }
}

@VerificationCase
@Tag("expect-pass")
class SubtractBound {
    var result: int := 0

    redefine tran {
        result := 10 - 3
    }

    prop {
        return AG (result == 0 || result == 7)
    }
}

@VerificationCase
@Tag("expect-pass")
class MultiplyReach {
    var result: int := 0

    redefine tran {
        result := 3 * 4
    }

    prop {
        return EF result == 12
    }
}

@VerificationCase
@Tag("expect-pass")
class MultiplyBound {
    var result: int := 0

    redefine tran {
        result := 3 * 4
    }

    prop {
        return AG (result == 0 || result == 12)
    }
}

@VerificationCase
@Tag("expect-pass")
class DivideReach {
    var result: int := 0

    redefine tran {
        result := 12 / 4
    }

    prop {
        return EF result == 3
    }
}

@VerificationCase
@Tag("expect-pass")
class DivideBound {
    var result: int := 0

    redefine tran {
        result := 12 / 4
    }

    prop {
        return AG (result == 0 || result == 3)
    }
}

@VerificationCase
@Tag("expect-pass")
class UnaryMinusReach {
    var x: int := 5

    redefine tran {
        x := -x
    }

    prop {
        return EF x == -5
    }
}

@VerificationCase
@Tag("expect-pass")
class UnaryMinusBound {
    var x: int := 5

    redefine tran {
        x := -x
    }

    prop {
        return AG (x == 5 || x == -5)
    }
}

@VerificationCase
@Tag("expect-fail")
class AddViolated {
    var result: int := 0

    redefine tran {
        result := 3 + 4
    }

    prop {
        return AG (result == 0 || result == 8)
    }
}

@VerificationCase
@Tag("expect-fail")
class SubtractViolated {
    var result: int := 0

    redefine tran {
        result := 10 - 3
    }

    prop {
        return AG (result == 0 || result == 13)
    }
}

@VerificationCase
@Tag("expect-fail")
class MultiplyViolated {
    var result: int := 0

    redefine tran {
        result := 3 * 4
    }

    prop {
        return AG (result == 0 || result == 7)
    }
}

@VerificationCase
@Tag("expect-fail")
class DivideViolated {
    var result: int := 0

    redefine tran {
        result := 12 / 4
    }

    prop {
        return AG (result == 0 || result == 48)
    }
}

@VerificationCase
@Tag("expect-fail")
class UnaryMinusViolated {
    var x: int := 5

    redefine tran {
        x := -x
    }

    prop {
        return AG x > 0
    }
}

@VerificationCase
@Tag("expect-pass")
class RuntimeArithmeticBound {
    var x: int := 0
    var result: int := 0

    redefine tran {
        havoc(x)
        assume(x >= 0 && x <= 3)
        result := x * 2 + 1
    }

    prop {
        return AG (result == 0 || result == 1 || result == 3 || result == 5 || result == 7)
    }
}

@VerificationCase
@Tag("expect-fail")
class RuntimeArithmeticViolated {
    var x: int := 0
    var result: int := 0

    redefine tran {
        havoc(x)
        assume(x >= 0 && x <= 3)
        result := x * 2 + 1
    }

    prop {
        return AG result != 7
    }
}

@VerificationCase
@Tag("expect-pass")
class RuntimeDivisionBound {
    var x: int := 0
    var result: int := 0

    redefine tran {
        havoc(x)
        assume(x >= 0 && x <= 7)
        result := x / 2
    }

    prop {
        return AG (result >= 0 && result <= 3)
    }
}

@VerificationCase
@Tag("expect-fail")
class RuntimeDivisionViolated {
    var x: int := 0
    var result: int := 0

    redefine tran {
        havoc(x)
        assume(x >= 0 && x <= 7)
        result := x / 2
    }

    prop {
        return AG result <= 2
    }
}
