package semantifyr::verification::lang::globals

class GlobalCounter {
    var tick: int := 0
}

global containment counter: GlobalCounter[1]

@VerificationCase
@Tag("expect-pass")
class GlobalTickReach {
    redefine tran {
        assume(counter.tick < 3)
        counter.tick := counter.tick + 1
    }

    prop {
        return EF counter.tick == 3
    }
}

@VerificationCase
@Tag("expect-pass")
class GlobalTickBound {
    redefine tran {
        assume(counter.tick < 3)
        counter.tick := counter.tick + 1
    }

    prop {
        return AG counter.tick <= 3
    }
}

@VerificationCase
@Tag("expect-fail")
class GlobalTickViolated {
    redefine tran {
        assume(counter.tick < 3)
        counter.tick := counter.tick + 1
    }

    prop {
        return AG counter.tick <= 2
    }
}

global reference sharedCounter: GlobalCounter[1] = counter

@VerificationCase
@Tag("expect-pass")
class GlobalReferenceReach {
    redefine tran {
        assume(sharedCounter.tick < 3)
        sharedCounter.tick := sharedCounter.tick + 1
    }

    prop {
        return EF counter.tick == 3
    }
}

@VerificationCase
@Tag("expect-fail")
class GlobalReferenceViolated {
    redefine tran {
        assume(sharedCounter.tick < 3)
        sharedCounter.tick := sharedCounter.tick + 1
    }

    prop {
        return AG counter.tick == 0
    }
}
