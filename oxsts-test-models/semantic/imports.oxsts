package semantifyr::verification::lang::imports

import semantifyr::verification::lang::globals

@VerificationCase
@Tag("expect-pass")
class ImportedGlobalReach {
    redefine tran {
        assume(counter.tick < 2)
        counter.tick := counter.tick + 1
    }

    prop {
        return EF counter.tick == 2
    }
}

@VerificationCase
@Tag("expect-fail")
class ImportedGlobalViolated {
    redefine tran {
        assume(counter.tick < 2)
        counter.tick := counter.tick + 1
    }

    prop {
        return AG counter.tick <= 1
    }
}

@VerificationCase
@Tag("expect-pass")
class ImportedAndQualifiedTypesReach {
    contains own: GlobalCounter[1]
    var color: semantifyr::verification::lang::enums::Color := semantifyr::verification::lang::enums::Color::Red

    redefine tran {
        own.tick := 1
        color := semantifyr::verification::lang::enums::Color::Blue
    }

    prop {
        return EF (own.tick == 1 && color == semantifyr::verification::lang::enums::Color::Blue)
    }
}

@VerificationCase
@Tag("expect-fail")
class ImportedAndQualifiedTypesViolated {
    contains own: GlobalCounter[1]
    var color: semantifyr::verification::lang::enums::Color := semantifyr::verification::lang::enums::Color::Red

    redefine tran {
        own.tick := 1
        color := semantifyr::verification::lang::enums::Color::Blue
    }

    prop {
        return AG color == semantifyr::verification::lang::enums::Color::Red
    }
}
