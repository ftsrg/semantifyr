package semantifyr::verification::lang::inline_operations

// Inline operations are expanded by the compiler at inline time rather
// than dispatched at runtime. Verification checks that the expansion
// preserves the intended semantics.

// --- inline-if (compile-time guard) ---

// Inline-if with a true static guard always takes the then-branch.
@VerificationCase
@Tag("expect-pass")
class InlineIfTrueReach {
    var taken: int := 0

    redefine tran {
        inline if (1 < 2) {
            taken := 1
        } else {
            taken := 2
        }
    }

    prop {
        return EF taken == 1
    }
}

// Dual: the else-branch is never taken under a true guard.
@VerificationCase
@Tag("expect-pass")
class InlineIfTrueBound {
    var taken: int := 0

    redefine tran {
        inline if (1 < 2) {
            taken := 1
        } else {
            taken := 2
        }
    }

    prop {
        return AG taken != 2
    }
}

// Inline-if with a false static guard always takes the else-branch.
@VerificationCase
@Tag("expect-pass")
class InlineIfFalseReach {
    var taken: int := 0

    redefine tran {
        inline if (1 > 2) {
            taken := 1
        } else {
            taken := 2
        }
    }

    prop {
        return EF taken == 2
    }
}

// --- inline sequential for ---

// Inline sequential for unrolls at compile time: 1 + 2 + 3 = 6 is reached.
@VerificationCase
@Tag("expect-pass")
class InlineSeqForReach {
    var total: int := 0

    redefine init {
        inline for (n in 1..3) {
            total := total + n
        }
    }

    prop {
        return EF total == 6
    }
}

// Dual: total never exceeds the sum - no extra iterations happen.
@VerificationCase
@Tag("expect-pass")
class InlineSeqForBound {
    var total: int := 0

    redefine init {
        inline for (n in 1..3) {
            total := total + n
        }
    }

    redefine tran { }

    prop {
        return AG total <= 6
    }
}

// --- inline for over an exclusive range ---

// An exclusive range still runs every iteration below its upper bound.
@VerificationCase
@Tag("expect-pass")
class InlineSeqForExclusiveReach {
    var count: int := 0

    redefine init {
        inline for (n in 0..<3) {
            count := count + 1
        }
    }

    prop {
        return EF count == 3
    }
}

// Dual: an exclusive range stops before its upper bound, so 0..<3 unrolls
// three times, not four.
@VerificationCase
@Tag("expect-pass")
class InlineSeqForExclusiveBound {
    var count: int := 0

    redefine init {
        inline for (n in 0..<3) {
            count := count + 1
        }
    }

    redefine tran { }

    prop {
        return AG count <= 3
    }
}

// Dual: no fourth iteration happens, so a count of 4 is unreachable.
@VerificationCase
@Tag("expect-fail")
class InlineSeqForExclusiveNoFourthIteration {
    var count: int := 0

    redefine init {
        inline for (n in 0..<3) {
            count := count + 1
        }
    }

    redefine tran { }

    prop {
        return EF count == 4
    }
}

// Dual: the upper bound of an exclusive range is never chosen.
@VerificationCase
@Tag("expect-pass")
class InlineChoiceForExclusiveBound {
    var chosen: int := 0

    redefine tran {
        inline for choice (n in 0..<3) {
            chosen := n
        }
    }

    prop {
        return AG chosen != 3
    }
}

// --- inline choice-for ---

// Inline choice-for produces a nondeterministic choice over each value:
// 1 is reachable.
@VerificationCase
@Tag("expect-pass")
class InlineChoiceFor1Reach {
    var chosen: int := 0

    redefine tran {
        inline for choice (n in 1..3) {
            chosen := n
        }
    }

    prop {
        return EF chosen == 1
    }
}

// Inline choice-for: 3 is reachable.
@VerificationCase
@Tag("expect-pass")
class InlineChoiceFor3Reach {
    var chosen: int := 0

    redefine tran {
        inline for choice (n in 1..3) {
            chosen := n
        }
    }

    prop {
        return EF chosen == 3
    }
}

// Dual: inline choice-for only produces values in the enumerated range.
@VerificationCase
@Tag("expect-pass")
class InlineChoiceForBound {
    var chosen: int := 0

    redefine tran {
        inline for choice (n in 1..3) {
            chosen := n
        }
    }

    prop {
        return AG (chosen == 0 || chosen == 1 || chosen == 2 || chosen == 3)
    }
}

// --- inline for over a negative range ---

// Inline for over a negative range unrolls in ascending order: -2 + -1 + 0 = -3.
@VerificationCase
@Tag("expect-pass")
class InlineForNegativeRangeReach {
    var total: int := 0

    redefine init {
        inline for (n in -2..0) {
            total := total + n
        }
    }

    prop {
        return EF total == -3
    }
}

// Dual: the sum never dips below the exact value (no extra negative step).
@VerificationCase
@Tag("expect-pass")
class InlineForNegativeRangeBound {
    var total: int := 0

    redefine init {
        inline for (n in -2..0) {
            total := total + n
        }
    }

    redefine tran { }

    prop {
        return AG total >= -3
    }
}

@VerificationCase
@Tag("expect-fail")
class InlineIfTrueViolated {
    var taken: int := 0

    redefine tran {
        inline if (1 < 2) {
            taken := 1
        } else {
            taken := 2
        }
    }

    prop {
        return AG taken != 1
    }
}

@VerificationCase
@Tag("expect-fail")
class InlineIfFalseUnreachable {
    var taken: int := 0

    redefine tran {
        inline if (1 > 2) {
            taken := 1
        } else {
            taken := 2
        }
    }

    prop {
        return EF taken == 1
    }
}

@VerificationCase
@Tag("expect-fail")
class InlineChoiceForUnreachable {
    var chosen: int := 0

    redefine tran {
        inline for choice (n in 1..3) {
            chosen := n
        }
    }

    prop {
        return EF chosen == 4
    }
}

class Hit {
    var hits: int := 0

    tran act() {
        assume(hits < 1)
        hits := hits + 1
    }
}

class HitPool {
    contains items: Hit[0..*]
    contains a: Hit[1] subsets items
    contains b: Hit[1] subsets items
    contains other: Hit[1]
}

@VerificationCase
@Tag("expect-pass")
class InlineForInstancesReach {
    contains pool: HitPool[1]

    redefine tran {
        inline for (i in pool.items) {
            inline i.act()
        }
    }

    prop {
        return EF (pool.a.hits == 1 && pool.b.hits == 1)
    }
}

@VerificationCase
@Tag("expect-pass")
class InlineForInstancesSkipsOthers {
    contains pool: HitPool[1]

    redefine tran {
        inline for (i in pool.items) {
            inline i.act()
        }
    }

    prop {
        return AG pool.other.hits == 0
    }
}

@VerificationCase
@Tag("expect-fail")
class InlineForInstancesViolated {
    contains pool: HitPool[1]

    redefine tran {
        inline for (i in pool.items) {
            inline i.act()
        }
    }

    prop {
        return AG pool.b.hits == 0
    }
}

@VerificationCase
@Tag("expect-pass")
class InlineIfInstancesReach {
    contains pool: HitPool[1]
    refers chosen: Hit[1] = pool.b
    var x: int := 0

    redefine tran {
        inline if (chosen == pool.a) {
            x := 1
        } else {
            x := 2
        }
    }

    prop {
        return EF x == 2
    }
}

@VerificationCase
@Tag("expect-fail")
class InlineIfInstancesUnreachable {
    contains pool: HitPool[1]
    refers chosen: Hit[1] = pool.b
    var x: int := 0

    redefine tran {
        inline if (chosen == pool.a) {
            x := 1
        } else {
            x := 2
        }
    }

    prop {
        return EF x == 1
    }
}
