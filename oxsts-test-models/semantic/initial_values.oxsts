package semantifyr::verification::lang::initial_values

enum Light {
    Off,
    On,
}

@VerificationCase
@Tag("expect-fail")
class UninitializedIntegerBound {
    var x: int

    prop {
        return AG x == 0
    }
}

@VerificationCase
@Tag("expect-pass")
class UninitializedIntegerReach {
    var x: int

    prop {
        return EF x == 7
    }
}

@VerificationCase
@Tag("expect-fail")
class UninitializedBooleanBound {
    var flag: bool

    prop {
        return AG flag == false
    }
}

@VerificationCase
@Tag("expect-pass")
class UninitializedBooleanReach {
    var flag: bool

    prop {
        return EF flag == true
    }
}

@VerificationCase
@Tag("expect-fail")
class UninitializedEnumBound {
    var light: Light

    prop {
        return AG light == Light::Off
    }
}

@VerificationCase
@Tag("expect-pass")
class UninitializedEnumReach {
    var light: Light

    prop {
        return EF light == Light::On
    }
}

// Theta's CEGAR configurations also check the state before init, which the guard covers.
@VerificationCase
@Tag("expect-pass")
class InitOverwritesUninitialized {
    var x: int
    var initialized: bool := false

    redefine init {
        x := 3
        initialized := true
    }

    prop {
        return AG (!initialized || x == 3)
    }
}

@VerificationCase
@Tag("expect-fail")
class ConditionalInitKeepsUninitialized {
    var x: int
    var initialized: bool := false

    redefine init {
        choice {
            x := 3
        } or {
        }
        initialized := true
    }

    prop {
        return AG (!initialized || x == 3)
    }
}
