package semantifyr::verification::lang::initial_values

// A variable without an initializer starts at any value of its type. The
// expect-fail cases hold only on a backend that fixes the initial value,
// e.g. by zero-initializing it.

enum Light {
    Off,
    On
}

// --- integer ---

@VerificationCase
@Tag("expect-fail")
class UninitializedIntegerBound {
    var x: int

    prop {
        return AG x == 0
    }
}

@VerificationCase
@Tag("expect-pass")
class UninitializedIntegerReach {
    var x: int

    prop {
        return EF x == 7
    }
}

// --- boolean ---

@VerificationCase
@Tag("expect-fail")
class UninitializedBooleanBound {
    var b: bool

    prop {
        return AG b == false
    }
}

@VerificationCase
@Tag("expect-pass")
class UninitializedBooleanReach {
    var b: bool

    prop {
        return EF b == true
    }
}

// --- enum ---

@VerificationCase
@Tag("expect-fail")
class UninitializedEnumBound {
    var light: Light

    prop {
        return AG light == Light::Off
    }
}

@VerificationCase
@Tag("expect-pass")
class UninitializedEnumReach {
    var light: Light

    prop {
        return EF light == Light::On
    }
}

// --- init runs after the initial choice ---

// The init transition overwrites the arbitrary initial value. The property is also checked in the pre-init state, so it holds there through the guard.
@VerificationCase
@Tag("expect-pass")
class InitOverwritesUninitialized {
    var x: int
    var initialized: bool := false

    redefine init {
        x := 3
        initialized := true
    }

    prop {
        return AG (!initialized || x == 3)
    }
}

// A conditional init write keeps the arbitrary initial value on the branch that skips it.
@VerificationCase
@Tag("expect-fail")
class ConditionalInitKeepsUninitialized {
    var x: int
    var initialized: bool := false

    redefine init {
        choice {
            x := 3
        } or {
        }
        initialized := true
    }

    prop {
        return AG (!initialized || x == 3)
    }
}
