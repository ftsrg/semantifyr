package semantifyr::verification::lang::local_instances

// Class- and feature-typed local variables hold one instance: an
// uninitialized or havoced local picks among the instances of its type,
// a feature-typed one among the instances of its feature on the instance
// that declares it, and a call through the local dispatches to the
// instance it holds.

class Worker {
    var done: bool := false

    tran finish() {
        done := true
    }
}

class Other {
    var done: bool := false

    tran finish() {
        done := true
    }
}

class Pool {
    contains workers: Worker[0..*]
    contains a: Worker subsets workers
    contains b: Worker subsets workers
    contains spare: Worker
    var outside: bool := false

    tran pickOne() {
        var picked: workers
        if (picked != a && picked != b) {
            outside := true
        }
        inline picked.finish()
    }

    tran pickTwo() {
        var picks: workers[2]
        if ((picks[0] != a && picks[0] != b) || (picks[1] != a && picks[1] != b)) {
            outside := true
        }
        inline picks[0].finish()
        inline picks[1].finish()
    }
}

// --- class-typed scalar locals ---

// Reachable: an uninitialized local may hold the second worker.
@VerificationCase
@Tag("expect-pass")
class LocalClassTypedHavocReach {
    contains first: Worker
    contains second: Worker

    redefine tran {
        var picked: Worker
        inline picked.finish()
    }

    prop {
        return EF (second.done && !first.done)
    }
}

// Holds: a havoced local holds a worker, never another instance or value.
@VerificationCase
@Tag("expect-pass")
class LocalClassTypedHavocBound {
    contains first: Worker
    contains second: Worker
    contains other: Other
    var outside: bool := false

    redefine tran {
        var picked: Worker := first
        havoc(picked)
        if (picked != first && picked != second) {
            outside := true
        }
    }

    prop {
        return AG !outside
    }
}

// Holds: a dispatch through a class-typed local never reaches an instance of another class.
@VerificationCase
@Tag("expect-pass")
class LocalClassTypedDispatchBound {
    contains first: Worker
    contains other: Other

    redefine tran {
        var picked: Worker
        inline picked.finish()
    }

    prop {
        return AG !other.done
    }
}

// Reachable: an optional local may hold nothing.
@VerificationCase
@Tag("expect-pass")
class LocalOptionalClassTypedReach {
    contains first: Worker
    var empty: bool := false

    redefine tran {
        var picked: Worker[0..1]
        if (picked == nothing) {
            empty := true
        }
    }

    prop {
        return EF empty
    }
}

// Holds: a local of multiplicity one never holds nothing.
@VerificationCase
@Tag("expect-pass")
class LocalClassTypedNeverNothingBound {
    contains first: Worker
    var empty: bool := false

    redefine tran {
        var picked: Worker
        if (picked == nothing) {
            empty := true
        }
    }

    prop {
        return AG !empty
    }
}

// Reachable: an assigned local dispatches to the instance last assigned.
@VerificationCase
@Tag("expect-pass")
class LocalClassTypedAssignReach {
    contains first: Worker
    contains second: Worker
    var flip: bool := false

    redefine tran {
        var picked: Worker := first
        if (flip) {
            picked := second
        }
        flip := true
        inline picked.finish()
    }

    prop {
        return EF second.done
    }
}

// Holds: the second worker finishes only after the first did.
@VerificationCase
@Tag("expect-pass")
class LocalClassTypedAssignBound {
    contains first: Worker
    contains second: Worker
    var flip: bool := false

    redefine tran {
        var picked: Worker := first
        if (flip) {
            picked := second
        }
        flip := true
        inline picked.finish()
    }

    prop {
        return AG (!second.done || first.done)
    }
}

// --- feature-typed scalar locals, declared in a nested instance ---

// Reachable: the local may hold the feature's second instance.
@VerificationCase
@Tag("expect-pass")
class LocalFeatureTypedDispatchReach {
    contains pool: Pool

    redefine tran {
        inline pool.pickOne()
    }

    prop {
        return EF (pool.b.done && !pool.a.done)
    }
}

// Holds: the local holds instances of its feature only, never the spare worker.
@VerificationCase
@Tag("expect-pass")
class LocalFeatureTypedDispatchBound {
    contains pool: Pool

    redefine tran {
        inline pool.pickOne()
    }

    prop {
        return AG (!pool.outside && !pool.spare.done)
    }
}

// --- local arrays of class or feature type ---

// Reachable: each slot of a local class-typed array holds its own instance.
@VerificationCase
@Tag("expect-pass")
class LocalClassTypedArrayDispatchReach {
    contains first: Worker
    contains second: Worker

    redefine tran {
        var queue: Worker[2] := [first, second]
        inline queue[1].finish()
    }

    prop {
        return EF second.done
    }
}

// Holds: the dispatch through the second slot never finishes the first worker.
@VerificationCase
@Tag("expect-pass")
class LocalClassTypedArrayDispatchBound {
    contains first: Worker
    contains second: Worker

    redefine tran {
        var queue: Worker[2] := [first, second]
        inline queue[1].finish()
    }

    prop {
        return AG !first.done
    }
}

// Reachable: the havoced slots of a local feature-typed array may hold both instances.
@VerificationCase
@Tag("expect-pass")
class LocalFeatureTypedArrayHavocReach {
    contains pool: Pool

    redefine tran {
        assume(!pool.a.done && !pool.b.done)
        inline pool.pickTwo()
    }

    prop {
        return EF (pool.a.done && pool.b.done)
    }
}

// Holds: the slots hold instances of the feature only.
@VerificationCase
@Tag("expect-pass")
class LocalFeatureTypedArrayHavocBound {
    contains pool: Pool

    redefine tran {
        inline pool.pickTwo()
    }

    prop {
        return AG (!pool.outside && !pool.spare.done)
    }
}

@VerificationCase
@Tag("expect-fail")
class LocalClassTypedHavocViolated {
    contains first: Worker
    contains second: Worker

    redefine tran {
        var picked: Worker
        inline picked.finish()
    }

    prop {
        return AG !second.done
    }
}
