package semantifyr::verification::lang::runtime_for

@VerificationCase
@Tag("expect-pass")
class InclusiveRangeReach {
    var x: int := 0

    redefine tran {
        assume(x == 0)
        for (index in 0..2) {
            x := x + index
        }
    }

    prop {
        return EF x == 3
    }
}

@VerificationCase
@Tag("expect-pass")
class InclusiveRangeBound {
    var x: int := 0

    redefine tran {
        assume(x == 0)
        for (index in 0..2) {
            x := x + index
        }
    }

    prop {
        return AG x <= 3
    }
}

@VerificationCase
@Tag("expect-pass")
class ExclusiveRangeReach {
    var x: int := 0

    redefine tran {
        assume(x == 0)
        for (index in 0..<3) {
            x := x + index
        }
    }

    prop {
        return EF x == 3
    }
}

@VerificationCase
@Tag("expect-pass")
class ExclusiveRangeBound {
    var x: int := 0

    redefine tran {
        assume(x == 0)
        for (index in 0..<3) {
            x := x + index
        }
    }

    prop {
        return AG x <= 3
    }
}

@VerificationCase
@Tag("expect-pass")
class UnreadLoopVariableReach {
    var x: int := 0

    redefine tran {
        assume(x == 0)
        for (index in 0..2) {
            x := x + 1
        }
    }

    prop {
        return EF x == 3
    }
}

@VerificationCase
@Tag("expect-pass")
class UnreadLoopVariableBound {
    var x: int := 0

    redefine tran {
        assume(x == 0)
        for (index in 0..2) {
            x := x + 1
        }
    }

    prop {
        return AG x <= 3
    }
}

@VerificationCase
@Tag("expect-fail")
class InclusiveRangeViolated {
    var x: int := 0

    redefine tran {
        assume(x == 0)
        for (index in 0..2) {
            x := x + index
        }
    }

    prop {
        return AG x <= 2
    }
}

@VerificationCase
@Tag("expect-pass")
class EmptyExclusiveRangeBound {
    var x: int := 0

    redefine tran {
        for (index in 0..<0) {
            x := x + 1
        }
    }

    prop {
        return AG x == 0
    }
}

@VerificationCase
@Tag("expect-fail")
class EmptyExclusiveRangeUnreachable {
    var x: int := 0

    redefine tran {
        for (index in 0..<0) {
            x := x + 1
        }
    }

    prop {
        return EF x == 1
    }
}
