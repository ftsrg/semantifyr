package semantifyr::verification::lang::arrays

@VerificationCase
@Tag("expect-pass")
class ArrayLiteralInitializer0Reach {
    var values: int[3] := [10, 20, 30]
    var first: int := 0

    redefine tran {
        first := values[0]
    }

    prop {
        return EF first == 10
    }
}

@VerificationCase
@Tag("expect-pass")
class ArrayLiteralInitializer2Reach {
    var values: int[3] := [10, 20, 30]
    var third: int := 0

    redefine tran {
        third := values[2]
    }

    prop {
        return EF third == 30
    }
}

@VerificationCase
@Tag("expect-pass")
class ArrayLiteralInitializerBound {
    var values: int[3] := [10, 20, 30]

    redefine tran { }

    prop {
        return AG (values[0] == 10 && values[1] == 20 && values[2] == 30)
    }
}

@VerificationCase
@Tag("expect-pass")
class ArraySlotIndependenceReach {
    var slots: int[3] := [0, 0, 0]

    redefine tran {
        choice {
            slots[0] := slots[0] + 1
        } or {
            slots[1] := slots[1] + 1
        } or {
            slots[2] := slots[2] + 1
        }
    }

    prop {
        return EF (slots[0] == 1 && slots[1] == 1 && slots[2] == 1)
    }
}

@VerificationCase
@Tag("expect-pass")
class ArraySlot0DoesNotAffectOthers {
    var slots: int[3] := [0, 0, 0]

    redefine tran {
        slots[0] := slots[0] + 1
    }

    prop {
        return AG (slots[1] == 0 && slots[2] == 0)
    }
}

@VerificationCase
@Tag("expect-pass")
class ArrayReadAfterWriteReach {
    var slots: int[2] := [0, 0]
    var seen: int := 0

    redefine tran {
        slots[1] := 7
        seen := slots[1]
    }

    prop {
        return EF seen == 7
    }
}

@VerificationCase
@Tag("expect-pass")
class ArrayRuntimeIndexReach {
    var slots: int[3] := [0, 0, 0]
    var index: int := 0

    redefine tran {
        slots[index] := 5
        if (index < 2) {
            index := index + 1
        }
    }

    prop {
        return EF slots[2] == 5
    }
}

@VerificationCase
@Tag("expect-pass")
class ArrayRangedMultiplicityReach {
    var slots: int[1..3] := [1, 2, 3]
    var seen: int := 0

    redefine tran {
        seen := slots[2]
    }

    prop {
        return EF seen == 3
    }
}

@VerificationCase
@Tag("expect-pass")
class ArrayWholeCopyReach {
    var slots: int[2] := [0, 0]
    var backup: int[2] := [0, 0]

    redefine tran {
        choice {
            assume(slots[0] < 2)
            slots[0] := slots[0] + 1
        } or {
            backup := slots
        } or {
            slots := [0, 0]
        }
    }

    prop {
        return EF (backup == slots && backup[0] == 2)
    }
}

@VerificationCase
@Tag("expect-fail")
class ArrayWholeHavocBound {
    var slots: int[2] := [0, 0]

    redefine tran {
        havoc(slots)
        assume(slots[0] >= 0 && slots[0] <= 3 && slots[1] == slots[0])
    }

    prop {
        return AG slots[1] <= 2
    }
}

@VerificationCase
@Tag("expect-pass")
class ArraySwapReach {
    var slots: int[2] := [1, 2]

    redefine tran {
        slots := [slots[1], slots[0]]
    }

    prop {
        return EF (slots[0] == 2 && slots[1] == 1)
    }
}

@VerificationCase
@Tag("expect-fail")
class ArraySwapBound {
    var slots: int[2] := [1, 2]

    redefine tran {
        slots := [slots[1], slots[0]]
    }

    prop {
        return AG slots[1] == 2
    }
}

@VerificationCase
@Tag("expect-pass")
class LocalArrayRuntimeIndexReach {
    var index: int := 0
    var seen: int := 0

    redefine tran {
        var values: int[3] := [10, 20, 30]
        seen := values[index]
        if (index < 2) {
            index := index + 1
        }
    }

    prop {
        return EF seen == 30
    }
}

@VerificationCase
@Tag("expect-fail")
class LocalArrayRuntimeWriteBound {
    var index: int := 0
    var seen: int := 0

    redefine tran {
        var values: int[3] := [0, 0, 0]
        values[index] := 5
        seen := values[2]
        if (index < 2) {
            index := index + 1
        }
    }

    prop {
        return AG seen == 0
    }
}

@VerificationCase
@Tag("expect-pass")
class LocalArrayNotPersistedBound {
    var seen: int := 0

    redefine tran {
        var values: int[2] := [1, 2]
        seen := values[0]
        values[0] := 9
    }

    prop {
        return AG seen <= 1
    }
}

@VerificationCase
@Tag("expect-pass")
class LocalArrayUninitializedReach {
    var seen: int := 0

    redefine tran {
        var values: int[2] := [0, 0]
        havoc(values)
        assume(values[0] >= 0 && values[0] <= 4 && values[1] == values[0])
        seen := values[1]
    }

    prop {
        return EF seen == 4
    }
}

@VerificationCase
@Tag("expect-pass")
class LocalArrayCopyReach {
    var slots: int[2] := [0, 0]
    var seen: int := 0

    redefine tran {
        var snapshot: int[2] := slots
        seen := snapshot[0] + snapshot[1]
        choice {
            slots[0] := 1
        } or {
            slots[1] := 2
        }
    }

    prop {
        return EF (seen == 3 && slots[0] + slots[1] == 3)
    }
}

class Job {
    var done: bool := false

    tran finish() {
        done := true
    }
}

@VerificationCase
@Tag("expect-pass")
class ClassTypedArrayReach {
    contains first: Job
    contains second: Job
    var queue: Job[2] := [first, first]
    var index: int := 0

    redefine tran {
        choice {
            queue[index] := second
        } or {
            assume(index < 1)
            index := index + 1
        }
    }

    prop {
        return EF (queue[0] == second && queue[1] == second)
    }
}

@VerificationCase
@Tag("expect-fail")
class ClassTypedArrayBound {
    contains first: Job
    contains second: Job
    var queue: Job[2] := [first, first]
    var index: int := 0

    redefine tran {
        choice {
            queue[index] := second
        } or {
            assume(index < 1)
            index := index + 1
        }
    }

    prop {
        return AG queue[0] == first
    }
}

@VerificationCase
@Tag("expect-pass")
class ClassTypedArrayDispatchReach {
    contains first: Job
    contains second: Job
    var queue: Job[2] := [first, second]
    var index: int := 0

    redefine tran {
        choice {
            inline queue[index].finish()
        } or {
            assume(index < 1)
            index := index + 1
        }
    }

    prop {
        return EF (second.done && !first.done)
    }
}

@VerificationCase
@Tag("expect-pass")
class FeatureTypedArrayHavocBound {
    contains jobs: Job[0..*]
    contains first: Job subsets jobs
    contains second: Job subsets jobs
    contains spare: Job
    var picks: jobs[2] := [first, first]

    redefine tran {
        havoc(picks)
    }

    prop {
        return AG (picks[0] != spare && picks[1] != spare)
    }
}

@VerificationCase
@Tag("expect-fail")
class FeatureTypedArrayHavocChanges {
    contains jobs: Job[0..*]
    contains first: Job subsets jobs
    contains second: Job subsets jobs
    var picks: jobs[2] := [first, first]

    redefine tran {
        havoc(picks)
    }

    prop {
        return AG picks[1] == first
    }
}

@VerificationCase
@Tag("expect-pass")
class ArrayIfThenElseBound {
    var slots: int[2] := [0, 0]
    var others: int[2] := [1, 2]
    var flag: bool := false

    redefine tran {
        havoc(flag)
        slots := if flag then others else [3, 4]
    }

    prop {
        return AG ((slots[0] == 0 && slots[1] == 0) || (slots[0] == 1 && slots[1] == 2) || (slots[0] == 3 && slots[1] == 4))
    }
}

@VerificationCase
@Tag("expect-fail")
class ArrayIfThenElseViolated {
    var slots: int[2] := [0, 0]
    var others: int[2] := [1, 2]
    var flag: bool := false

    redefine tran {
        havoc(flag)
        slots := if flag then others else [3, 4]
    }

    prop {
        return AG slots[1] != 4
    }
}

@VerificationCase
@Tag("expect-pass")
class ArrayNestedIndexReach {
    var slots: int[3] := [2, 0, 1]
    var result: int := 0

    redefine tran {
        assume(result == 0)
        result := slots[slots[0]]
        slots[slots[1]] := 7
    }

    prop {
        return EF (result == 1 && slots[0] == 7)
    }
}

@VerificationCase
@Tag("expect-fail")
class ArrayNestedIndexViolated {
    var slots: int[3] := [2, 0, 1]
    var result: int := 0

    redefine tran {
        assume(result == 0)
        result := slots[slots[0]]
        slots[slots[1]] := 7
    }

    prop {
        return AG result == 0
    }
}
