package semantifyr::verification::lang::arrays

// Fixed-size arrays: compiler flattens to per-index slot variables.
// Tests cover literal initialization, independent indexing, and
// that slots don't bleed into each other.

// --- literal initializer, constant index read ---

// Reachable: slots[0] starts at 10 (from the literal initializer).
@VerificationCase
@Tag("expect-pass")
class ArrayLiteralInit0Reach {
    var values: int[3] := [10, 20, 30]
    var first: int := 0

    redefine tran {
        first := values[0]
    }

    prop {
        return EF first == 10
    }
}

// Reachable: slots[2] starts at 30.
@VerificationCase
@Tag("expect-pass")
class ArrayLiteralInit2Reach {
    var values: int[3] := [10, 20, 30]
    var third: int := 0

    redefine tran {
        third := values[2]
    }

    prop {
        return EF third == 30
    }
}

// Dual: values are bounded by the declared initializers (no phantom
// slot escapes).
@VerificationCase
@Tag("expect-pass")
class ArrayLiteralInitBound {
    var values: int[3] := [10, 20, 30]

    redefine tran { }

    prop {
        return AG (values[0] == 10 && values[1] == 20 && values[2] == 30)
    }
}

// --- independent slot writes ---

// Reachable: independent writes land each in their own slot.
@VerificationCase
@Tag("expect-pass")
@Tag("engine-limit:spin")
class ArraySlotIndependenceReach {
    var slots: int[3] := [0, 0, 0]

    redefine tran {
        choice {
            slots[0] := slots[0] + 1
        } or {
            slots[1] := slots[1] + 1
        } or {
            slots[2] := slots[2] + 1
        }
    }

    prop {
        return EF (slots[0] == 1 && slots[1] == 1 && slots[2] == 1)
    }
}

// Dual: writing slot 0 does not disturb slots 1 or 2 (write
// independence is the invariant we care about for flattening).
@VerificationCase
@Tag("expect-pass")
class ArraySlot0DoesNotAffectOthers {
    var slots: int[3] := [0, 0, 0]

    redefine tran {
        slots[0] := slots[0] + 1
    }

    prop {
        return AG (slots[1] == 0 && slots[2] == 0)
    }
}

// --- read-after-write on the same slot ---

// Reachable: the value stored in slots[1] is what we read back.
@VerificationCase
@Tag("expect-pass")
class ArrayReadAfterWriteReach {
    var slots: int[2] := [0, 0]
    var seen: int := 0

    redefine tran {
        slots[1] := 7
        seen := slots[1]
    }

    prop {
        return EF seen == 7
    }
}

// --- runtime index ---

// Reachable: a runtime index walks the slots one step at a time.
@VerificationCase
@Tag("expect-pass")
class ArrayRuntimeIndexReach {
    var slots: int[3] := [0, 0, 0]
    var i: int := 0

    redefine tran {
        slots[i] := 5
        if (i < 2) {
            i := i + 1
        }
    }

    prop {
        return EF slots[2] == 5
    }
}

// --- ranged multiplicity ---

// Reachable: an [lb..ub] array holds ub slots.
@VerificationCase
@Tag("expect-pass")
class ArrayRangedMultiplicityReach {
    var slots: int[1..3] := [1, 2, 3]
    var seen: int := 0

    redefine tran {
        seen := slots[2]
    }

    prop {
        return EF seen == 3
    }
}

// --- whole-array assignment, comparison and havoc ---

// Reachable: whole-array assignment and comparison work slot by slot.
@VerificationCase
@Tag("expect-pass")
class ArrayWholeCopyReach {
    var slots: int[2] := [0, 0]
    var backup: int[2] := [0, 0]

    redefine tran {
        choice {
            assume(slots[0] < 2)
            slots[0] := slots[0] + 1
        } or {
            backup := slots
        } or {
            slots := [0, 0]
        }
    }

    prop {
        return EF (backup == slots && backup[0] == 2)
    }
}

// Violated: havoc of a whole array reaches values beyond 2.
@VerificationCase
@Tag("expect-fail")
class ArrayWholeHavocBound {
    var slots: int[2] := [0, 0]

    redefine tran {
        havoc(slots)
        assume(slots[0] >= 0 && slots[0] <= 3 && slots[1] == slots[0])
    }

    prop {
        return AG slots[1] <= 2
    }
}

// --- local arrays ---

// Reachable: a local array is initialized every step and read at a runtime index.
@VerificationCase
@Tag("expect-pass")
class LocalArrayRuntimeIndexReach {
    var i: int := 0
    var seen: int := 0

    redefine tran {
        var values: int[3] := [10, 20, 30]
        seen := values[i]
        if (i < 2) {
            i := i + 1
        }
    }

    prop {
        return EF seen == 30
    }
}

// Violated: a runtime-index write into a local array reaches a constant-index read.
@VerificationCase
@Tag("expect-fail")
class LocalArrayRuntimeWriteBound {
    var i: int := 0
    var seen: int := 0

    redefine tran {
        var values: int[3] := [0, 0, 0]
        values[i] := 5
        seen := values[2]
        if (i < 2) {
            i := i + 1
        }
    }

    prop {
        return AG seen == 0
    }
}

// Holds: a local array starts from its initializer every step.
@VerificationCase
@Tag("expect-pass")
class LocalArrayNotPersistedBound {
    var seen: int := 0

    redefine tran {
        var values: int[2] := [1, 2]
        seen := values[0]
        values[0] := 9
    }

    prop {
        return AG seen <= 1
    }
}

// Reachable: an uninitialized local array is havoced at its declaration.
@VerificationCase
@Tag("expect-pass")
class LocalArrayUninitializedReach {
    var seen: int := 0

    redefine tran {
        var values: int[2]
        assume(values[0] >= 0 && values[0] <= 4 && values[1] == values[0])
        seen := values[1]
    }

    prop {
        return EF seen == 4
    }
}

// Reachable: a local array initialized from a class array holds its values.
@VerificationCase
@Tag("expect-pass")
class LocalArrayCopyReach {
    var slots: int[2] := [0, 0]
    var seen: int := 0

    redefine tran {
        var snapshot: int[2] := slots
        seen := snapshot[0] + snapshot[1]
        choice {
            slots[0] := 1
        } or {
            slots[1] := 2
        }
    }

    prop {
        return EF (seen == 3 && slots[0] + slots[1] == 3)
    }
}
