package semantifyr::verification::lang::member_dispatch

class Gauge {
    var level: int := 0
}

class Worker {
    var level: int := 0
    contains gauge: Gauge
}

class Plant {
    contains first: Worker
    contains second: Worker
    var current: Worker[0..1] := nothing
    var seen: int := 0

    redefine init {
        first.level := 1
        first.gauge.level := 1
        second.level := 2
        second.gauge.level := 2
        choice {
            current := first
        } or {
            current := second
        }
    }

    prop levelOf(worker: Worker[0..1]): int {
        return worker.level
    }
}

@VerificationCase
@Tag("expect-pass")
class MemberReadThroughVariableReach : Plant {
    redefine tran {
        seen := current.level
    }

    prop {
        return EF seen == 2
    }
}

@VerificationCase
@Tag("expect-fail")
class MemberReadThroughVariableUnreachable : Plant {
    redefine tran {
        seen := current.level
    }

    prop {
        return EF seen == 3
    }
}

@VerificationCase
@Tag("expect-pass")
class MemberReadThroughVariableBound : Plant {
    prop {
        return AG current.gauge.level == levelOf(current)
    }
}

@VerificationCase
@Tag("expect-fail")
class MemberReadThroughVariableViolated : Plant {
    prop {
        return AG levelOf(current) == 1
    }
}

class Marker {
    var done: bool := false

    tran mark() {
        done := true
    }
}

class Dispatcher {
    contains first: Marker
    contains second: Marker
    var current: Marker[0..1] := nothing
    var stepped: bool := false
    var seen: bool := false
}

@VerificationCase
@Tag("expect-pass")
class OptionalCallThroughVariableReach : Dispatcher {
    redefine init {
        current := first
    }

    redefine tran {
        inline current?.mark()
    }

    prop {
        return EF first.done
    }
}

@VerificationCase
@Tag("expect-fail")
class OptionalCallThroughVariableUnreachable : Dispatcher {
    redefine init {
        current := first
    }

    redefine tran {
        inline current?.mark()
    }

    prop {
        return EF second.done
    }
}

@VerificationCase
@Tag("expect-pass")
class OptionalCallThroughNothingReach : Dispatcher {
    redefine tran {
        inline current?.mark()
        stepped := true
    }

    prop {
        return EF stepped
    }
}

@VerificationCase
@Tag("expect-fail")
class OptionalCallThroughNothingUnreachable : Dispatcher {
    redefine tran {
        inline current?.mark()
        stepped := true
    }

    prop {
        return EF (first.done || second.done)
    }
}

@VerificationCase
@Tag("expect-pass")
class ReadThroughNothingBlocks : Dispatcher {
    redefine tran {
        seen := current.done
        stepped := true
    }

    prop {
        return AG !stepped
    }
}

@VerificationCase
@Tag("expect-fail")
class ReadThroughNothingBlocksViolated : Dispatcher {
    redefine init {
        choice {
            current := nothing
        } or {
            current := first
        }
    }

    redefine tran {
        seen := current.done
        stepped := true
    }

    prop {
        return AG !stepped
    }
}
