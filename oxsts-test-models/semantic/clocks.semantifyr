package semantifyr::verification::lang::clocks

@VerificationCase
@Tag("expect-pass")
class ClockDeadlineOnOtherPathReach {
    var elapsed: clock := 0
    var late: bool := false

    redefine tran {
        choice {
            assume(elapsed <= 5)
        } or {
            assume(elapsed >= 6)
            assume(elapsed <= 6)
            late := true
            elapsed := 0
        }
    }

    prop {
        return EF late
    }
}

@VerificationCase
@Tag("expect-fail")
class ClockDeadlineOnSamePathUnreachable {
    var elapsed: clock := 0
    var late: bool := false

    redefine tran {
        choice {
            assume(elapsed <= 5)
        } or {
            assume(elapsed <= 5)
            assume(elapsed >= 6)
            late := true
            elapsed := 0
        }
    }

    prop {
        return EF late
    }
}

@VerificationCase
@Tag("expect-pass")
class ClockInitPassesNoTime {
    var elapsed: clock := 0
    var early: bool := false

    redefine init {
        choice {
            assume(elapsed >= 1)
            early := true
        } or {
        }
    }

    redefine tran {
        assume(elapsed <= 1)
    }

    prop {
        return AG !early
    }
}

@VerificationCase
@Tag("expect-fail")
class ClockInitPassesNoTimeViolated {
    var elapsed: clock := 0
    var early: bool := false

    redefine tran {
        assume(elapsed <= 1)
        choice {
            assume(elapsed >= 1)
            early := true
        } or {
        }
    }

    prop {
        return AG !early
    }
}

