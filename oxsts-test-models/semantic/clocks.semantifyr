@VerificationCase
@Tag("expect-pass")
class ClockStrictTestDenseReach {
    var elapsed: clock := 0
    var between: bool := false

    redefine tran {
        assume(elapsed <= 1)
        choice {
            assume(elapsed > 0 && elapsed < 1)
            between := true
        } or {
        }
        elapsed := 0
    }

    prop {
        return EF between
    }
}

@VerificationCase
@Tag("expect-fail")
class ClockStrictTestDenseUnreachable {
    var elapsed: clock := 0
    var between: bool := false

    redefine tran {
        assume(elapsed <= 0)
        choice {
            assume(elapsed > 0 && elapsed < 1)
            between := true
        } or {
        }
        elapsed := 0
    }

    prop {
        return EF between
    }
}

@VerificationCase
@Tag("expect-pass")
class ClockNegatedTestReach {
    var elapsed: clock := 0
    var late: bool := false

    redefine tran {
        assume(elapsed <= 6)
        choice {
            assume(!(elapsed <= 5))
            late := true
