@VerificationCase
@Tag("expect-pass")
class ClockSaturationReach {
    var lap: clock := 0
    var total: clock := 0
    var count: int := 0

    redefine tran {
        assume(lap >= 2)
        assume(total <= 7)
        lap := 0
        if (count < 3) {
            count := count + 1
        }
    }

    prop {
        return EF count == 3
    }
}

@VerificationCase
@Tag("expect-fail")
class ClockSaturationUnreachable {
    var lap: clock := 0
    var total: clock := 0
    var count: int := 0

    redefine tran {
        assume(lap >= 2)
        assume(total <= 5)
        lap := 0
        if (count < 3) {
            count := count + 1
        }
    }

    prop {
        return EF count == 3
    }
}
