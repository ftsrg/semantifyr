@VerificationCase
@Tag("expect-pass")
class ClockConditionalValueReach {
    var elapsed: clock := 0
    var count: int := 0

    redefine tran {
        assume(elapsed <= 2)
        count := if (elapsed >= 2) then 1 else 0
    }

    prop {
        return EF count == 1
    }
}

@VerificationCase
@Tag("expect-fail")
class ClockConditionalValueUnreachable {
    var elapsed: clock := 0
    var count: int := 0

    redefine tran {
        assume(elapsed <= 1)
        count := if (elapsed >= 2) then 1 else 0
    }

    prop {
        return EF count == 1
    }
}

class Timer {
    var elapsed: clock := 0

    tran restart() {
        elapsed := 0
    }
}

@VerificationCase
@Tag("expect-pass")
class ClockThroughReferenceReach {
    contains first: Timer
    contains second: Timer
    var current: Timer := first
    var hit: bool := false

    redefine tran {
        assume(second.elapsed <= 2)
        inline current.restart()
        current := second
        choice {
            assume(current.elapsed >= 1)
            hit := true
        } or {
        }
    }

    prop {
        return EF hit
    }
}

@VerificationCase
@Tag("expect-fail")
class ClockThroughReferenceUnreachable {
    contains first: Timer
    contains second: Timer
    var current: Timer := first
    var hit: bool := false

    redefine tran {
        assume(second.elapsed <= 0)
        inline current.restart()
        current := second
        choice {
            assume(current.elapsed >= 1)
            hit := true
        } or {
        }
    }

    prop {
        return EF hit
    }
}

class Alarm {
    refers limit: int
    var elapsed: clock := 0
    var rang: bool := false

    tran ring(after: int) {
        assume(elapsed <= limit)
        choice {
            assume(elapsed >= after)
            rang := true
        } or {
        }
    }
}

@VerificationCase
@Tag("expect-pass")
class ClockBoundFromFeatureReach {
    contains alarm: Alarm {
        redefine refers limit: int = 3
    }

    redefine tran {
        inline alarm.ring(3)
    }

    prop {
        return EF alarm.rang
    }
}

@VerificationCase
@Tag("expect-fail")
class ClockBoundFromFeatureUnreachable {
    contains alarm: Alarm {
        redefine refers limit: int = 2
    }

    redefine tran {
        inline alarm.ring(3)
    }

    prop {
        return EF alarm.rang
    }
}

