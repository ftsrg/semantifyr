package semantifyr::verification::lang::tracing

class Lamp {
    var on: bool := false

    @Trace
    tran toggle(partner: Lamp) {
        on := !on
    }
}

class Room {
    contains lamp: Lamp
}

@VerificationCase
@Tag("expect-pass")
class TracedChoiceBranchReach {
    contains kitchen: Room
    contains hall: Room

    redefine tran {
        choice {
            inline kitchen.lamp.toggle(hall.lamp)
        } or {
            inline hall.lamp.toggle(kitchen.lamp)
        }
    }

    prop {
        return EF (kitchen.lamp.on && !hall.lamp.on)
    }
}

@VerificationCase
@Tag("expect-pass")
class TracedChoiceBranchParity {
    contains kitchen: Room
    contains hall: Room
    var odd: bool := false

    redefine tran {
        odd := !odd
        choice {
            inline kitchen.lamp.toggle(hall.lamp)
        } or {
            inline hall.lamp.toggle(kitchen.lamp)
        }
    }

    prop {
        return AG ((kitchen.lamp.on != hall.lamp.on) == odd)
    }
}

@VerificationCase
@Tag("expect-fail")
class TracedChoiceBranchViolated {
    contains kitchen: Room
    contains hall: Room

    redefine tran {
        choice {
            inline kitchen.lamp.toggle(hall.lamp)
        } or {
            inline hall.lamp.toggle(kitchen.lamp)
        }
    }

    prop {
        return AG !kitchen.lamp.on
    }
}
