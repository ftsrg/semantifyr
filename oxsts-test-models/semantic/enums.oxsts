package semantifyr::verification::lang::enums

enum Color {
    Red,
    Green,
    Blue,
}

@VerificationCase
@Tag("expect-pass")
class EnumStepReach {
    var color: Color := Color::Red

    redefine tran {
        choice {
            assume(color == Color::Red)
            color := Color::Green
        } or {
            assume(color == Color::Green)
            color := Color::Blue
        }
    }

    prop {
        return EF color == Color::Blue
    }
}

@VerificationCase
@Tag("expect-pass")
class EnumStepDomainClosed {
    var color: Color := Color::Red

    redefine tran {
        choice {
            assume(color == Color::Red)
            color := Color::Green
        } or {
            assume(color == Color::Green)
            color := Color::Blue
        }
    }

    prop {
        return AG (color == Color::Red || color == Color::Green || color == Color::Blue)
    }
}

@VerificationCase
@Tag("expect-pass")
class EnumAnyReachRed {
    var color: Color := Color::Green

    redefine tran {
        choice {
            color := Color::Red
        } or {
            color := Color::Green
        } or {
            color := Color::Blue
        }
    }

    prop {
        return EF color == Color::Red
    }
}

@VerificationCase
@Tag("expect-pass")
class EnumAnyReachBlue {
    var color: Color := Color::Red

    redefine tran {
        choice {
            color := Color::Red
        } or {
            color := Color::Green
        } or {
            color := Color::Blue
        }
    }

    prop {
        return EF color == Color::Blue
    }
}

@VerificationCase
@Tag("expect-pass")
class EnumAnyDomainClosed {
    var color: Color := Color::Red

    redefine tran {
        choice {
            color := Color::Red
        } or {
            color := Color::Green
        } or {
            color := Color::Blue
        }
    }

    prop {
        return AG (color == Color::Red || color == Color::Green || color == Color::Blue)
    }
}

@VerificationCase
@Tag("expect-fail")
class EnumStepViolated {
    var color: Color := Color::Red

    redefine tran {
        choice {
            assume(color == Color::Red)
            color := Color::Green
        } or {
            assume(color == Color::Green)
            color := Color::Blue
        }
    }

    prop {
        return AG color != Color::Blue
    }
}
