package semantifyr::verification::lang::parity

@VerificationCase
@Tag("expect-pass")
class IntegerCounterReach {
    var x: int := 0

    redefine tran {
        assume(x < 3)
        x := x + 1
    }

    prop {
        return EF x == 3
    }
}

@VerificationCase
@Tag("expect-pass")
class IntegerCounterBound {
    var x: int := 0

    redefine tran {
        assume(x < 3)
        x := x + 1
    }

    prop {
        return AG (x >= 0 && x <= 3)
    }
}

@VerificationCase
@Tag("expect-pass")
class BooleanHavocTrue {
    var flag: bool := false

    redefine tran {
        havoc(flag)
    }

    prop {
        return EF flag == true
    }
}

@VerificationCase
@Tag("expect-pass")
class BooleanHavocFalse {
    var flag: bool := true

    redefine tran {
        havoc(flag)
    }

    prop {
        return EF flag == false
    }
}

@VerificationCase
@Tag("expect-pass")
class ChoiceBound {
    var x: int := 0

    redefine tran {
        choice {
            x := 1
        } or {
            x := 2
        }
    }

    prop {
        return AG (x == 0 || x == 1 || x == 2)
    }
}

@VerificationCase
@Tag("expect-pass")
class ChoiceBranchReach {
    var x: int := 0

    redefine tran {
        choice {
            x := 1
        } or {
            x := 2
        }
    }

    prop {
        return EF x == 2
    }
}
