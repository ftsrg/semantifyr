package semantifyr::verification::lang::boundedness

@VerificationCase
@Tag("expect-pass")
class UnboundedCounterReach {
    var x: int := 0

    redefine tran {
        x := x + 1
    }

    prop {
        return EF x == 5
    }
}

@VerificationCase
@Tag("expect-pass")
class UnboundedCounterBound {
    var x: int := 0

    redefine tran {
        x := x + 1
    }

    prop {
        return AG x >= 0
    }
}

@VerificationCase
@Tag("expect-pass")
class DoublingStaysPositive {
    var x: int := 1

    redefine tran {
        x := x * 2
    }

    prop {
        return AG x > 0
    }
}

@VerificationCase
@Tag("expect-fail")
class DoublingReachesNegative {
    var x: int := 1

    redefine tran {
        x := x * 2
    }

    prop {
        return EF x < 0
    }
}

// An unbounded counter that only decides whether an assumption blocks is still in the cone of influence.
@VerificationCase
@Tag("expect-fail")
class UnboundedGuardAroundAssumption {
    var x: int := 0
    var y: int := 0

    redefine tran {
        choice {
            x := x + 1
        } or {
            if (x <= 5) {
                assume(false)
            }
            y := 1
        }
    }

    prop {
        return AG y == 0
    }
}

@VerificationCase
@Tag("expect-pass")
class SaturatingCounterReach {
    var x: int := 0

    redefine tran {
        if (x < 10) {
            x := x + 1
        }
    }

    prop {
        return EF x == 10
    }
}

@VerificationCase
@Tag("expect-pass")
class SaturatingCounterBound {
    var x: int := 0

    redefine tran {
        if (x < 10) {
            x := x + 1
        }
    }

    prop {
        return AG x <= 10
    }
}

@VerificationCase
@Tag("expect-pass")
class TimerCountdownBound {
    var timer: int := 0

    redefine init {
        timer := 3
    }

    redefine tran {
        choice {
            if (timer > 0) {
                timer := timer - 1
            }
        } or {
            assume(timer == 0)
            timer := 3
        }
    }

    prop {
        return AG (timer >= 0 && timer <= 3)
    }
}

// Beyond Uppaal's default 16-bit int, which Uppaal decides through the declared range.
@VerificationCase
@Tag("expect-pass")
class BeyondSixteenBitsReach {
    var x: int := 0

    redefine tran {
        if (x < 100000) {
            x := x + 25000
        }
    }

    prop {
        return EF x == 100000
    }
}

@VerificationCase
@Tag("expect-pass")
class BeyondSixteenBitsBound {
    var x: int := 0

    redefine tran {
        if (x < 100000) {
            x := x + 25000
        }
    }

    prop {
        return AG x <= 100000
    }
}

// An unbounded counter the property does not depend on does not limit any engine.
@VerificationCase
@Tag("expect-pass")
class UnboundedCounterOutsideCone {
    var steps: int := 0
    var x: int := 0

    redefine tran {
        steps := steps + 1
        if (x < 3) {
            x := x + 1
        }
    }

    prop {
        return AG x <= 3
    }
}
