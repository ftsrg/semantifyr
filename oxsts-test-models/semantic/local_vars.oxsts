package semantifyr::verification::lang::local_vars

@VerificationCase
@Tag("expect-pass")
class LocalVariableAccumulateReach {
    var total: int := 0

    redefine tran {
        assume(total < 3)
        var part: int := 0
        part := part + 1
        part := part + 2
        total := total + part
    }

    prop {
        return EF total == 3
    }
}

@VerificationCase
@Tag("expect-pass")
class LocalVariableAccumulateBound {
    var total: int := 0

    redefine tran {
        assume(total < 3)
        var part: int := 0
        part := part + 1
        part := part + 2
        total := total + part
    }

    prop {
        return AG total <= 3
    }
}

@VerificationCase
@Tag("expect-pass")
class LocalVariableHavocReach {
    var x: int := 0

    redefine tran {
        assume(x < 3)
        var delta: int := 0
        havoc(delta)
        assume(delta == 3 - x)
        x := x + delta
    }

    prop {
        return EF x == 3
    }
}

@VerificationCase
@Tag("expect-pass")
class LocalVariableHavocBound {
    var x: int := 0

    redefine tran {
        assume(x < 3)
        var delta: int := 0
        havoc(delta)
        assume(delta >= 1 && delta <= 3 - x)
        x := x + delta
    }

    prop {
        return AG (x >= 0 && x <= 3)
    }
}

@VerificationCase
@Tag("expect-pass")
class LocalVariableNotPersistedBound {
    var total: int := 0

    redefine tran {
        var cache: int := 0
        cache := 9
        total := total + cache
    }

    prop {
        return AG total >= 0
    }
}

@VerificationCase
@Tag("expect-pass")
class LocalVariableUninitializedReach {
    var x: int := 0

    redefine tran {
        var delta: int
        assume(delta >= 1 && delta <= 3)
        x := delta
    }

    prop {
        return EF x == 3
    }
}

@VerificationCase
@Tag("expect-fail")
class LocalVariableUninitializedBound {
    var x: int := 0

    redefine tran {
        var delta: int
        assume(delta >= 1 && delta <= 3)
        x := delta
    }

    prop {
        return AG x <= 1
    }
}

@VerificationCase
@Tag("expect-fail")
class LocalVariableAccumulateViolated {
    var total: int := 0

    redefine tran {
        assume(total < 3)
        var part: int := 0
        part := part + 1
        part := part + 2
        total := total + part
    }

    prop {
        return AG total <= 2
    }
}
