package semantifyr::verification::lang::if_then_else

@VerificationCase
@Tag("expect-pass")
class IfThenElseThenReach {
    var value: int := 1
    var result: int := 0

    redefine tran {
        result := if value > 0 then 1 else -1
    }

    prop {
        return EF result == 1
    }
}

@VerificationCase
@Tag("expect-pass")
class IfThenElseElseReach {
    var value: int := -1
    var result: int := 0

    redefine tran {
        result := if value > 0 then 1 else -1
    }

    prop {
        return EF result == -1
    }
}

@VerificationCase
@Tag("expect-pass")
class IfThenElseBound {
    var value: int := 0
    var result: int := 0

    redefine tran {
        havoc(value)
        result := if value > 0 then 1 else -1
    }

    prop {
        return AG (result == 0 || result == 1 || result == -1)
    }
}

@VerificationCase
@Tag("expect-pass")
class IfThenElseInPropertyReach {
    var value: int := 0

    redefine tran {
        assume(value < 5)
        value := value + 1
    }

    prop {
        return EF (if value > 0 then true else false)
    }
}

@VerificationCase
@Tag("expect-pass")
class IfThenElseInPropertyInitialFalse {
    var flag: bool := false

    redefine tran {
        havoc(flag)
        assume(flag == false)
    }

    prop {
        return AG !(if flag then true else false)
    }
}

@VerificationCase
@Tag("expect-fail")
class IfThenElseViolated {
    var value: int := 0
    var result: int := 0

    redefine tran {
        havoc(value)
        result := if value > 0 then 1 else -1
    }

    prop {
        return AG result != -1
    }
}

@VerificationCase
@Tag("expect-fail")
class IfThenElseInPropertyUnreachable {
    var value: int := 0

    redefine tran {
        assume(value < 5)
        value := value + 1
    }

    prop {
        return EF (if value > 5 then true else false)
    }
}
