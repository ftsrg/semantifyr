package semantifyr::verification::lang::records

// Records are values: the compiler flattens each record variable into one scalar variable per field, nested records recursively. Assignment copies every field and comparison is by value. A record literal lists fields by name; an omitted field takes its default.

enum Light { Off, On }

record Point {
    var x: int := 0
    var y: int := 0
}

record Reading {
    var value: int
    var valid: bool := false
}

record Cell {
    var position: Point
    var light: Light := Light::Off
}

record Line {
    var from: Point := Point { x = 1, y = 1 }
    var to: Point
}

// --- field read and write ---

// Reachable: independent field writes reach (2, 1).
@VerificationCase
@Tag("expect-pass")
class RecordFieldWriteReach {
    var p: Point

    redefine tran {
        choice {
            assume(p.x < 2)
            p.x := p.x + 1
        } or {
            assume(p.y < 1)
            p.y := p.y + 1
        }
    }

    prop {
        return EF (p.x == 2 && p.y == 1)
    }
}

// Violated: the fields leave the origin.
@VerificationCase
@Tag("expect-fail")
class RecordFieldWriteBound {
    var p: Point

    redefine tran {
        choice {
            assume(p.x < 2)
            p.x := p.x + 1
        } or {
            assume(p.y < 1)
            p.y := p.y + 1
        }
    }

    prop {
        return AG p.x + p.y <= 2
    }
}

// --- assignment copies, comparison by value ---

// Holds: a copy taken after every write equals the original.
@VerificationCase
@Tag("expect-pass")
class RecordCopyEqualityBound {
    var p: Point
    var q: Point

    redefine tran {
        choice {
            assume(p.x < 3)
            p.x := p.x + 1
        } or {
            assume(p.y < 3)
            p.y := p.y + 1
        }
        q := p
    }

    prop {
        return AG p == q
    }
}

// Violated: a copy does not alias, so writing the original after the copy leaves the copy behind.
@VerificationCase
@Tag("expect-fail")
class RecordCopyIsNoAlias {
    var p: Point
    var q: Point
    var copied: bool := false

    redefine tran {
        choice {
            q := p
            copied := true
        } or {
            assume(p.x < 2)
            p.x := p.x + 1
        }
    }

    prop {
        return AG (!copied || p == q)
    }
}

// --- nested records ---

// Reachable: a nested field write and an enum field travel together in a record copy.
@VerificationCase
@Tag("expect-pass")
class NestedRecordReach {
    var a: Cell
    var b: Cell

    redefine tran {
        choice {
            assume(a.position.x < 2)
            a.position.x := a.position.x + 1
        } or {
            a.light := Light::On
        } or {
            b := a
        }
    }

    prop {
        return EF (b == a && b.light == Light::On && b.position.x == 2)
    }
}

// Violated: the light of a copied cell does not stay off.
@VerificationCase
@Tag("expect-fail")
class NestedRecordBound {
    var a: Cell
    var b: Cell

    redefine tran {
        choice {
            a.light := Light::On
        } or {
            b.position := a.position
            b.light := a.light
        }
    }

    prop {
        return AG b.light == Light::Off
    }
}

// --- local records and havoc ---

// Reachable: a havoced local record is copied into the state.
@VerificationCase
@Tag("expect-pass")
class LocalRecordHavocReach {
    var p: Point

    redefine tran {
        var next: Point
        havoc(next)
        assume(next.x >= 0 && next.x <= 3 && next.y == next.x)
        p := next
    }

    prop {
        return EF (p.x == 3 && p.y == 3)
    }
}

// Violated: the havoced local record reaches beyond 2.
@VerificationCase
@Tag("expect-fail")
class LocalRecordHavocBound {
    var p: Point

    redefine tran {
        var next: Point
        havoc(next)
        assume(next.x >= 0 && next.x <= 3 && next.y == next.x)
        p := next
    }

    prop {
        return AG p.x <= 2
    }
}

// Holds: an uninitialized local record havocs only the fields without a default, so a copied reading stays invalid.
@VerificationCase
@Tag("expect-pass")
class LocalRecordDefaultsBound {
    var last: Reading

    redefine tran {
        choice {
            var next: Reading
            assume(next.value == 3)
            last := next
        } or {
            last.value := 0
            last.valid := true
        }
    }

    prop {
        return AG (!last.valid || last.value == 0)
    }
}

// --- record parameters and records in contained instances ---

// Holds: a record argument is copied field by field.
@VerificationCase
@Tag("expect-pass")
class RecordParameterBound {
    var p: Point
    var origin: Point

    tran moveTo(target: Point) {
        p := target
    }

    redefine tran {
        choice {
            p.x := 1
        } or {
            inline moveTo(origin)
        }
    }

    prop {
        return AG (p.y == 0 && p.x <= 1)
    }
}

class Robot {
    var position: Point

    tran step() {
        assume(position.x < 3)
        position.x := position.x + 1
    }
}

// Reachable: a record variable of a contained instance.
@VerificationCase
@Tag("expect-pass")
class ContainedRecordReach {
    contains robot: Robot

    redefine tran {
        inline robot.step()
    }

    prop {
        return EF robot.position.x == 3
    }
}

// --- record literals ---

// Reachable: a literal assigns every field at once, so the swap reads the fields before it writes them.
@VerificationCase
@Tag("expect-pass")
class RecordLiteralAssignReach {
    var p: Point

    redefine tran {
        choice {
            assume(p.x == 0)
            p := Point { x = 2, y = 3 }
        } or {
            p := Point { x = p.y, y = p.x }
        }
    }

    prop {
        return EF p == Point { x = 3, y = 2 }
    }
}

// Violated: the swapped point is neither on the diagonal nor the assigned literal.
@VerificationCase
@Tag("expect-fail")
class RecordLiteralAssignBound {
    var p: Point

    redefine tran {
        choice {
            assume(p.x == 0)
            p := Point { x = 2, y = 3 }
        } or {
            p := Point { x = p.y, y = p.x }
        }
    }

    prop {
        return AG (p.x == p.y || p == Point { x = 2, y = 3 })
    }
}

// Holds: an omitted field takes its default, not its old value, so x and y are never both non-zero.
@VerificationCase
@Tag("expect-pass")
class RecordLiteralDefaultBound {
    var p: Point := Point { y = 5 }

    redefine tran {
        assume(p.x < 3)
        p := Point { x = p.x + 1 }
    }

    prop {
        return AG (p.x == 0 || p.y == 0)
    }
}

// Violated: the next literal resets y to its default.
@VerificationCase
@Tag("expect-fail")
class RecordLiteralDefaultViolated {
    var p: Point := Point { y = 5 }

    redefine tran {
        assume(p.x < 3)
        p := Point { x = p.x + 1 }
    }

    prop {
        return AG p.y == 5
    }
}

// Reachable: a local literal reads the state and an `if` compares with a literal.
@VerificationCase
@Tag("expect-pass")
class LocalRecordLiteralReach {
    var p: Point
    var hits: int := 0

    redefine tran {
        var next: Point := Point { x = p.x + 1, y = p.x }
        assume(next.x <= 3)
        if (next == Point { x = 2, y = 1 }) {
            hits := hits + 1
        }
        p := next
    }

    prop {
        return EF (hits == 1 && p == Point { x = 3, y = 2 })
    }
}

// Holds: a literal argument is copied into the parameter, and a field of the parameter reads the literal.
@VerificationCase
@Tag("expect-pass")
class RecordLiteralArgumentBound {
    var p: Point
    var lastX: int := 0

    tran moveTo(target: Point) {
        p := target
        lastX := target.x
    }

    redefine tran {
        assume(p.y < 3)
        inline moveTo(Point { x = 2, y = p.y + 1 })
    }

    prop {
        return AG (p.x == lastX && p.y <= 3)
    }
}

// Reachable: a literal argument of a property call.
@VerificationCase
@Tag("expect-pass")
class RecordLiteralArgumentReach {
    var p: Point

    prop isAt(point: Point): bool {
        return p == point
    }

    redefine tran {
        assume(p.y < 3)
        p := Point { x = 2, y = p.y + 1 }
    }

    prop {
        return EF isAt(Point { x = 2, y = 3 })
    }
}

// Violated: the literal argument moves y to 3.
@VerificationCase
@Tag("expect-fail")
class RecordLiteralArgumentViolated {
    var p: Point

    tran moveTo(target: Point) {
        p := target
    }

    redefine tran {
        assume(p.y < 3)
        inline moveTo(Point { x = 2, y = p.y + 1 })
    }

    prop {
        return AG p.y <= 2
    }
}

// Holds: a record-typed field without an initializer in the variable takes the field's literal default.
@VerificationCase
@Tag("expect-pass")
class RecordFieldLiteralDefaultBound {
    var l: Line

    redefine tran {
        assume(l.to.x < 2)
        l.to.x := l.to.x + 1
    }

    prop {
        return AG l.from == Point { x = 1, y = 1 }
    }
}

// Reachable: a nested literal reads the state, and the omitted `from` takes its literal default again.
@VerificationCase
@Tag("expect-pass")
class NestedRecordLiteralReach {
    var l: Line

    redefine tran {
        choice {
            l.from := Point { x = 0 }
        } or {
            assume(l.to.x < 2)
            l := Line { to = Point { x = l.to.x + 1, y = l.from.x } }
        }
    }

    prop {
        return EF (l.to == Point { x = 2, y = 1 } && l.from.x == 1)
    }
}

// Violated: the nested literal copies the default `from.x` into `to.y`.
@VerificationCase
@Tag("expect-fail")
class NestedRecordLiteralViolated {
    var l: Line

    redefine tran {
        choice {
            l.from := Point { x = 0 }
        } or {
            assume(l.to.x < 2)
            l := Line { to = Point { x = l.to.x + 1, y = l.from.x } }
        }
    }

    prop {
        return AG l.to.y == 0
    }
}

@VerificationCase
@Tag("expect-fail")
class RecordParameterViolated {
    var p: Point
    var origin: Point := Point { x = 5 }

    tran moveTo(target: Point) {
        p := target
    }

    redefine tran {
        inline moveTo(origin)
    }

    prop {
        return AG p.x <= 1
    }
}
