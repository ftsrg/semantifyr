package semantifyr::verification::lang::records

enum Light {
    Off,
    On,
}

record Point {
    var x: int := 0
    var y: int := 0
}

record Reading {
    var value: int := 0
    var valid: bool := false
}

record Cell {
    var position: Point := Point { x = 0 }
    var light: Light := Light::Off
}

record Line {
    var from: Point := Point { x = 1, y = 1 }
    var to: Point := Point { x = 0 }
}

@VerificationCase
@Tag("expect-pass")
class RecordFieldWriteReach {
    var point: Point := Point { x = 0 }

    redefine tran {
        choice {
            assume(point.x < 2)
            point.x := point.x + 1
        } or {
            assume(point.y < 1)
            point.y := point.y + 1
        }
    }

    prop {
        return EF (point.x == 2 && point.y == 1)
    }
}

@VerificationCase
@Tag("expect-fail")
class RecordFieldWriteBound {
    var point: Point := Point { x = 0 }

    redefine tran {
        choice {
            assume(point.x < 2)
            point.x := point.x + 1
        } or {
            assume(point.y < 1)
            point.y := point.y + 1
        }
    }

    prop {
        return AG point.x + point.y <= 2
    }
}

@VerificationCase
@Tag("expect-pass")
class RecordCopyEqualityBound {
    var point: Point := Point { x = 0 }
    var copy: Point := Point { x = 0 }

    redefine tran {
        choice {
            assume(point.x < 3)
            point.x := point.x + 1
        } or {
            assume(point.y < 3)
            point.y := point.y + 1
        }
        copy := point
    }

    prop {
        return AG point == copy
    }
}

@VerificationCase
@Tag("expect-fail")
class RecordCopyIsNoAlias {
    var point: Point := Point { x = 0 }
    var copy: Point := Point { x = 0 }
    var copied: bool := false

    redefine tran {
        choice {
            copy := point
            copied := true
        } or {
            assume(point.x < 2)
            point.x := point.x + 1
        }
    }

    prop {
        return AG (!copied || point == copy)
    }
}

@VerificationCase
@Tag("expect-pass")
class NestedRecordReach {
    var original: Cell := Cell { light = Light::Off }
    var copy: Cell := Cell { light = Light::Off }

    redefine tran {
        choice {
            assume(original.position.x < 2)
            original.position.x := original.position.x + 1
        } or {
            original.light := Light::On
        } or {
            copy := original
        }
    }

    prop {
        return EF (copy == original && copy.light == Light::On && copy.position.x == 2)
    }
}

@VerificationCase
@Tag("expect-fail")
class NestedRecordBound {
    var original: Cell := Cell { light = Light::Off }
    var copy: Cell := Cell { light = Light::Off }

    redefine tran {
        choice {
            original.light := Light::On
        } or {
            copy.position := original.position
            copy.light := original.light
        }
    }

    prop {
        return AG copy.light == Light::Off
    }
}

@VerificationCase
@Tag("expect-pass")
class LocalRecordHavocReach {
    var point: Point := Point { x = 0 }

    redefine tran {
        var next: Point := Point { x = 0 }
        havoc(next)
        assume(next.x >= 0 && next.x <= 3 && next.y == next.x)
        point := next
    }

    prop {
        return EF (point.x == 3 && point.y == 3)
    }
}

@VerificationCase
@Tag("expect-fail")
class LocalRecordHavocBound {
    var point: Point := Point { x = 0 }

    redefine tran {
        var next: Point := Point { x = 0 }
        havoc(next)
        assume(next.x >= 0 && next.x <= 3 && next.y == next.x)
        point := next
    }

    prop {
        return AG point.x <= 2
    }
}

@VerificationCase
@Tag("expect-pass")
class LocalRecordDefaultsBound {
    var last: Reading := Reading { value = 0 }

    redefine tran {
        choice {
            var next: Reading := Reading { value = 0 }
            havoc(next.value)
            assume(next.value == 3)
            last := next
        } or {
            last.value := 0
            last.valid := true
        }
    }

    prop {
        return AG (!last.valid || last.value == 0)
    }
}

@VerificationCase
@Tag("expect-pass")
class RecordParameterBound {
    var point: Point := Point { x = 0 }
    var origin: Point := Point { x = 0 }

    tran moveTo(target: Point) {
        point := target
    }

    redefine tran {
        choice {
            point.x := 1
        } or {
            inline moveTo(origin)
        }
    }

    prop {
        return AG (point.y == 0 && point.x <= 1)
    }
}

class Robot {
    var position: Point := Point { x = 0 }

    tran step() {
        assume(position.x < 3)
        position.x := position.x + 1
    }
}

@VerificationCase
@Tag("expect-pass")
class ContainedRecordReach {
    contains robot: Robot

    redefine tran {
        inline robot.step()
    }

    prop {
        return EF robot.position.x == 3
    }
}

@VerificationCase
@Tag("expect-pass")
class RecordLiteralAssignReach {
    var point: Point := Point { x = 0 }

    redefine tran {
        choice {
            assume(point.x == 0)
            point := Point { x = 2, y = 3 }
        } or {
            point := Point { x = point.y, y = point.x }
        }
    }

    prop {
        return EF point == Point { x = 3, y = 2 }
    }
}

@VerificationCase
@Tag("expect-fail")
class RecordLiteralAssignBound {
    var point: Point := Point { x = 0 }

    redefine tran {
        choice {
            assume(point.x == 0)
            point := Point { x = 2, y = 3 }
        } or {
            point := Point { x = point.y, y = point.x }
        }
    }

    prop {
        return AG (point.x == point.y || point == Point { x = 2, y = 3 })
    }
}

@VerificationCase
@Tag("expect-pass")
class RecordLiteralDefaultBound {
    var point: Point := Point { y = 5 }

    redefine tran {
        assume(point.x < 3)
        point := Point { x = point.x + 1 }
    }

    prop {
        return AG (point.x == 0 || point.y == 0)
    }
}

@VerificationCase
@Tag("expect-fail")
class RecordLiteralDefaultViolated {
    var point: Point := Point { y = 5 }

    redefine tran {
        assume(point.x < 3)
        point := Point { x = point.x + 1 }
    }

    prop {
        return AG point.y == 5
    }
}

@VerificationCase
@Tag("expect-pass")
class LocalRecordLiteralReach {
    var point: Point := Point { x = 0 }
    var hits: int := 0

    redefine tran {
        var next: Point := Point { x = point.x + 1, y = point.x }
        assume(next.x <= 3)
        if (next == Point { x = 2, y = 1 }) {
            hits := hits + 1
        }
        point := next
    }

    prop {
        return EF (hits == 1 && point == Point { x = 3, y = 2 })
    }
}

@VerificationCase
@Tag("expect-pass")
class RecordLiteralArgumentBound {
    var point: Point := Point { x = 0 }
    var lastX: int := 0

    tran moveTo(target: Point) {
        point := target
        lastX := target.x
    }

    redefine tran {
        assume(point.y < 3)
        inline moveTo(Point { x = 2, y = point.y + 1 })
    }

    prop {
        return AG (point.x == lastX && point.y <= 3)
    }
}

@VerificationCase
@Tag("expect-pass")
class RecordLiteralArgumentReach {
    var point: Point := Point { x = 0 }

    prop isAt(target: Point): bool {
        return point == target
    }

    redefine tran {
        assume(point.y < 3)
        point := Point { x = 2, y = point.y + 1 }
    }

    prop {
        return EF isAt(Point { x = 2, y = 3 })
    }
}

@VerificationCase
@Tag("expect-fail")
class RecordLiteralArgumentViolated {
    var point: Point := Point { x = 0 }

    tran moveTo(target: Point) {
        point := target
    }

    redefine tran {
        assume(point.y < 3)
        inline moveTo(Point { x = 2, y = point.y + 1 })
    }

    prop {
        return AG point.y <= 2
    }
}

@VerificationCase
@Tag("expect-pass")
class RecordFieldLiteralDefaultBound {
    var line: Line := Line { to = Point { x = 0 } }

    redefine tran {
        assume(line.to.x < 2)
        line.to.x := line.to.x + 1
    }

    prop {
        return AG line.from == Point { x = 1, y = 1 }
    }
}

@VerificationCase
@Tag("expect-pass")
class NestedRecordLiteralReach {
    var line: Line := Line { to = Point { x = 0 } }

    redefine tran {
        choice {
            line.from := Point { x = 0 }
        } or {
            assume(line.to.x < 2)
            line := Line { to = Point { x = line.to.x + 1, y = line.from.x } }
        }
    }

    prop {
        return EF (line.to == Point { x = 2, y = 1 } && line.from.x == 1)
    }
}

@VerificationCase
@Tag("expect-fail")
class NestedRecordLiteralViolated {
    var line: Line := Line { to = Point { x = 0 } }

    redefine tran {
        choice {
            line.from := Point { x = 0 }
        } or {
            assume(line.to.x < 2)
            line := Line { to = Point { x = line.to.x + 1, y = line.from.x } }
        }
    }

    prop {
        return AG line.to.y == 0
    }
}

@VerificationCase
@Tag("expect-fail")
class RecordParameterViolated {
    var point: Point := Point { x = 0 }
    var origin: Point := Point { x = 5 }

    tran moveTo(target: Point) {
        point := target
    }

    redefine tran {
        inline moveTo(origin)
    }

    prop {
        return AG point.x <= 1
    }
}
