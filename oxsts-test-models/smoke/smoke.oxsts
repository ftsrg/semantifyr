package semantifyr::verification::smoke

@VerificationCase
@Tag("expect-pass")
class CounterReachesThree {
    var x: int := 0

    redefine tran {
        if (x < 3) {
            x := x + 1
        }
    }

    prop {
        return EF x == 3
    }
}
