package semantifyr::constructs::record_trace_argument

record Point {
    var x: int := 0
}

class Port {
    var item: int := 0

    @Trace
    tran send(point: Point) {
        item := point.x
    }
}

class Host {
    contains port: Port

    redefine tran {
        inline port.send(Point { x = 1 })
    }
}
