package semantifyr::constructs::real_trace_argument

class Gauge {
    var reading: real := 0.0

    @Trace
    tran show(value: real) {
        reading := value
    }
}

class Host {
    contains gauge: Gauge
    var level: real := 0.5

    redefine tran {
        inline gauge.show(level)
    }
}
