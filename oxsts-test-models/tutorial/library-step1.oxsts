// A traffic light built on a small library of states.

package example::trafficlight::library::step1

class State {
    container parent: Statechart opposite states

    prop isActive(): bool {
        return parent.activeState == self
    }

    tran activate() {
        parent.activeState := self
    }
}

class Statechart {
    contains states: State[0..*] opposite parent

    var activeState: states[0..1] := nothing
}

class TrafficLight : Statechart {
    contains red: State subsets states
    contains yellow: State subsets states
    contains green: State subsets states

    redefine init {
        inline red.activate()
    }

    redefine tran {
        choice {
            assume(red.isActive())
            inline green.activate()
        } or {
            assume(green.isActive())
            inline yellow.activate()
        } or {
            assume(yellow.isActive())
            inline red.activate()
        }
    }
}

@VerificationCase
class LightCanTurnYellow {
    contains light: TrafficLight

    redefine init {
        inline light.init()
    }

    redefine tran {
        inline light.main()
    }

    prop {
        return EF light.yellow.isActive()
    }
}
