/**
 * A small statechart library of states, transitions and guards, and the junction with a crosswalk written as data on it.
 * A traffic light waits for any number of states, and the east light also waits for the pedestrians.
 */

abstract class Condition {
    abstract prop isActive(): bool
}

class Sensor : Condition {
    var detects: bool := false

    redefine prop isActive(): bool {
        return detects
    }
}

class State : Condition {
    container parent: Statechart opposite states

    redefine prop isActive(): bool {
        return parent.activeState == self
    }

    tran activate() {
        parent.activeState := self
    }
}

class Transition {
    refers from: State
    refers to: State
    refers guards: Condition[0..*]

    @Trace
    redefine tran {
        assume(from.isActive())
        inline for (guard in guards) {
            assume(guard.isActive())
        }
        inline to.activate()
    }
}

class Statechart {
    contains states: State[0..*] opposite parent
    contains transitions: Transition[0..*]
    refers initial: State

    var activeState: states[0..1] := nothing

    redefine init {
        inline initial.activate()
    }

    redefine tran {
        choice {
            inline for choice (transition in transitions) {
                inline transition.main()
            }
        } or {
        }
    }
}

class TrafficLight : Statechart {
    refers sensor: Sensor
    refers waitsFor: State[0..*]

    contains red: State subsets states
    contains yellow: State subsets states
    contains green: State subsets states

    redefine refers initial: State = red

    contains redToGreen: Transition subsets transitions {
        redefine refers from: State = red
        redefine refers to: State = green
        refers carWaiting: Condition subsets guards = sensor
        refers crossingClear: Condition[0..*] subsets guards = waitsFor
    }
    contains greenToYellow: Transition subsets transitions {
        redefine refers from: State = green
        redefine refers to: State = yellow
    }
    contains yellowToRed: Transition subsets transitions {
        redefine refers from: State = yellow
        redefine refers to: State = red
    }
}

class PedestrianLight : Statechart {
    refers button: Sensor
    refers trafficStopped: State

    contains stop: State subsets states
    contains walk: State subsets states

    redefine refers initial: State = stop

    contains stopToWalk: Transition subsets transitions {
        redefine refers from: State = stop
        redefine refers to: State = walk
        refers pressed: Condition subsets guards = button
        refers trafficClear: Condition subsets guards = trafficStopped
    }
    contains walkToStop: Transition subsets transitions {
        redefine refers from: State = walk
        redefine refers to: State = stop
    }
}

class Junction {
    contains northSensor: Sensor
    contains eastSensor: Sensor
    contains pushButton: Sensor

    contains north: TrafficLight {
        redefine refers sensor: Sensor = northSensor
        refers eastStopped: State subsets waitsFor = east.red
    }
    contains east: TrafficLight {
        redefine refers sensor: Sensor = eastSensor
        refers northStopped: State subsets waitsFor = north.red
        refers pedestriansStopped: State subsets waitsFor = pedestrians.stop
    }
    contains pedestrians: PedestrianLight {
        redefine refers button: Sensor = pushButton
        redefine refers trafficStopped: State = east.red
    }

    redefine init {
        inline north.init()
        inline east.init()
        inline pedestrians.init()
    }

    redefine tran {
        havoc(northSensor.detects)
        havoc(eastSensor.detects)
        havoc(pushButton.detects)
        choice {
            inline north.main()
        } or {
            inline east.main()
        } or {
            inline pedestrians.main()
        }
    }
}

@VerificationCase
class NorthCanTurnGreen : Junction {
    prop {
        return EF north.green.isActive()
    }
}

@VerificationCase
class NeverBothGreen : Junction {
    prop {
        return AG !(north.green.isActive() && east.green.isActive())
    }
}

@VerificationCase
class NorthGreenOnlyWhileEastRed : Junction {
    prop {
        return AG (!north.green.isActive() || east.red.isActive())
    }
}

@VerificationCase
class PedestriansCanWalk : Junction {
    prop {
        return EF pedestrians.walk.isActive()
    }
}

@VerificationCase
class WalkOnlyWhileEastRed : Junction {
    prop {
        return AG (!pedestrians.walk.isActive() || east.red.isActive())
    }
}
