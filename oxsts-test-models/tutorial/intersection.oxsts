// Two traffic lights at an intersection, where one light switches in each step.
// A light switches only while the other is red.

package example::trafficlight::intersection

enum LightColor {
    Red,
    Yellow,
    Green,
}

class TrafficLight {
    var color: LightColor := LightColor::Red

    @Trace
    redefine tran {
        choice {
            assume(color == LightColor::Red)
            color := LightColor::Green
        } or {
            assume(color == LightColor::Green)
            color := LightColor::Yellow
        } or {
            assume(color == LightColor::Yellow)
            color := LightColor::Red
        }
    }

    prop isColor(color: LightColor): bool {
        return self.color == color
    }
}

class Intersection {
    contains north: TrafficLight
    contains east: TrafficLight

    redefine tran {
        choice {
            assume(east.isColor(LightColor::Red))
            inline north.main()
        } or {
            assume(north.isColor(LightColor::Red))
            inline east.main()
        }
    }
}

@VerificationCase
class NeverBothGreen {
    contains intersection: Intersection

    redefine tran {
        inline intersection.main()
    }

    prop {
        return AG !(intersection.north.isColor(LightColor::Green) && intersection.east.isColor(LightColor::Green))
    }
}

@VerificationCase
class EastCanTurnGreen {
    contains intersection: Intersection

    redefine tran {
        inline intersection.main()
    }

    prop {
        return EF intersection.east.isColor(LightColor::Green)
    }
}

@VerificationCase
class NorthGreenOnlyWhileEastRed {
    contains intersection: Intersection

    redefine tran {
        inline intersection.main()
    }

    prop {
        return AG (!intersection.north.isColor(LightColor::Green) || intersection.east.isColor(LightColor::Red))
    }
}
