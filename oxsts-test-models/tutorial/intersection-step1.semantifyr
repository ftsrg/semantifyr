/**
 * One traffic light that switches between red and green.
 */

package example::trafficlight::intersection::step1

enum LightColor {
    Red,
    Green,
}

class TrafficLight {
    var color: LightColor := LightColor::Red

    redefine tran {
        choice {
            assume(color == LightColor::Red)
            color := LightColor::Green
        } or {
            assume(color == LightColor::Green)
            color := LightColor::Red
        }
    }
}

@VerificationCase
class LightCanTurnGreen : TrafficLight {
    prop {
        return EF (color == LightColor::Green)
    }
}
