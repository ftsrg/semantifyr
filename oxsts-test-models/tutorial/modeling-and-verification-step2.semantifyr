/**
 * A traffic light that goes from red to green, yellow and red again, and turns green only for a waiting car.
 */

enum LightColor {
    Red,
    Yellow,
    Green,
}

class TrafficLight {
    var color: LightColor := LightColor::Red
    var carWaiting: bool := false

    redefine tran {
        havoc(carWaiting)
        choice {
            assume(color == LightColor::Red && carWaiting)
            color := LightColor::Green
        } or {
            assume(color == LightColor::Green)
            color := LightColor::Yellow
        } or {
            assume(color == LightColor::Yellow)
            color := LightColor::Red
        } or {
        }
    }
}

@VerificationCase
class LightCanTurnGreen : TrafficLight {
    prop {
        return EF (color == LightColor::Green)
    }
}

@VerificationCase
class LightCanTurnYellow : TrafficLight {
    prop {
        return EF (color == LightColor::Yellow)
    }
}
