/**
 * A junction of two roads, each with a traffic light and a sensor for waiting cars, modelled directly in one class.
 * A light turns green only while the other one is not green.
 */

enum LightColor {
    Red,
    Yellow,
    Green,
}

class Junction {
    var north: LightColor := LightColor::Red
    var east: LightColor := LightColor::Red
    var northCarWaiting: bool := false
    var eastCarWaiting: bool := false

    redefine tran {
        havoc(northCarWaiting)
        havoc(eastCarWaiting)
        choice {
            assume(north == LightColor::Red && northCarWaiting && east != LightColor::Green)
            north := LightColor::Green
        } or {
            assume(north == LightColor::Green)
            north := LightColor::Yellow
        } or {
            assume(north == LightColor::Yellow)
            north := LightColor::Red
        } or {
            assume(east == LightColor::Red && eastCarWaiting && north != LightColor::Green)
            east := LightColor::Green
        } or {
            assume(east == LightColor::Green)
            east := LightColor::Yellow
        } or {
            assume(east == LightColor::Yellow)
            east := LightColor::Red
        } or {
        }
    }
}

@VerificationCase
class NorthCanTurnGreen : Junction {
    prop {
        return EF (north == LightColor::Green)
    }
}

@VerificationCase
class NeverBothGreen : Junction {
    prop {
        return AG !(north == LightColor::Green && east == LightColor::Green)
    }
}

@VerificationCase
class NorthGreenOnlyWhileEastRed : Junction {
    prop {
        return AG (north != LightColor::Green || east == LightColor::Red)
    }
}
