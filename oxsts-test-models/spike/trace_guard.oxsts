package semantifyr::spike::traceguard

@VerificationCase
@Tag("expect-pass")
class TracedCallUnderUnobservedGuard {
    var phase: int := 0
    var count: int := 0

    @Trace
    tran firstStep() {
    }

    @Trace
    tran laterStep() {
    }

    redefine tran {
        if (phase == 0) {
            inline firstStep()
        }
        if (phase == 1) {
            inline laterStep()
        }
        phase := 1
        count := count + 1
    }

    prop {
        return EF count == 3
    }
}
