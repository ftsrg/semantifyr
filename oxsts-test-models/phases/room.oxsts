package room

class Fuse {
    var ok: bool := true
}

class Lamp {
    @Shared
    contains fuse: Fuse

    var on: bool := false

    tran toggle() {
        assume(fuse.ok)
        on := !on
    }

    prop isOn(): bool {
        return on
    }
}

class Spot : Lamp {
    redefine tran toggle() {
        assume(fuse.ok)
        on := true
    }
}

class Room {
    contains left: Lamp
    contains right: Lamp

    var lastToggled: Lamp[0..1] := nothing

    redefine tran {
        inline left.toggle()
        inline right.toggle()
        lastToggled := right
    }
}

class Hall : Room {
    redefine contains right: Spot
}

@VerificationCase
class BothLampsCanBeOn {
    contains hall: Hall

    redefine tran {
        inline hall.main()
    }

    prop {
        return EF hall.left.isOn() && hall.right.isOn()
    }
}
