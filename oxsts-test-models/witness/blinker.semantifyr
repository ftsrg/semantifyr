package example::blinker

class Blinker {
    var on: bool := false
    var since: clock := 0

    redefine tran {
        assume (since <= 5)
        assume (since >= 2)
        on := !on
        since := 0
    }
}

@VerificationCase
class BlinkerSwitchesBetweenTwoAndThree {
    contains blinker: Blinker
    var running: clock := 0
    var switchedBetween: bool := false

    redefine tran {
        inline blinker.main()
        if (running > 2 && running < 3) {
            switchedBetween := true
        }
    }

    redefine prop {
        return EF (switchedBetween)
    }
}
