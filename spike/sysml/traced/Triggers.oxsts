package semantifyr::sysml::triggers

import semantifyr::sysml::attributes
import semantifyr::sysml::expressions
import semantifyr::sysml::ports
import semantifyr::sysml::items
import semantifyr::sysml::actions

abstract class AcceptAction {
    prop isTriggered(): bool {
        return true // should be abstract, but no good way to specify defaults atm
    }

    tran passTime(elapsedTime: int) {
    }

    tran assumeIsTriggered() {
        assume(isTriggered())
    }

    tran initialize() {
    }

    tran consume() {
    }

    tran requireConsumption() {
        assume(false)
    }
}

class AcceptItemAction : AcceptAction {
    refers viaPort: Port
    refers payload: Item

    redefine prop isTriggered(): bool {
        return viaPort.canConsume(payload)
    }

    redefine tran consume() {
        inline viaPort.consumeIncomingItem()
    }

    redefine tran requireConsumption() {
        inline viaPort.requireConsumption()
    }
}

class AcceptTimeoutAction : AcceptAction {
    refers afterTime: int = 1

    var remainingTime: int := 0

    redefine tran passTime(elapsedTime: int) {
        if (remainingTime > 0) {
            remainingTime := remainingTime - elapsedTime
        }
    }

    redefine prop isTriggered(): bool {
        return remainingTime <= 0
    }

    redefine tran initialize() {
        remainingTime := afterTime
    }
}

class AcceptWhenAction : AcceptAction {
    contains expression: Expression

    redefine prop isTriggered(): bool {
        return expression.evaluate() as bool
    }
}
