@VerificationCase
class ReachableRedRed : GammaVerificationCase {
    contains system: CrossroadSystem redefines component
    redefine contains propertyExpression: Eventually {
        redefine contains body: AndOperatorExpression {
            redefine contains left: IsStateActiveExpression {
                redefine refers state: State = system.trafficLightA.Main.Normal.NormalRegion.Red
            }
            redefine contains right: IsStateActiveExpression {
                redefine refers state: State = system.trafficLightB.Main.Normal.NormalRegion.Red
            }
        }
    }
}
