package test::machine

import library::control

statechart Machine [
    port Control : provides Control
] {
    region Main {
        initial MainInitial
        state Idle
        state Busy
    }
    transition from MainInitial to Idle
    transition from Idle to Busy when Control.start
}

verification case BusyReachable of Machine {
    EF state Main.Busy
}
