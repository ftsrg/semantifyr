package test

interface Control {
    out event done
}

statechart Machine [
    port control : provides Control
] {
    var count : integer := 0
    region Main {
        initial MainInitial
        state Idle {
            entry / count := 1;
            exit / raise control.done;
        }
    }
    transition from MainInitial to Idle
}
