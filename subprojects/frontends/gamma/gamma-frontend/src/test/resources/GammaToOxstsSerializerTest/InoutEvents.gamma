package test

interface Duplex {
    inout event ping
}

statechart Caller [
    port line : provides Duplex
] {
    region Main {
        initial MainInitial
        state Idle
        state Calling
    }
    transition from MainInitial to Idle
    transition from Idle to Calling when line.ping / raise line.ping;
}

statechart Callee [
    port line : requires Duplex
] {
    region Main {
        initial MainInitial
        state Idle
        state Calling
    }
    transition from MainInitial to Idle
    transition from Idle to Calling when line.ping / raise line.ping;
}
