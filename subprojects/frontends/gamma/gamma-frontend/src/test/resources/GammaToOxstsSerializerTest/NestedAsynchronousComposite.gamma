package test

interface Signals {
    in event first
}

statechart Receiver [
    port signals : provides Signals
] {
}

adapter Buffered of component receiver : Receiver {
    when any / run
    queue messages (priority = 1, capacity = 1) {
        signals.any
    }
}

async Inner {
    component buffered : Buffered
}

async Outer {
    component inner : Inner
}
