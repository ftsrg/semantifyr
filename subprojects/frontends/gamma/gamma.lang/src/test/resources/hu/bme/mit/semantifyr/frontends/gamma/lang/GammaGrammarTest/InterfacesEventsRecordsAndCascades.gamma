package test

type Point : record {
    x : integer,
    y : integer
}

interface Base {
    in persistent event moved(point : Point)
}

interface Extended extends Base {
    inout event ping
}

cascade System [
    port base : provides Base
] {
    component first : System
    component second : System
    execute second, first
}
