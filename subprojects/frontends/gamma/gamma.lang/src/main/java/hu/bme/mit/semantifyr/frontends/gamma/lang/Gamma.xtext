grammar hu.bme.mit.semantifyr.frontends.gamma.lang.Gamma with org.eclipse.xtext.common.Terminals

import "http://www.bme.hu/mit/2025/gamma"
import "http://www.eclipse.org/emf/2002/Ecore" as Ecore

GammaRoot:
    GammaModelPackage
    | ExecutionTrace
;

GammaModelPackage:
    'package' name=QualifiedName
    imports+=ImportStatement*
    (
        typeDeclarations+=TypeDeclaration
        | interfaces+=InterfaceDeclaration
        | components+=ComponentDeclaration
        | verificationCases+=VerificationCaseDeclaration
    )*
;

ImportStatement:
    'import' importedPackage=[GammaModelPackage|QualifiedName]
;

QualifiedName:
    ID ('::' ID)*
;

TypeDeclaration:
    'type' name=ID ':' type=Type
;

Type:
    IntegerType
    | BooleanType
    | RecordType
    | TypeReference
;

IntegerType:
    {IntegerType} 'integer'
;

BooleanType:
    {BooleanType} 'boolean'
;

RecordType:
    'record' '{' fields+=FieldDeclaration (',' fields+=FieldDeclaration)* '}'
;

TypeReference:
    reference=[TypeDeclaration]
;

FieldDeclaration:
    name=ID ':' type=Type
;

ParameterDeclaration:
    name=ID ':' type=Type
;

InterfaceDeclaration:
    'interface' name=ID ('extends' parents+=[InterfaceDeclaration] (',' parents+=[InterfaceDeclaration])*)? '{'
        events+=EventDeclaration*
    '}'
;

enum EventDirection:
    IN='in'
    | OUT='out'
    | INOUT='inout'
;

enum Persistency:
    TRANSIENT='transient'
    | PERSISTENT='persistent'
;

EventDeclaration:
    direction=EventDirection persistency=Persistency? 'event' name=ID
    ('(' parameters+=ParameterDeclaration (',' parameters+=ParameterDeclaration)* ')')?
;

ComponentDeclaration:
    SyncComponentDeclaration
    | CascadeComponentDeclaration
    | AsynchronousCompositeComponentDeclaration
    | ScheduledAsynchronousCompositeComponentDeclaration
    | AsynchronousAdapterDeclaration
    | StatechartDeclaration
;

SyncComponentDeclaration:
    'sync' name=ID ('(' ')')?
    ('[' (ports+=PortDeclaration (','? ports+=PortDeclaration)*)? ']')?
    '{'
        (
            components+=ComponentInstance
            | bindings+=PortBinding
            | channels+=Channel
        )*
    '}'
;

CascadeComponentDeclaration:
    'cascade' name=ID ('(' ')')?
    ('[' (ports+=PortDeclaration (','? ports+=PortDeclaration)*)? ']')?
    '{'
        (
            components+=ComponentInstance
            | bindings+=PortBinding
            | channels+=Channel
        )*
        ('execute' executionList+=[ComponentInstance] (',' executionList+=[ComponentInstance])*)?
    '}'
;

AsynchronousCompositeComponentDeclaration:
    'async' name=ID ('(' ')')?
    ('[' (ports+=PortDeclaration (','? ports+=PortDeclaration)*)? ']')?
    '{'
        (
            components+=ComponentInstance
            | bindings+=PortBinding
            | channels+=Channel
        )*
    '}'
;

ScheduledAsynchronousCompositeComponentDeclaration:
    'scheduled-async' name=ID ('(' ')')?
    ('[' (ports+=PortDeclaration (','? ports+=PortDeclaration)*)? ']')?
    '{'
        (
            components+=ComponentInstance
            | bindings+=PortBinding
            | channels+=Channel
        )*
        ('execute' executionList+=[ComponentInstance] (',' executionList+=[ComponentInstance])*)?
    '}'
;

AsynchronousAdapterDeclaration:
    'adapter' name=ID ('(' ')')?
    'of' wrappedComponent=ComponentInstance
    ('[' (ports+=PortDeclaration (','? ports+=PortDeclaration)*)? ']')?
    '{'
        (
            clocks+=ClockDeclaration
            | controlSpecifications+=ControlSpecification
            | messageQueues+=MessageQueue
        )*
    '}'
;

ClockDeclaration:
    'clock' name=ID '(' 'rate' '=' value=AdditiveExpression unit=TimeUnit ')'
;

enum ControlFunction:
    RUN_ONCE='run'
    | RUN_TO_COMPLETION='full-step'
    | RESET='reset'
    | RESET_MESSAGE_QUEUE='reset-queue'
    | RESET_MESSAGE_QUEUES='reset-queues'
    | RESET_OTHER_MESSAGE_QUEUES='reset-other-queues'
;

ControlSpecification:
    'when' trigger=ControlTrigger '/' controlFunction=ControlFunction
;

ControlTrigger:
    AnyTrigger
    | MessageTrigger
;

AnyTrigger:
    {AnyTrigger} 'any'
;

MessageTrigger:
    reference=MessageReference
;

enum DiscardStrategy:
    INCOMING='incoming'
    | OLDEST='oldest'
;

MessageQueue:
    'queue' name=ID '('
        'priority' '=' priority=INT
        ',' 'capacity' '=' capacity=Expression
        (',' 'discard' '=' discardStrategy=DiscardStrategy)?
    ')' '{'
        eventPassings+=EventPassing (',' eventPassings+=EventPassing)*
    '}'
;

EventPassing:
    source=MessageReference ('->' target=MessageReference)?
;

MessageReference:
    AnyPortEventReference
    | PortEventReference
    | ClockTickReference
;

AnyPortEventReference:
    => (port=[PortDeclaration] '.' 'any')
;

PortEventReference:
    => (port=[PortDeclaration] '.') event=[EventDeclaration]
;

ClockTickReference:
    clock=[ClockDeclaration]
;

ComponentInstance:
    'component' name=ID ':' component=[ComponentDeclaration]
;

enum RealizationMode:
    PROVIDED='provides'
    | REQUIRED='requires'
;

PortDeclaration:
    'port' name=ID ':' realizationMode=RealizationMode interface=[InterfaceDeclaration]
;

InstancePortReference:
    instance=[ComponentInstance] '.' port=[PortDeclaration]
;

PortBinding:
    'bind' port=[PortDeclaration] '->' boundPort=InstancePortReference
;

Channel:
    'channel' '[' providedPort=InstancePortReference ']' '-o)-' '[' requiredPort=InstancePortReference ']'
;

enum SchedulingOrder:
    TOP_DOWN='top-down'
    | BOTTOM_UP='bottom-up'
;

enum TransitionPriority:
    OFF='off'
    | ORDER_BASED='order-based'
    | VALUE_BASED='value-based'
;

enum GuardEvaluation:
    ON_THE_FLY='on-the-fly'
    | BEGINNING_OF_STEP='beginning-of-step'
;

StatechartDeclaration:
    asynchronous?='@Asynchronous'?
    (
        ('@RegionSchedule' '=' schedulingOrder=SchedulingOrder)?
        & ('@TransitionPriority' '=' transitionPriority=TransitionPriority)?
        & ('@GuardEvaluation' '=' guardEvaluation=GuardEvaluation)?
    )
    'statechart' name=ID ('capacity' '(' capacity=Expression ')')? ('(' ')')?
    ('[' (ports+=PortDeclaration (','? ports+=PortDeclaration)*)? ']')?
    '{'
        (
            variables+=VariableDeclaration
            | timeouts+=TimeoutDeclaration
        )*
        (
            regions+=Region
            | transitions+=Transition
        )*
    '}'
;

VariableDeclaration:
    'var' name=ID ':' type=Type (':=' default=Expression)?
;

TimeoutDeclaration:
    'timeout' name=ID
;

Region:
    'region' name=ID '{'
        stateNodes+=StateNode*
    '}'
;

StateNode:
    InitialState
    | ShallowHistoryState
    | State
;

InitialState:
    'initial' name=ID
;

ShallowHistoryState:
    'shallow' 'history' name=ID
;

State:
    'state' name=ID ('{'
        ('entry' '/' entryActions+=Action*)?
        ('exit' '/' exitActions+=Action*)?
        regions+=Region*
    '}')?
;

Transition:
    ('@' '(' name=ID ')')?
    'transition' ('(' priority=INT ')')?
    'from' from=[StateNode] 'to' to=[StateNode]
    ('when' trigger=Trigger)?
    ('[' guard=Expression ']')?
    ('/' actions+=Action*)?
;

Trigger:
    TimeoutTrigger
    | EventTrigger
;

TimeoutTrigger:
    'timeout' timeout=[TimeoutDeclaration]
;

EventTrigger:
    port=[PortDeclaration] '.' event=[EventDeclaration]
;

Action:
    Block
    | (
        RaiseEventAction
        | SetTimeoutAction
        | AssignmentAction
    ) ';'
;

Block:
    {Block} '{' actions+=Action* '}'
;

RaiseEventAction:
    'raise' port=[PortDeclaration] '.' event=[EventDeclaration]
    ('(' (arguments+=Expression (',' arguments+=Expression)*)? ')')?
;

enum TimeUnit:
    MILLISECOND='ms'
    | SECOND='s'
;

SetTimeoutAction:
    'set' timeout=[TimeoutDeclaration] ':=' value=AdditiveExpression unit=TimeUnit
;

AssignmentAction:
    reference=AssignableExpression ':=' expression=Expression
;

AssignableExpression returns Expression:
    DirectReferenceExpression ({RecordAccessExpression.operand=current} '.' field=[FieldDeclaration])*
;

VerificationCaseDeclaration:
    'verification' 'case' name=ID 'of' component=[ComponentDeclaration] '{'
        expression=PropertyExpression
    '}'
;

ExecutionTrace:
    imports+=ImportStatement*
    'trace' name=ID 'of' verificationCase=[VerificationCaseDeclaration]
    steps+=Step*
;

Step:
    {Step} 'step' '{'
        ('act' '{' acts+=Act+ '}')?
        'assert' '{' (asserts+=Expression ';')* '}'
    '}'
;

Act:
    ResetAct
    | ScheduleAct
    | TimeElapseAct
    | RaiseEventAct
;

ResetAct:
    {ResetAct} 'reset'
;

ScheduleAct:
    {ScheduleAct} 'schedule' 'component'
;

TimeElapseAct:
    'elapse' time=INT
;

RaiseEventAct:
    'raise'
    (
        => (instance=ComponentInstanceReference '.' port=[PortDeclaration] '.' event=[EventDeclaration])
        | port=[PortDeclaration] '.' event=[EventDeclaration]
    )
    ('(' (arguments+=Expression (',' arguments+=Expression)*)? ')')?
;

PropertyExpression returns Expression:
    TemporalOperator
    | Expression
;

TemporalOperator:
    AG
    | EF
;

AG:
    'AG' body=Expression
;

EF:
    'EF' body=Expression
;

Expression:
    OrExpression
;

enum OrOp returns BooleanOp:
    OR='or'
;

OrExpression returns Expression:
    AndExpression (
        {BooleanOperator.left=current} op=OrOp right=AndExpression
    )*
;

enum AndOp returns BooleanOp:
    AND='and'
;

AndExpression returns Expression:
    NotExpression (
        {BooleanOperator.left=current} op=AndOp right=NotExpression
    )*
;

NotExpression returns Expression:
    NegationOperator
    | EquivalenceExpression
;

NegationOperator:
    ('not' | '!') body=NotExpression
;

enum EquivalenceOp returns ComparisonOp:
    EQ='='
    | EQ='=='
    | NOT_EQ='/='
    | NOT_EQ='!='
;

EquivalenceExpression returns Expression:
    RelationalExpression (
        {ComparisonOperator.left=current} op=EquivalenceOp right=RelationalExpression
    )?
;

enum RelationalOp returns ComparisonOp:
    LESS='<'
    | LESS_EQ='<='
    | GREATER='>'
    | GREATER_EQ='>='
;

RelationalExpression returns Expression:
    AdditiveExpression (
        {ComparisonOperator.left=current} op=RelationalOp right=AdditiveExpression
    )*
;

enum AdditiveOp returns ArithmeticOp:
    ADD='+'
    | SUB='-'
;

AdditiveExpression returns Expression:
    MultiplicativeExpression (
        {ArithmeticBinaryOperator.left=current} op=AdditiveOp right=MultiplicativeExpression
    )*
;

enum MultiplicativeOp returns ArithmeticOp:
    MUL='*'
    | DIV='/'
;

MultiplicativeExpression returns Expression:
    UnaryExpression (
        {ArithmeticBinaryOperator.left=current} op=MultiplicativeOp right=UnaryExpression
    )*
;

UnaryExpression returns Expression:
    ArithmeticUnaryOperator
    | AccessExpression
;

enum UnaryOp:
    PLUS='+'
    | MINUS='-'
;

ArithmeticUnaryOperator:
    op=UnaryOp body=UnaryExpression
;

AccessExpression returns Expression:
    PrimaryExpression (
        {RecordAccessExpression.operand=current} '.' field=[FieldDeclaration]
    )*
;

PrimaryExpression returns Expression:
    LiteralExpression
    | RecordLiteralExpression
    | EventParameterReferenceExpression
    | DirectReferenceExpression
    | StateReferenceExpression
    | VariableReferenceExpression
    | FiredTransitionExpression
    | RaiseEventAct
    | '(' Expression ')'
;

RecordLiteralExpression:
    '#' typeDeclaration=[TypeDeclaration] '{' fieldAssignments+=FieldAssignment (',' fieldAssignments+=FieldAssignment)* '}'
;

FieldAssignment:
    field=[FieldDeclaration] ':=' value=Expression
;

EventParameterReferenceExpression:
    => (port=[PortDeclaration] '.' event=[EventDeclaration] '::') parameter=[ParameterDeclaration]
;

DirectReferenceExpression:
    declaration=[ValueDeclaration]
;

ComponentInstanceReference:
    instance=[ComponentInstance] ('->' child=ComponentInstanceReference)?
;

StateReferenceExpression:
    'state'
    (
        => (instance=ComponentInstanceReference '.' region=[Region] '.' state=[State])
        | region=[Region] '.' state=[State]
    )
;

VariableReferenceExpression:
    'variable'
    (
        => (instance=ComponentInstanceReference '.' variable=[VariableDeclaration])
        | variable=[VariableDeclaration]
    )
;

FiredTransitionExpression:
    'transition'
    (
        => (
            instance=ComponentInstanceReference
            (
                '.' transition=[Transition]
                | 'from' from=[State] 'to' to=[State] ('when' trigger=Trigger)?
            )
        )
        | transition=[Transition]
        | 'from' from=[State] 'to' to=[State] ('when' trigger=Trigger)?
    )
;

LiteralExpression:
    LiteralBoolean
    | LiteralInteger
;

LiteralBoolean:
    value=BooleanValue
;

LiteralInteger:
    value=INT
;

BooleanValue returns Ecore::EBoolean:
    'true'
    | 'false'
;
