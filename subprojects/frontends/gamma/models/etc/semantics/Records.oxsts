package gamma::library::semantics

import semantifyr::gamma::expressions
import semantifyr::gamma::variables
import semantifyr::gamma::statecharts
import semantifyr::gamma::triggers
import semantifyr::gamma::actions
import semantifyr::gamma::events
import semantifyr::gamma::ports

record Point {
    var x: int := 0
    var y: int := 0
}

record Box {
    var corner: Point := Point { x = 0 }
    var open: bool := false
}

class PointParameter : Parameter {
    var value: Point := Point { x = 0 }

    redefine prop evaluate(): Point {
        return value
    }

    redefine tran set(value: Point) {
        self.value := value
    }

    redefine tran reset() {
        value := Point { x = 0 }
    }

    redefine tran havoc() {
        havoc(value)
    }
}

class PointVariable : Variable {
    refers defaultX: int = 0
    refers defaultY: int = 0

    var variable: Point := Point { x = defaultX, y = defaultY }

    redefine prop evaluate(): Point {
        return variable
    }

    redefine tran set(value: Point) {
        variable := value
    }
}

class BoxVariable : Variable {
    var variable: Box := Box { open = false }

    redefine prop evaluate(): Box {
        return variable
    }

    redefine tran set(value: Box) {
        variable := value
    }
}

class PointXAccess : FieldAccessExpression {
    redefine prop evaluate(): any {
        return (operand.evaluate() as Point).x
    }

    redefine prop updated(original: any, value: any): any {
        return Point { x = value as int, y = (original as Point).y }
    }
}

class PointYAccess : FieldAccessExpression {
    redefine prop evaluate(): any {
        return (operand.evaluate() as Point).y
    }

    redefine prop updated(original: any, value: any): any {
        return Point { x = (original as Point).x, y = value as int }
    }
}

class BoxCornerAccess : FieldAccessExpression {
    redefine prop evaluate(): any {
        return (operand.evaluate() as Box).corner
    }

    redefine prop updated(original: any, value: any): any {
        return Box { corner = value as Point, open = (original as Box).open }
    }
}

class BoxOpenAccess : FieldAccessExpression {
    redefine prop evaluate(): any {
        return (operand.evaluate() as Box).open
    }

    redefine prop updated(original: any, value: any): any {
        return Box { corner = (original as Box).corner, open = value as bool }
    }
}

class Positions : Interface {
    contains moved: Event subsets inputEvents {
        @Shared
        redefine contains declaration: EventDeclaration
        contains position: PointParameter subsets parameters {
            @Shared
            redefine contains declaration: ParameterDeclaration
        }
    }
}

class Tracker : Statechart {
    contains positions: ProvidedPort subsets ports {
        redefine contains interface: Positions
    }

    contains lastX: IntegerVariable subsets variables

    contains Main: Region subsets regions {
        contains Waiting: State subsets states
        contains Far: State subsets states

        contains entryToWaiting: EntryTransition subsets entryTransitions {
            redefine refers to: State = Waiting
        }
        contains waitingToFar: Transition subsets transitions {
            redefine refers from: State = Waiting
            redefine refers to: State = Far
            redefine contains trigger: EventTrigger {
                redefine refers port: Port = positions
                redefine refers event: Event = positions.interface.moved
            }
            redefine contains guard: Guard {
                redefine contains expression: GreaterThanOperatorExpression {
                    redefine contains left: PointXAccess {
                        redefine contains operand: ParameterExpression {
                            redefine refers parameter: Parameter = positions.interface.moved.position
                        }
                    }
                    redefine contains right: LiteralIntegerExpression {
                        redefine refers value: int = 5
                    }
                }
            }
            contains keepX: AssignmentAction subsets actions {
                redefine refers variable: Variable = lastX
                redefine contains expression: PointXAccess {
                    redefine contains operand: ParameterExpression {
                        redefine refers parameter: Parameter = positions.interface.moved.position
                    }
                }
            }
        }
    }
}

@VerificationCase
@Tag("expect-pass")
class RecordParameterFieldReachesAVariable : LibraryCase {
    contains machine: Tracker redefines component

    redefine prop {
        return EF (machine.Main.Far.isActive() && machine.lastX.variable == 7)
    }
}

@VerificationCase
@Tag("expect-fail")
class RecordParameterFieldGuardBlocksSmallValueUnreachable : LibraryCase {
    contains machine: Tracker redefines component

    redefine prop {
        return EF (machine.Main.Far.isActive() && machine.lastX.variable == 3)
    }
}

class Plotter : Statechart {
    contains control: ProvidedPort subsets ports {
        redefine contains interface: Control
    }

    contains position: PointVariable subsets variables {
        redefine refers defaultX: int = 3
    }
    contains copy: PointVariable subsets variables
    contains box: BoxVariable subsets variables

    contains Main: Region subsets regions {
        contains Start: State subsets states
        contains Middle: State subsets states
        contains Done: State subsets states

        contains entryToStart: EntryTransition subsets entryTransitions {
            redefine refers to: State = Start
        }
        contains startToMiddle: Transition subsets transitions {
            redefine refers from: State = Start
            redefine refers to: State = Middle
            redefine contains trigger: EventTrigger {
                redefine refers port: Port = control
                redefine refers event: Event = control.interface.start
            }
            contains setY: AssignmentAction subsets actions {
                redefine refers variable: Variable = position
                redefine contains expression: FieldUpdateExpression {
                    redefine contains field: PointYAccess {
                        redefine contains operand: VariableExpression {
                            redefine refers variable: Variable = position
                        }
                    }
                    redefine contains value: LiteralIntegerExpression {
                        redefine refers value: int = 2
                    }
                }
            }
            contains setCornerX: AssignmentAction subsets actions {
                redefine refers variable: Variable = box
                redefine contains expression: FieldUpdateExpression {
                    redefine contains field: BoxCornerAccess {
                        redefine contains operand: VariableExpression {
                            redefine refers variable: Variable = box
                        }
                    }
                    redefine contains value: FieldUpdateExpression {
                        redefine contains field: PointXAccess {
                            redefine contains operand: BoxCornerAccess {
                                redefine contains operand: VariableExpression {
                                    redefine refers variable: Variable = box
                                }
                            }
                        }
                        redefine contains value: LiteralIntegerExpression {
                            redefine refers value: int = 5
                        }
                    }
                }
            }
        }
        contains middleToDone: Transition subsets transitions {
            redefine refers from: State = Middle
            redefine refers to: State = Done
            redefine contains trigger: EventTrigger {
                redefine refers port: Port = control
                redefine refers event: Event = control.interface.start
            }
            redefine contains guard: Guard {
                redefine contains expression: GreaterThanOperatorExpression {
                    redefine contains left: PointXAccess {
                        redefine contains operand: BoxCornerAccess {
                            redefine contains operand: VariableExpression {
                                redefine refers variable: Variable = box
                            }
                        }
                    }
                    redefine contains right: LiteralIntegerExpression {
                        redefine refers value: int = 4
                    }
                }
            }
            contains setX: AssignmentAction subsets actions {
                redefine refers variable: Variable = position
                redefine contains expression: FieldUpdateExpression {
                    redefine contains field: PointXAccess {
                        redefine contains operand: VariableExpression {
                            redefine refers variable: Variable = position
                        }
                    }
                    redefine contains value: LiteralIntegerExpression {
                        redefine refers value: int = 4
                    }
                }
            }
            contains copyPosition: AssignmentAction subsets actions {
                redefine refers variable: Variable = copy
                redefine contains expression: VariableExpression {
                    redefine refers variable: Variable = position
                }
            }
            contains openBox: AssignmentAction subsets actions {
                redefine refers variable: Variable = box
                redefine contains expression: FieldUpdateExpression {
                    redefine contains field: BoxOpenAccess {
                        redefine contains operand: VariableExpression {
                            redefine refers variable: Variable = box
                        }
                    }
                    redefine contains value: LiteralBooleanExpression {
                        redefine refers value: bool = true
                    }
                }
            }
        }
    }
}

@VerificationCase
@Tag("expect-pass")
class RecordVariableFieldAndWholeRecordAssignment : LibraryCase {
    contains machine: Plotter redefines component

    redefine prop {
        return AG (!machine.Main.Done.isActive() || (machine.copy.variable.x == 4 && machine.copy.variable.y == 2))
    }
}

@VerificationCase
@Tag("expect-pass")
class NestedRecordFieldAssignmentKeepsTheOtherFields : LibraryCase {
    contains machine: Plotter redefines component

    redefine prop {
        return AG (!machine.Main.Done.isActive() || (machine.box.variable.corner.x == 5 && machine.box.variable.corner.y == 0 && machine.box.variable.open))
    }
}

@VerificationCase
@Tag("expect-pass")
class RecordVariableAssignmentsReachTheEnd : LibraryCase {
    contains machine: Plotter redefines component

    redefine prop {
        return EF machine.Main.Done.isActive()
    }
}

@VerificationCase
@Tag("expect-pass")
class RecordVariableStartsFromItsInitializer : LibraryCase {
    contains machine: Plotter redefines component

    redefine prop {
        return AG (!machine.Main.Middle.isActive() || (machine.position.variable.x == 3 && machine.position.variable.y == 2))
    }
}
