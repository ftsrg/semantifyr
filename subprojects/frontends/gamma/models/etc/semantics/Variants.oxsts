package gamma::library::semantics

import semantifyr::gamma::expressions
import semantifyr::gamma::variables
import semantifyr::gamma::statecharts
import semantifyr::gamma::triggers
import semantifyr::gamma::actions
import semantifyr::gamma::events
import semantifyr::gamma::ports

class Layered : Statechart {
    contains control: ProvidedPort subsets ports {
        redefine contains interface: Control
    }

    contains Main: Region subsets regions {
        contains Parent: State subsets states {
            contains Inner: Region subsets regions {
                contains First: State subsets states
                contains Second: State subsets states

                contains entryToFirst: EntryTransition subsets entryTransitions {
                    redefine refers to: State = First
                }
                contains firstToSecond: Transition subsets transitions {
                    redefine refers from: State = First
                    redefine refers to: State = Second
                    redefine contains trigger: EventTrigger {
                        redefine refers port: Port = control
                        redefine refers event: Event = control.interface.start
                    }
                }
            }
        }
        contains Outside: State subsets states

        contains entryToParent: EntryTransition subsets entryTransitions {
            redefine refers to: State = Parent
        }
        contains parentToOutside: Transition subsets transitions {
            redefine refers from: State = Parent
            redefine refers to: State = Outside
            redefine contains trigger: EventTrigger {
                redefine refers port: Port = control
                redefine refers event: Event = control.interface.start
            }
        }
    }
}

class BottomUpLayered : Layered {
    redefine refers regionSchedule: RegionSchedule = RegionSchedule::BottomUp
}

@VerificationCase
@Tag("expect-fail")
class DefaultRegionScheduleTopDownInnerUnreachable : LibraryCase {
    contains machine: Layered redefines component

    redefine prop {
        return EF machine.Main.Parent.Inner.Second.isActive()
    }
}

@VerificationCase
@Tag("expect-pass")
class BottomUpRegionScheduleFiresInnerFirst : LibraryCase {
    contains machine: BottomUpLayered redefines component

    redefine prop {
        return EF machine.Main.Parent.Inner.Second.isActive()
    }
}

class Choices : Statechart {
    contains control: ProvidedPort subsets ports {
        redefine contains interface: Control
    }

    contains Main: Region subsets regions {
        contains Idle: State subsets states
        contains First: State subsets states
        contains Second: State subsets states
        contains Third: State subsets states

        contains entryToIdle: EntryTransition subsets entryTransitions {
            redefine refers to: State = Idle
        }
        contains idleToFirst: Transition subsets transitions {
            redefine refers from: State = Idle
            redefine refers to: State = First
            redefine refers priority: int = 1
            redefine contains trigger: EventTrigger {
                redefine refers port: Port = control
                redefine refers event: Event = control.interface.start
            }
        }
        contains idleToSecond: Transition subsets transitions {
            redefine refers from: State = Idle
            redefine refers to: State = Second
            redefine refers priority: int = 1
            redefine contains trigger: EventTrigger {
                redefine refers port: Port = control
                redefine refers event: Event = control.interface.start
            }
        }
        contains idleToThird: Transition subsets transitions {
            redefine refers from: State = Idle
            redefine refers to: State = Third
            redefine contains trigger: EventTrigger {
                redefine refers port: Port = control
                redefine refers event: Event = control.interface.start
            }
        }
    }
}

class OrderedChoices : Choices {
    redefine refers transitionPriority: TransitionPriority = TransitionPriority::OrderBased
}

class ValuedChoices : Choices {
    redefine refers transitionPriority: TransitionPriority = TransitionPriority::ValueBased
}

@VerificationCase
@Tag("expect-pass")
class PriorityOffIgnoresWrittenPriorities : LibraryCase {
    contains machine: Choices redefines component

    redefine prop {
        return EF machine.Main.Third.isActive()
    }
}

@VerificationCase
@Tag("expect-pass")
class OrderBasedPriorityFiresTheFirstDeclared : LibraryCase {
    contains machine: OrderedChoices redefines component

    redefine prop {
        return EF machine.Main.First.isActive()
    }
}

@VerificationCase
@Tag("expect-fail")
class OrderBasedPriorityLaterDeclaredUnreachable : LibraryCase {
    contains machine: OrderedChoices redefines component

    redefine prop {
        return EF machine.Main.Second.isActive()
    }
}

@VerificationCase
@Tag("expect-pass")
class ValueBasedPriorityChoosesAmongTheHighest : LibraryCase {
    contains machine: ValuedChoices redefines component

    redefine prop {
        return EF machine.Main.Second.isActive()
    }
}

@VerificationCase
@Tag("expect-fail")
class ValueBasedPriorityLowerUnreachable : LibraryCase {
    contains machine: ValuedChoices redefines component

    redefine prop {
        return EF machine.Main.Third.isActive()
    }
}

class Handover : Statechart {
    contains control: ProvidedPort subsets ports {
        redefine contains interface: Control
    }

    contains handedOver: IntegerVariable subsets variables

    contains Giver: Region subsets regions {
        contains Giving: State subsets states
        contains Given: State subsets states
        contains Done: State subsets states

        contains entryToGiving: EntryTransition subsets entryTransitions {
            redefine refers to: State = Giving
        }
        contains givingToGiven: Transition subsets transitions {
            redefine refers from: State = Giving
            redefine refers to: State = Given
            redefine contains trigger: EventTrigger {
                redefine refers port: Port = control
                redefine refers event: Event = control.interface.start
            }
            contains handOver: AssignmentAction subsets actions {
                redefine refers variable: Variable = handedOver
                redefine contains expression: LiteralIntegerExpression {
                    redefine refers value: int = 1
                }
            }
        }
        contains givenToDone: Transition subsets transitions {
            redefine refers from: State = Given
            redefine refers to: State = Done
            redefine contains trigger: EventTrigger {
                redefine refers port: Port = control
                redefine refers event: Event = control.interface.start
            }
            contains takeBack: AssignmentAction subsets actions {
                redefine refers variable: Variable = handedOver
                redefine contains expression: LiteralIntegerExpression {
                    redefine refers value: int = 0
                }
            }
        }
    }

    contains Taker: Region subsets regions {
        contains Waiting: State subsets states
        contains Received: State subsets states

        contains entryToWaiting: EntryTransition subsets entryTransitions {
            redefine refers to: State = Waiting
        }
        contains waitingToReceived: Transition subsets transitions {
            redefine refers from: State = Waiting
            redefine refers to: State = Received
            redefine contains trigger: EventTrigger {
                redefine refers port: Port = control
                redefine refers event: Event = control.interface.start
            }
            redefine contains guard: Guard {
                redefine contains expression: EqualityOperatorExpression {
                    redefine contains left: VariableExpression {
                        redefine refers variable: Variable = handedOver
                    }
                    redefine contains right: LiteralIntegerExpression {
                        redefine refers value: int = 1
                    }
                }
            }
        }
    }
}

class BeginningOfStepHandover : Handover {
    redefine refers guardEvaluation: GuardEvaluation = GuardEvaluation::BeginningOfStep
}

@VerificationCase
@Tag("expect-pass")
class OnTheFlyGuardSeesAnEarlierRegionsWrite : LibraryCase {
    contains machine: Handover redefines component

    redefine prop {
        return EF (machine.Giver.Given.isActive() && machine.Taker.Received.isActive())
    }
}

@VerificationCase
@Tag("expect-fail")
class BeginningOfStepGuardIgnoresAnEarlierRegionsWriteUnreachable : LibraryCase {
    contains machine: BeginningOfStepHandover redefines component

    redefine prop {
        return EF (machine.Giver.Given.isActive() && machine.Taker.Received.isActive())
    }
}
