package gamma::library::semantics

import semantifyr::gamma::expressions
import semantifyr::gamma::variables
import semantifyr::gamma::statecharts
import semantifyr::gamma::triggers
import semantifyr::gamma::actions
import semantifyr::gamma::events
import semantifyr::gamma::ports

class ExitOrder : Statechart {
    contains control: ProvidedPort subsets ports {
        redefine contains interface: Control
    }

    contains lastExit: IntegerVariable subsets variables

    contains Main: Region subsets regions {
        contains Parent: State subsets states {
            contains exitParent: AssignmentAction subsets exitActions {
                redefine refers variable: Variable = lastExit
                redefine contains expression: LiteralIntegerExpression {
                    redefine refers value: int = 2
                }
            }

            contains Inner: Region subsets regions {
                contains Child: State subsets states {
                    contains exitChild: AssignmentAction subsets exitActions {
                        redefine refers variable: Variable = lastExit
                        redefine contains expression: LiteralIntegerExpression {
                            redefine refers value: int = 1
                        }
                    }
                }

                contains entryToChild: EntryTransition subsets entryTransitions {
                    redefine refers to: State = Child
                }
            }
        }
        contains Left: State subsets states

        contains entryToParent: EntryTransition subsets entryTransitions {
            redefine refers to: State = Parent
        }
        contains parentToLeft: Transition subsets transitions {
            redefine refers from: State = Parent
            redefine refers to: State = Left
            redefine contains trigger: EventTrigger {
                redefine refers port: Port = control
                redefine refers event: Event = control.interface.start
            }
        }
    }
}

@VerificationCase
@Tag("expect-pass")
class ChildrenExitBeforeTheirParent : LibraryCase {
    contains machine: ExitOrder redefines component

    redefine prop {
        return AG (!machine.Main.Left.isActive() || machine.lastExit.variable == 2)
    }
}

class CrossLevel : Statechart {
    contains control: ProvidedPort subsets ports {
        redefine contains interface: Control
    }

    contains parentExits: IntegerVariable subsets variables
    contains siblingEntries: IntegerVariable subsets variables
    contains siblingExits: IntegerVariable subsets variables

    contains Main: Region subsets regions {
        contains Parent: State subsets states {
            contains exitParent: AssignmentAction subsets exitActions {
                redefine refers variable: Variable = parentExits
                redefine contains expression: PlusOperatorExpression {
                    redefine contains left: VariableExpression {
                        redefine refers variable: Variable = parentExits
                    }
                    redefine contains right: LiteralIntegerExpression {
                        redefine refers value: int = 1
                    }
                }
            }

            contains Left: Region subsets regions {
                contains First: State subsets states
                contains Second: State subsets states

                contains entryToFirst: EntryTransition subsets entryTransitions {
                    redefine refers to: State = First
                }
                contains firstToOutside: Transition subsets transitions {
                    redefine refers from: State = First
                    redefine refers to: State = Outside
                    redefine contains trigger: EventTrigger {
                        redefine refers port: Port = control
                        redefine refers event: Event = control.interface.stop
                    }
                }
            }

            contains Right: Region subsets regions {
                contains Sibling: State subsets states {
                    contains enterSibling: AssignmentAction subsets entryActions {
                        redefine refers variable: Variable = siblingEntries
                        redefine contains expression: PlusOperatorExpression {
                            redefine contains left: VariableExpression {
                                redefine refers variable: Variable = siblingEntries
                            }
                            redefine contains right: LiteralIntegerExpression {
                                redefine refers value: int = 1
                            }
                        }
                    }
                    contains exitSibling: AssignmentAction subsets exitActions {
                        redefine refers variable: Variable = siblingExits
                        redefine contains expression: PlusOperatorExpression {
                            redefine contains left: VariableExpression {
                                redefine refers variable: Variable = siblingExits
                            }
                            redefine contains right: LiteralIntegerExpression {
                                redefine refers value: int = 1
                            }
                        }
                    }
                }

                contains entryToSibling: EntryTransition subsets entryTransitions {
                    redefine refers to: State = Sibling
                }
            }
        }
        contains Outside: State subsets states

        contains entryToParent: EntryTransition subsets entryTransitions {
            redefine refers to: State = Parent
        }
        contains outsideToSecond: Transition subsets transitions {
            redefine refers from: State = Outside
            redefine refers to: State = Parent.Left.Second
            redefine contains trigger: EventTrigger {
                redefine refers port: Port = control
                redefine refers event: Event = control.interface.start
            }
        }
    }
}

@VerificationCase
@Tag("expect-pass")
class LeavingAStateExitsItsAncestorsUpToTheCommonRegion : LibraryCase {
    contains machine: CrossLevel redefines component

    redefine prop {
        return AG (!machine.Main.Outside.isActive() || machine.parentExits.variable == 1)
    }
}

@VerificationCase
@Tag("expect-pass")
class LeavingAnAncestorExitsItsOtherRegions : LibraryCase {
    contains machine: CrossLevel redefines component

    redefine prop {
        return AG (!machine.Main.Outside.isActive() || (!machine.Main.Parent.Right.Sibling.isActive() && machine.siblingExits.variable == 1))
    }
}

@VerificationCase
@Tag("expect-pass")
class EnteringAnAncestorEntersItsOtherRegions : LibraryCase {
    contains machine: CrossLevel redefines component

    redefine prop {
        return EF (machine.Main.Parent.Left.Second.isActive() && machine.Main.Parent.Right.Sibling.isActive() && machine.siblingEntries.variable == 2)
    }
}
