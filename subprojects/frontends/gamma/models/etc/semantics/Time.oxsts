package gamma::library::semantics

import semantifyr::gamma::expressions
import semantifyr::gamma::variables
import semantifyr::gamma::statecharts
import semantifyr::gamma::triggers
import semantifyr::gamma::actions
import semantifyr::gamma::events

class TimedStart : Statechart {
    contains delay: Timeout subsets timeouts
    contains steps: IntegerVariable subsets variables

    contains Counter: Region subsets regions {
        contains Counting: State subsets states

        contains entryToCounting: EntryTransition subsets entryTransitions {
            redefine refers to: State = Counting
        }
        contains countingToCounting: Transition subsets transitions {
            redefine refers from: State = Counting
            redefine refers to: State = Counting
            redefine contains trigger: AlwaysTrigger
            redefine contains guard: Guard {
                redefine contains expression: LessThanOperatorExpression {
                    redefine contains left: VariableExpression {
                        redefine refers variable: Variable = steps
                    }
                    redefine contains right: LiteralIntegerExpression {
                        redefine refers value: int = 4
                    }
                }
            }
            contains countStep: AssignmentAction subsets actions {
                redefine refers variable: Variable = steps
                redefine contains expression: PlusOperatorExpression {
                    redefine contains left: VariableExpression {
                        redefine refers variable: Variable = steps
                    }
                    redefine contains right: LiteralIntegerExpression {
                        redefine refers value: int = 1
                    }
                }
            }
        }
    }

    contains Main: Region subsets regions {
        contains Waiting: State subsets states {
            contains setDelay: SetTimeoutAction subsets entryActions {
                redefine refers timeout: Timeout = delay
                redefine contains expression: LiteralIntegerExpression {
                    redefine refers value: int = 2
                }
            }
        }
        contains Done: State subsets states
        contains StillUp: State subsets states

        contains entryToWaiting: EntryTransition subsets entryTransitions {
            redefine refers to: State = Waiting
        }
        contains waitingToDone: Transition subsets transitions {
            redefine refers from: State = Waiting
            redefine refers to: State = Done
            redefine contains trigger: TimeoutTrigger {
                redefine refers timeout: Timeout = delay
            }
        }
        contains doneToStillUp: Transition subsets transitions {
            redefine refers from: State = Done
            redefine refers to: State = StillUp
            redefine contains trigger: TimeoutTrigger {
                redefine refers timeout: Timeout = delay
            }
        }
    }
}

@VerificationCase
@Tag("expect-pass")
class TimeoutSetAtInitializationIsUpAfterItsValueInSteps : LibraryCase {
    contains machine: TimedStart redefines component

    redefine prop {
        return EF (machine.Main.Done.isActive() && machine.steps.variable == 2)
    }
}

@VerificationCase
@Tag("expect-fail")
class TimeoutBeforeItsValueInStepsUnreachable : LibraryCase {
    contains machine: TimedStart redefines component

    redefine prop {
        return EF (machine.Main.Done.isActive() && machine.steps.variable < 2)
    }
}

@VerificationCase
@Tag("expect-pass")
class TimeoutStaysUpOnceUp : LibraryCase {
    contains machine: TimedStart redefines component

    redefine prop {
        return EF (machine.Main.StillUp.isActive() && machine.steps.variable == 3)
    }
}
