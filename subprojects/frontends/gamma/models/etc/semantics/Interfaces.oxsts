package gamma::library::semantics

import semantifyr::gamma::statecharts
import semantifyr::gamma::components
import semantifyr::gamma::triggers
import semantifyr::gamma::actions
import semantifyr::gamma::events
import semantifyr::gamma::ports

class Greeting : Interface {
    contains hello: Event subsets inputEvents {
        @Shared
        redefine contains declaration: EventDeclaration
    }
}

class Reply : Greeting {
    contains welcome: Event subsets outputEvents {
        @Shared
        redefine contains declaration: EventDeclaration
    }
}

class Conversing : Reply

class Host : Statechart {
    contains guests: ProvidedPort subsets ports {
        redefine contains interface: Conversing
    }

    contains Main: Region subsets regions {
        contains Waiting: State subsets states
        contains Greeted: State subsets states

        contains entryToWaiting: EntryTransition subsets entryTransitions {
            redefine refers to: State = Waiting
        }
        contains waitingToGreeted: Transition subsets transitions {
            redefine refers from: State = Waiting
            redefine refers to: State = Greeted
            redefine contains trigger: EventTrigger {
                redefine refers port: Port = guests
                redefine refers event: Event = guests.interface.hello
            }
            contains raiseWelcome: RaiseEventAction subsets actions {
                redefine refers port: Port = guests
                redefine refers event: Event = guests.interface.welcome
            }
        }
    }
}

class Guest : Statechart {
    contains control: ProvidedPort subsets ports {
        redefine contains interface: Control
    }
    contains host: RequiredPort subsets ports {
        redefine contains interface: Conversing
    }

    contains Main: Region subsets regions {
        contains Outside: State subsets states
        contains Knocked: State subsets states
        contains Welcomed: State subsets states

        contains entryToOutside: EntryTransition subsets entryTransitions {
            redefine refers to: State = Outside
        }
        contains outsideToKnocked: Transition subsets transitions {
            redefine refers from: State = Outside
            redefine refers to: State = Knocked
            redefine contains trigger: EventTrigger {
                redefine refers port: Port = control
                redefine refers event: Event = control.interface.start
            }
            contains raiseHello: RaiseEventAction subsets actions {
                redefine refers port: Port = host
                redefine refers event: Event = host.interface.hello
            }
        }
        contains knockedToWelcomed: Transition subsets transitions {
            redefine refers from: State = Knocked
            redefine refers to: State = Welcomed
            redefine contains trigger: EventTrigger {
                redefine refers port: Port = host
                redefine refers event: Event = host.interface.welcome
            }
        }
    }
}

class Visit : SyncComponent {
    refers control: Port subsets ports = guest.control
    contains host: Host subsets components
    contains guest: Guest subsets components
    contains channel: Channel subsets channels {
        redefine refers inputPort: Port = host.guests
        redefine refers outputPort: Port = guest.host
    }
}

@VerificationCase
@Tag("expect-pass")
class InheritedEventsCrossTheChannelInBothDirections : LibraryCase {
    contains visit: Visit redefines component

    redefine prop {
        return EF visit.guest.Main.Welcomed.isActive()
    }
}

class Duplex : Interface {
    contains pingInput: Event subsets inputEvents {
        @Shared
        redefine contains declaration: EventDeclaration
    }
    contains pingOutput: Event subsets outputEvents {
        @Shared
        redefine contains declaration: EventDeclaration
    }
}

class Caller : Statechart {
    contains control: ProvidedPort subsets ports {
        redefine contains interface: Control
    }
    contains line: ProvidedPort subsets ports {
        redefine contains interface: Duplex
    }

    contains Main: Region subsets regions {
        contains Idle: State subsets states
        contains Calling: State subsets states
        contains Answered: State subsets states

        contains entryToIdle: EntryTransition subsets entryTransitions {
            redefine refers to: State = Idle
        }
        contains idleToCalling: Transition subsets transitions {
            redefine refers from: State = Idle
            redefine refers to: State = Calling
            redefine contains trigger: EventTrigger {
                redefine refers port: Port = control
                redefine refers event: Event = control.interface.start
            }
            contains raisePing: RaiseEventAction subsets actions {
                redefine refers port: Port = line
                redefine refers event: Event = line.interface.pingOutput
            }
        }
        contains callingToAnswered: Transition subsets transitions {
            redefine refers from: State = Calling
            redefine refers to: State = Answered
            redefine contains trigger: EventTrigger {
                redefine refers port: Port = line
                redefine refers event: Event = line.interface.pingInput
            }
        }
    }
}

class Callee : Statechart {
    contains line: RequiredPort subsets ports {
        redefine contains interface: Duplex
    }

    contains Main: Region subsets regions {
        contains Waiting: State subsets states
        contains Replied: State subsets states

        contains entryToWaiting: EntryTransition subsets entryTransitions {
            redefine refers to: State = Waiting
        }
        contains waitingToReplied: Transition subsets transitions {
            redefine refers from: State = Waiting
            redefine refers to: State = Replied
            redefine contains trigger: EventTrigger {
                redefine refers port: Port = line
                redefine refers event: Event = line.interface.pingOutput
            }
            contains raisePing: RaiseEventAction subsets actions {
                redefine refers port: Port = line
                redefine refers event: Event = line.interface.pingInput
            }
        }
    }
}

class Call : SyncComponent {
    refers control: Port subsets ports = caller.control
    contains caller: Caller subsets components
    contains callee: Callee subsets components
    contains channel: Channel subsets channels {
        redefine refers inputPort: Port = caller.line
        redefine refers outputPort: Port = callee.line
    }
}

@VerificationCase
@Tag("expect-pass")
class InoutEventCrossesTheChannelInBothDirections : LibraryCase {
    contains call: Call redefines component

    redefine prop {
        return EF call.caller.Main.Answered.isActive()
    }
}
