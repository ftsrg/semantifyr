package gamma::library::semantics

import semantifyr::gamma::expressions
import semantifyr::gamma::variables
import semantifyr::gamma::statecharts
import semantifyr::gamma::components
import semantifyr::gamma::triggers
import semantifyr::gamma::actions
import semantifyr::gamma::events
import semantifyr::gamma::ports

class Measurements : Interface {
    contains sample: Event subsets inputEvents {
        @Shared
        redefine contains declaration: EventDeclaration
        contains value: IntegerParameter subsets parameters {
            @Shared
            redefine contains declaration: ParameterDeclaration
        }
    }
    contains level: Event subsets inputEvents {
        @Shared
        redefine contains declaration: EventDeclaration
        redefine refers persistent: bool = true
        contains value: IntegerParameter subsets parameters {
            @Shared
            redefine contains declaration: ParameterDeclaration
        }
    }
}

class Probe : Statechart {
    redefine refers transitionPriority: TransitionPriority = TransitionPriority::OrderBased

    contains control: ProvidedPort subsets ports {
        redefine contains interface: Control
    }
    contains measure: ProvidedPort subsets ports {
        redefine contains interface: Measurements
    }

    contains kept: IntegerVariable subsets variables
    contains sampled: IntegerVariable subsets variables
    contains observed: IntegerVariable subsets variables

    contains Main: Region subsets regions {
        contains Waiting: State subsets states
        contains Holding: State subsets states
        contains Probed: State subsets states

        contains entryToWaiting: EntryTransition subsets entryTransitions {
            redefine refers to: State = Waiting
        }
        contains waitingToHolding: Transition subsets transitions {
            redefine refers from: State = Waiting
            redefine refers to: State = Holding
            redefine contains trigger: EventTrigger {
                redefine refers port: Port = measure
                redefine refers event: Event = measure.interface.level
            }
            contains keepLevel: AssignmentAction subsets actions {
                redefine refers variable: Variable = kept
                redefine contains expression: ParameterExpression {
                    redefine refers parameter: Parameter = measure.interface.level.value
                }
            }
        }
        contains holdingOnLevel: Transition subsets transitions {
            redefine refers from: State = Holding
            redefine refers to: State = Holding
            redefine contains trigger: EventTrigger {
                redefine refers port: Port = measure
                redefine refers event: Event = measure.interface.level
            }
            contains keepLevel: AssignmentAction subsets actions {
                redefine refers variable: Variable = kept
                redefine contains expression: ParameterExpression {
                    redefine refers parameter: Parameter = measure.interface.level.value
                }
            }
        }
        contains holdingOnSample: Transition subsets transitions {
            redefine refers from: State = Holding
            redefine refers to: State = Holding
            redefine contains trigger: EventTrigger {
                redefine refers port: Port = measure
                redefine refers event: Event = measure.interface.sample
            }
        }
        contains holdingToProbed: Transition subsets transitions {
            redefine refers from: State = Holding
            redefine refers to: State = Probed
            redefine contains trigger: EventTrigger {
                redefine refers port: Port = control
                redefine refers event: Event = control.interface.start
            }
            contains readSample: AssignmentAction subsets actions {
                redefine refers variable: Variable = sampled
                redefine contains expression: ParameterExpression {
                    redefine refers parameter: Parameter = measure.interface.sample.value
                }
            }
            contains readLevel: AssignmentAction subsets actions {
                redefine refers variable: Variable = observed
                redefine contains expression: ParameterExpression {
                    redefine refers parameter: Parameter = measure.interface.level.value
                }
            }
        }
    }
}

@VerificationCase
@Tag("expect-pass")
class TransientParameterIsResetWhenItsEventIsNotRaised : LibraryCase {
    contains machine: Probe redefines component

    redefine prop {
        return AG (!machine.Main.Probed.isActive() || machine.sampled.variable == 0)
    }
}

@VerificationCase
@Tag("expect-pass")
class PersistentParameterKeepsItsValueWhenItsEventIsNotRaised : LibraryCase {
    contains machine: Probe redefines component

    redefine prop {
        return AG (!machine.Main.Probed.isActive() || machine.observed.variable == machine.kept.variable)
    }
}

@VerificationCase
@Tag("expect-pass")
class EnvironmentHavocsTheParameterWithTheRaise : LibraryCase {
    contains machine: Probe redefines component

    redefine prop {
        return EF (machine.Main.Probed.isActive() && machine.observed.variable == 7)
    }
}

class PairedProbe : Statechart {
    redefine refers transitionPriority: TransitionPriority = TransitionPriority::OrderBased

    contains first: ProvidedPort subsets ports {
        redefine contains interface: Measurements
    }
    contains second: ProvidedPort subsets ports {
        redefine contains interface: Measurements
    }

    contains fromFirst: IntegerVariable subsets variables
    contains fromSecond: IntegerVariable subsets variables

    contains Main: Region subsets regions {
        contains Waiting: State subsets states
        contains Read: State subsets states

        contains entryToWaiting: EntryTransition subsets entryTransitions {
            redefine refers to: State = Waiting
        }
        contains waitingOnSecond: Transition subsets transitions {
            redefine refers from: State = Waiting
            redefine refers to: State = Waiting
            redefine contains trigger: EventTrigger {
                redefine refers port: Port = second
                redefine refers event: Event = second.interface.sample
            }
        }
        contains waitingToRead: Transition subsets transitions {
            redefine refers from: State = Waiting
            redefine refers to: State = Read
            redefine contains trigger: EventTrigger {
                redefine refers port: Port = first
                redefine refers event: Event = first.interface.sample
            }
            contains readFirst: AssignmentAction subsets actions {
                redefine refers variable: Variable = fromFirst
                redefine contains expression: ParameterExpression {
                    redefine refers parameter: Parameter = first.interface.sample.value
                }
            }
            contains readSecond: AssignmentAction subsets actions {
                redefine refers variable: Variable = fromSecond
                redefine contains expression: ParameterExpression {
                    redefine refers parameter: Parameter = second.interface.sample.value
                }
            }
        }
    }
}

@VerificationCase
@Tag("expect-pass")
class TwoPortsOfOneEventHoldIndependentParameters : LibraryCase {
    contains machine: PairedProbe redefines component

    redefine prop {
        return AG (!machine.Main.Read.isActive() || machine.fromSecond.variable == 0)
    }
}

@VerificationCase
@Tag("expect-pass")
class TwoPortsOfOneEventFirstPortsValueArrives : LibraryCase {
    contains machine: PairedProbe redefines component

    redefine prop {
        return EF (machine.Main.Read.isActive() && machine.fromFirst.variable == 7)
    }
}

class Readings : Interface {
    contains reading: Event subsets outputEvents {
        @Shared
        redefine contains declaration: EventDeclaration
        contains value: IntegerParameter subsets parameters {
            @Shared
            redefine contains declaration: ParameterDeclaration
        }
    }
}

class Sensor : Statechart {
    contains control: ProvidedPort subsets ports {
        redefine contains interface: Control
    }
    contains output: ProvidedPort subsets ports {
        redefine contains interface: Readings
    }

    contains Main: Region subsets regions {
        contains Idle: State subsets states
        contains Sent: State subsets states

        contains entryToIdle: EntryTransition subsets entryTransitions {
            redefine refers to: State = Idle
        }
        contains idleToSent: Transition subsets transitions {
            redefine refers from: State = Idle
            redefine refers to: State = Sent
            redefine contains trigger: EventTrigger {
                redefine refers port: Port = control
                redefine refers event: Event = control.interface.start
            }
            contains raiseReading: RaiseEventAction subsets actions {
                redefine refers port: Port = output
                redefine refers event: Event = output.interface.reading
                contains value: Argument subsets arguments {
                    redefine refers parameter: Parameter = output.interface.reading.value
                    redefine contains expression: LiteralIntegerExpression {
                        redefine refers value: int = 5
                    }
                }
            }
        }
    }
}

class Display : Statechart {
    contains input: RequiredPort subsets ports {
        redefine contains interface: Readings
    }

    contains shown: IntegerVariable subsets variables

    contains Main: Region subsets regions {
        contains Waiting: State subsets states
        contains Showing: State subsets states

        contains entryToWaiting: EntryTransition subsets entryTransitions {
            redefine refers to: State = Waiting
        }
        contains waitingToShowing: Transition subsets transitions {
            redefine refers from: State = Waiting
            redefine refers to: State = Showing
            redefine contains trigger: EventTrigger {
                redefine refers port: Port = input
                redefine refers event: Event = input.interface.reading
            }
            contains show: AssignmentAction subsets actions {
                redefine refers variable: Variable = shown
                redefine contains expression: ParameterExpression {
                    redefine refers parameter: Parameter = input.interface.reading.value
                }
            }
        }
    }
}

class Monitoring : SyncComponent {
    refers control: Port subsets ports = sensor.control
    contains sensor: Sensor subsets components
    contains display: Display subsets components
    contains channel: Channel subsets channels {
        redefine refers inputPort: Port = sensor.output
        redefine refers outputPort: Port = display.input
    }
}

@VerificationCase
@Tag("expect-pass")
class RaisedArgumentCrossesTheChannel : LibraryCase {
    contains system: Monitoring redefines component

    redefine prop {
        return AG (!system.display.Main.Showing.isActive() || system.display.shown.variable == 5)
    }
}

@VerificationCase
@Tag("expect-pass")
class RaisedArgumentReachesTheDisplay : LibraryCase {
    contains system: Monitoring redefines component

    redefine prop {
        return EF system.display.Main.Showing.isActive()
    }
}
