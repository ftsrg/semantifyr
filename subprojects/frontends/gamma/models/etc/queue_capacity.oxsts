package semantifyr::gamma::fixture

import semantifyr::gamma::events
import semantifyr::gamma::asynchronous

abstract class QueueHarness {
    refers queueCapacity: int

    contains origin: Event {
        contains value: IntegerParameter subsets parameters
    }
    contains destination: Event {
        contains value: IntegerParameter subsets parameters
    }
    contains queue: MessageQueue {
        redefine refers capacity: int = queueCapacity
        redefine refers priority: int = 1
        redefine refers position: int = 0
        redefine refers rank: int = 0
        contains numbered: StoredMessage subsets messages {
            redefine refers event: Event = destination
            contains value: StoredInteger subsets parameters {
                redefine refers declaration: ParameterDeclaration = origin.value.declaration
                redefine refers parameter: Parameter = destination.value
            }
        }
    }

    var sent: int := 0
    var received: int := 0
    var inOrder: bool := true

    redefine tran {
        choice {
            if (!queue.isFull() && sent < 5) {
                origin.value.value := sent
                inline queue.enqueue(queue.numbered, origin)
                sent := sent + 1
            }
        } or {
            if (!queue.isEmpty()) {
                inline destination.reset()
                inline queue.receive()
                inOrder := inOrder && destination.isRaised && destination.value.value == received
                received := received + 1
            }
        }
    }
}

class QueueOfThree : QueueHarness {
    redefine refers queueCapacity: int = 3
}

class QueueOfOne : QueueHarness {
    redefine refers queueCapacity: int = 1
}

class QueueOfNone : QueueHarness {
    redefine refers queueCapacity: int = 0
}

@VerificationCase
@Tag("expect-pass")
class QueueOfThreeDeliversInOrderTestCase : QueueOfThree {
    prop {
        return AG inOrder
    }
}

@VerificationCase
@Tag("expect-pass")
class QueueOfThreeHoldsThreeTestCase : QueueOfThree {
    prop {
        return EF (queue.size == 3 && received == 1)
    }
}

@VerificationCase
@Tag("expect-fail")
class QueueOfThreeHoldingFourUnreachableTestCase : QueueOfThree {
    prop {
        return EF queue.size > 3
    }
}

@VerificationCase
@Tag("expect-pass")
class QueueOfOneDeliversInOrderTestCase : QueueOfOne {
    prop {
        return AG inOrder
    }
}

@VerificationCase
@Tag("expect-pass")
class QueueOfOneDeliversEveryMessageTestCase : QueueOfOne {
    prop {
        return EF received == 5
    }
}

@VerificationCase
@Tag("expect-fail")
class QueueOfOneHoldingTwoUnreachableTestCase : QueueOfOne {
    prop {
        return EF queue.size > 1
    }
}

@VerificationCase
@Tag("expect-pass")
class QueueOfNoneHoldsNothingTestCase : QueueOfNone {
    prop {
        return AG (queue.size == 0 && received == 0)
    }
}
