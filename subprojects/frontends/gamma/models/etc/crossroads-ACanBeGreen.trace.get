import Crossroads

trace ACanBeGreenTrace of ACanBeGreen

step {
    act {
        reset
    }
    assert {
        state controller.Main.Operating;
        state controller.OperatingRegion.BothYellow;
        state trafficLightA.Main.Normal;
        state trafficLightA.NormalRegion.Yellow;
        state trafficLightB.Main.Normal;
        state trafficLightB.NormalRegion.Yellow;
    }
}
step {
    act {
        raise control.toggle
        elapse 1000
        schedule component
    }
    assert {
        transition controller from BothYellow to BothRed;
        state controller.Main.Operating;
        state controller.OperatingRegion.BothRed;
        state trafficLightA.Main.Normal;
        state trafficLightA.NormalRegion.Yellow;
        state trafficLightB.Main.Normal;
        state trafficLightB.NormalRegion.Yellow;
    }
}
step {
    act {
        raise control.toggle
        elapse 1000
        schedule component
    }
    assert {
        transition trafficLightA from Yellow to Red;
        transition trafficLightB from Yellow to Red;
        state controller.Main.Operating;
        state controller.OperatingRegion.BothRed;
        state trafficLightA.Main.Normal;
        state trafficLightA.NormalRegion.Red;
        state trafficLightB.Main.Normal;
        state trafficLightB.NormalRegion.Red;
    }
}
step {
    act {
        raise control.toggle
        elapse 1000
        schedule component
    }
    assert {
        transition controller from BothRed to TrafficOnA;
        state controller.Main.Operating;
        state controller.OperatingRegion.TrafficOnA;
        state trafficLightA.Main.Normal;
        state trafficLightA.NormalRegion.Red;
        state trafficLightB.Main.Normal;
        state trafficLightB.NormalRegion.Red;
    }
}
step {
    act {
        raise control.toggle
        elapse 1000
        schedule component
    }
    assert {
        transition trafficLightA from Red to Green;
        state controller.Main.Operating;
        state controller.OperatingRegion.TrafficOnA;
        state trafficLightA.Main.Normal;
        state trafficLightA.NormalRegion.Green;
        state trafficLightB.Main.Normal;
        state trafficLightB.NormalRegion.Red;
    }
}
