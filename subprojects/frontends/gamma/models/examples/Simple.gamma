package Simple

interface Control {
    out event start
    out event stop
}

statechart LeaderStatechart [
    port control : requires Control,
    port workerControl : provides Control
] {
    region Main {
        state Idle
        state Operational
        state Stopped
        state Unreachable

        initial MainInitial
    }

    transition from MainInitial to Idle
    transition from Idle to Operational when control.start / raise workerControl.start;
    transition from Operational to Stopped when control.stop / raise workerControl.stop;
}

statechart WorkerStatechart [
    port control : requires Control
] {
    region Main {
        state Idle
        state Operational
        state Stopped
        state Unreachable

        initial MainInitial
    }

    transition from MainInitial to Idle
    transition from Idle to Operational when control.start
    transition from Operational to Stopped when control.stop
}

sync System[
    port control : requires Control
] {
    component leader : LeaderStatechart
    component worker : WorkerStatechart

    bind control -> leader.control
    channel [ leader.workerControl ] -o)- [ worker.control ]
}

verification case LeaderStatechartIdleReachable {
    component system : System

    property {
        EF state leader.Main.Idle
    }
}

verification case LeaderStatechartOperationalReachable {
    component system : System

    property {
        EF state leader.Main.Operational
    }
}

verification case LeaderStatechartStoppedReachable {
    component system : System

    property {
        EF state leader.Main.Stopped
    }
}

verification case LeaderStatechartUnreachable {
    component system : System

    property {
        AG not state leader.Main.Unreachable
    }
}

verification case WorkerStatechartIdleReachable {
    component system : System

    property {
        EF state worker.Main.Idle
    }
}

verification case WorkerStatechartOperationalReachable {
    component system : System

    property {
        EF state worker.Main.Operational
    }
}

verification case WorkerStatechartStoppedReachable {
    component system : System

    property {
        EF state worker.Main.Stopped
    }
}

verification case WorkerStatechartUnreachable {
    component system : System

    property {
        AG not state worker.Main.Unreachable
    }
}
