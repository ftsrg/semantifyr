package CrossRegionTransition

interface Control {
    in event go
}

statechart Machine [
    port control : provides Control
] {
    region Main {
        initial MainInitial
        state Outside
        state Parent {
            region Inner {
                initial InnerInitial
                state First
                state Second
            }
        }
    }

    transition from MainInitial to Outside
    transition from InnerInitial to First
    transition from Outside to Second when control.go
    transition from Second to Outside when control.go
}

verification case EnteringTheInnerTargetEntersItsParent of Machine {
    EF (state Main.Parent and state Inner.Second)
}

verification case EnteringTheInnerTargetSkipsTheInitialState of Machine {
    AG not state Inner.First
}

verification case LeavingTheInnerSourceExitsItsParent of Machine {
    AG not (state Main.Outside and state Inner.Second)
}
