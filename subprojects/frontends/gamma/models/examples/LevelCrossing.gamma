package LevelCrossing

interface Sensors {
    out event approach
    out event near
    out event enter
    out event leave
}

interface TrackReports {
    out event trainApproaching
    out event trainLeft
}

interface BarrierCommands {
    out event lower
    out event lift
}

statechart Track [
    port sensors : requires Sensors,
    port controller : provides TrackReports
] {
    region Main {
        initial MainInitial

        state Free
        state Approaching
        state Near
        state InCrossing
    }

    transition from MainInitial to Free
    transition from Free to Approaching when sensors.approach / raise controller.trainApproaching;
    transition from Approaching to Near when sensors.near
    transition from Near to InCrossing when sensors.enter
    transition from InCrossing to Free when sensors.leave / raise controller.trainLeft;
}

statechart Controller [
    port trackA : requires TrackReports,
    port trackB : requires TrackReports,
    port barrier : provides BarrierCommands
] {
    region Main {
        initial MainInitial

        state Idle
        state TrainPresent
    }

    transition from MainInitial to Idle
    transition from Idle to TrainPresent when trackA.trainApproaching / raise barrier.lower;
    transition from Idle to TrainPresent when trackB.trainApproaching / raise barrier.lower;
    transition from TrainPresent to Idle when trackA.trainLeft / raise barrier.lift;
    transition from TrainPresent to Idle when trackB.trainLeft / raise barrier.lift;
}

statechart Barrier [
    port controller : requires BarrierCommands
] {
    region Main {
        initial MainInitial

        state Up
        state Down
    }

    transition from MainInitial to Up
    transition from Up to Down when controller.lower
    transition from Down to Up when controller.lift
}

sync LevelCrossing [
    port trackASensors : requires Sensors,
    port trackBSensors : requires Sensors
] {
    component trackA : Track
    component trackB : Track
    component controller : Controller
    component barrier : Barrier

    bind trackASensors -> trackA.sensors
    bind trackBSensors -> trackB.sensors

    channel [ trackA.controller ] -o)- [ controller.trackA ]
    channel [ trackB.controller ] -o)- [ controller.trackB ]
    channel [ controller.barrier ] -o)- [ barrier.controller ]
}

verification case BarrierDownWhileTrainInCrossing {
    component system : LevelCrossing
    property {
        AG ((not state trackA.Main.InCrossing and not state trackB.Main.InCrossing) or state barrier.Main.Down)
    }
}

verification case TwoTrainsCanBeInTheCrossing {
    component system : LevelCrossing
    property {
        EF (state trackA.Main.InCrossing and state trackB.Main.InCrossing)
    }
}
