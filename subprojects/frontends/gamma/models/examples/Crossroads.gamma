package Crossroads

interface CentralControl {
    out event police
    out event toggle
}

// TODO: add enum value
interface LightControl {
    out event red
    out event yellow
    out event green
    out event none
}

statechart CentralController[
    port control : requires CentralControl,
    port controlA : provides CentralControl,
    port controlB : provides CentralControl
] {
    timeout shortToggleTimeout
    timeout longToggleTimeout

    region Main {
        initial MainInitial

        state Operating {
            region OperatingRegion {
                initial OperatingRegionInitial

                state BothYellow {
                    entry / set shortToggleTimeout := 1 s;
                }

                state BothRed {
                    entry / set longToggleTimeout := 2 s;
                }

                state TrafficOnA {
                    entry / set longToggleTimeout := 2 s;
                }

                state StoppingA {
                    entry / set shortToggleTimeout := 1 s;
                }

                state TrafficOnB {
                    entry / set longToggleTimeout := 2 s;
                }

                state StoppingB {
                    entry / set shortToggleTimeout := 1 s;
                }
            }
        }

        state Interrupted {
            entry / raise controlA.police; raise controlB.police;
            exit / raise controlA.police; raise controlB.police;
        }
    }

    transition from MainInitial to Operating
    transition from OperatingRegionInitial to BothYellow
    transition from BothYellow to BothRed when timeout shortToggleTimeout / raise controlA.toggle; raise controlB.toggle; // switch A to Red, B to Red
    transition from BothRed to TrafficOnA when timeout longToggleTimeout / raise controlA.toggle; // switch A to Green
    transition from TrafficOnA to StoppingA when timeout longToggleTimeout / raise controlA.toggle; // switch A to Yellow
    transition from StoppingA to TrafficOnB when timeout shortToggleTimeout / raise controlA.toggle; raise controlB.toggle; // switch A to Red, B to Green
    transition from TrafficOnB to StoppingB when timeout longToggleTimeout / raise controlB.toggle; // switch B to Yellow
    transition from StoppingB to TrafficOnA when timeout shortToggleTimeout / raise controlA.toggle; raise controlB.toggle; // switch A to Green, B to Red
    transition from Operating to Interrupted when control.police
    transition from Interrupted to Operating when control.police
}

statechart TrafficLightController[
    port control : requires CentralControl,
    port lightControl : provides LightControl
] {
    timeout blinkingTimeout

    region Main {
        initial MainInitial

        state Normal {
            region NormalRegion {
                initial NormalRegionInitial

                state Yellow {
                    entry / raise lightControl.yellow;
                }

                state Red {
                    entry / raise lightControl.red;
                }

                state Green {
                    entry / raise lightControl.green;
                }
            }
        }

        state Interrupted {
            region InterruptedRegion {
                initial InterruptedRegionInitial

                state BlinkingYellow {
                    entry / set blinkingTimeout := 1 s; raise lightControl.yellow;
                }

                state Black {
                    entry / set blinkingTimeout := 1 s; raise lightControl.none;
                }
            }
        }
    }

    transition from MainInitial to Normal
    transition from NormalRegionInitial to Yellow
    transition from Yellow to Red when control.toggle
    transition from Red to Green when control.toggle
    transition from Green to Yellow when control.toggle
    transition from Normal to Interrupted when control.police
    transition from Interrupted to Normal when control.police
    transition from InterruptedRegionInitial to BlinkingYellow
    transition from Black to BlinkingYellow when timeout blinkingTimeout
    transition from BlinkingYellow to Black when timeout blinkingTimeout
}

sync CrossroadSystem [
    port control : requires CentralControl/*,
    port lightControlA : provides LightControl,
    port lightControlB : provides LightControl*/
] {
    component controller : CentralController
    component trafficLightA : TrafficLightController
    component trafficLightB : TrafficLightController

    bind control -> controller.control
    //bind lightControlA -> trafficLightA.lightControl
    //bind lightControlB -> trafficLightB.lightControl

    channel [ controller.controlA ] -o)- [ trafficLightA.control ]
    channel [ controller.controlB ] -o)- [ trafficLightB.control ]
}

// CentralController verification cases

verification case ControllerOperatingReachable {
    component system : CrossroadSystem
    property {
        EF state controller.Main.Operating
    }
}

verification case ControllerOperatingBothYellowReachable {
    component system : CrossroadSystem
    property {
        EF state controller.OperatingRegion.BothYellow
    }
}

verification case ControllerOperatingBothRedReachable {
    component system : CrossroadSystem
    property {
        EF state controller.OperatingRegion.BothRed
    }
}

verification case ControllerOperatingStoppingAReachable {
    component system : CrossroadSystem
    property {
        EF state controller.OperatingRegion.StoppingA
    }
}

verification case ControllerOperatingStoppingBReachable {
    component system : CrossroadSystem
    property {
        EF state controller.OperatingRegion.StoppingB
    }
}

verification case ControllerOperatingTrafficOnAReachable {
    component system : CrossroadSystem
    property {
        EF state controller.OperatingRegion.TrafficOnA
    }
}

verification case ControllerOperatingTrafficOnBReachable {
    component system : CrossroadSystem
    property {
        EF state controller.OperatingRegion.TrafficOnB
    }
}

verification case ControllerInterruptedReachable {
    component system : CrossroadSystem
    property {
        EF state controller.Main.Interrupted
    }
}

// TrafficLightController A verification cases

verification case ANormalReachable {
    component system : CrossroadSystem
    property {
        EF state trafficLightA.Main.Normal
    }
}

verification case AInterruptedReachable {
    component system : CrossroadSystem
    property {
        EF state trafficLightA.Main.Interrupted
    }
}

verification case ACanBeYellow {
    component system : CrossroadSystem
    property {
        EF state trafficLightA.NormalRegion.Yellow
    }
}

verification case ACanBeRed {
    component system : CrossroadSystem
    property {
        EF state trafficLightA.NormalRegion.Red
    }
}

verification case ACanBeGreen {
    component system : CrossroadSystem
    property {
        EF state trafficLightA.NormalRegion.Green
    }
}

verification case ACanBeBlinkingYellow {
    component system : CrossroadSystem
    property {
        EF state trafficLightA.InterruptedRegion.BlinkingYellow
    }
}

verification case ACanBeBlinkingBlack {
    component system : CrossroadSystem
    property {
        EF state trafficLightA.InterruptedRegion.Black
    }
}

// TrafficLightController B verification cases

verification case BNormalReachable {
    component system : CrossroadSystem
    property {
        EF state trafficLightB.Main.Normal
    }
}

verification case BInterruptedReachable {
    component system : CrossroadSystem
    property {
        EF state trafficLightB.Main.Interrupted
    }
}

verification case BCanBeYellow {
    component system : CrossroadSystem
    property {
        EF state trafficLightB.NormalRegion.Yellow
    }
}

verification case BCanBeRed {
    component system : CrossroadSystem
    property {
        EF state trafficLightB.NormalRegion.Red
    }
}

verification case BCanBeGreen {
    component system : CrossroadSystem
    property {
        EF state trafficLightB.NormalRegion.Green
    }
}

verification case BCanBeBlinkingYellow {
    component system : CrossroadSystem
    property {
        EF state trafficLightB.InterruptedRegion.BlinkingYellow
    }
}

verification case BCanBeBlinkingBlack {
    component system : CrossroadSystem
    property {
        EF state trafficLightB.InterruptedRegion.Black
    }
}

// Combined safety verification cases

verification case ReachableRedRed {
    component system : CrossroadSystem
    property { 
        EF (
            state trafficLightA.NormalRegion.Red 
            and state trafficLightB.NormalRegion.Red 
        )
    }
}

verification case ReachableRedGreen {
    component system : CrossroadSystem
    property { 
        EF (
            state trafficLightA.NormalRegion.Red 
            and state trafficLightB.NormalRegion.Green 
        )
    }
}

verification case ReachableRedYellow {
    component system : CrossroadSystem
    property { 
        EF (
            state trafficLightA.NormalRegion.Red 
            and state trafficLightB.NormalRegion.Yellow 
        )
    }
}

verification case ReachableGreenRed {
    component system : CrossroadSystem
    property { 
        EF (
            state trafficLightA.NormalRegion.Green 
            and state trafficLightB.NormalRegion.Red 
        )
    }
}

verification case UnreachableGreenGreen {
    component system : CrossroadSystem
    property { 
        AG not (
            state trafficLightA.NormalRegion.Green 
            and state trafficLightB.NormalRegion.Green 
        )
    }
}

verification case UnreachableGreenYellow {
    component system : CrossroadSystem
    property { 
        AG not (
            state trafficLightA.NormalRegion.Green 
            and state trafficLightB.NormalRegion.Yellow 
        )
    }
}

verification case ReachableYellowRed {
    component system : CrossroadSystem
    property { 
        EF (
            state trafficLightA.NormalRegion.Yellow 
            and state trafficLightB.NormalRegion.Red 
        )
    }
}

verification case UnreachableYellowGreen {
    component system : CrossroadSystem
    property {
        AG not (
            state trafficLightA.NormalRegion.Yellow
            and state trafficLightB.NormalRegion.Green
        )
    }
}

verification case ReachableYellowYellow {
    component system : CrossroadSystem
    property { 
        EF (
            state trafficLightA.NormalRegion.Yellow 
            and state trafficLightB.NormalRegion.Yellow 
        )
    }
}
