package semantifyr::gamma::actions

import semantifyr::gamma::variables
import semantifyr::gamma::expressions
import semantifyr::gamma::events
import semantifyr::gamma::ports

abstract class Action {
    redefine tran {
    }
}

class RaiseEventAction : Action {
    refers port: Port[1]
    refers event: Event[1]
    contains arguments: Argument[0..*]

    redefine tran {
        inline for (argument in arguments) {
            inline argument.parameter.set(argument.expression.evaluate())
        }
        inline port.setOutputEvent(event)
    }
}

class Argument {
    refers parameter: Parameter[1]
    contains expression: Expression[1]
}

class SetTimeoutAction : Action {
    refers timeout: Timeout[1]
    contains expression: Expression[1]

    redefine tran {
        timeout.remainingTime := expression.evaluate() as int
    }
}

class AssignmentAction : Action {
    refers variable: Variable[1]
    contains expression: Expression[1]

    redefine tran {
        inline variable.set(expression.evaluate())
    }
}
