package semantifyr::gamma::statecharts

import semantifyr::gamma::expressions
import semantifyr::gamma::variables
import semantifyr::gamma::components
import semantifyr::gamma::triggers
import semantifyr::gamma::actions
import semantifyr::gamma::events

enum RegionSchedule {
    TopDown,
    BottomUp,
}

enum TransitionPriority {
    Off,
    OrderBased,
    ValueBased,
}

enum GuardEvaluation {
    OnTheFly,
    BeginningOfStep,
}

class TransitionScheduler {
    refers innerRegions: Region[0..*]

    tran fireTransitions() {
        var anyRegionExecuted: bool := false
        inline for (region in innerRegions) {
            choice {
                inline region.fire()
                anyRegionExecuted := true
            } or {
                inline region.assumeNoTransitionEnabled()
            }
        }
        assume(anyRegionExecuted) // at least one inner "parallel" region must be executed
    }
}

class Statechart : Component {
    contains regions: Region[0..*] opposite parentStatechart
    contains variables: Variable[0..*]

    refers regionSchedule: RegionSchedule = RegionSchedule::TopDown
    refers transitionPriority: TransitionPriority = TransitionPriority::Off
    refers guardEvaluation: GuardEvaluation = GuardEvaluation::OnTheFly

    contains transitionScheduler: TransitionScheduler {
        redefine refers innerRegions: Region[0..*] = regions
    }

    redefine init {
        inline for (region in regions) {
            inline region.activateRecursive()
        }
    }

    redefine tran schedule() {
        inline if (guardEvaluation == GuardEvaluation::BeginningOfStep) {
            inline for (region in regions) {
                inline region.saveGuards()
            }
        }

        choice {
            inline transitionScheduler.fireTransitions()
        } or {
            inline assumeNoTransitionEnabled()
            // only do nothing, if the statechart cannot do anything, i.e., no fireable transitions
        }

        inline resetInputEvents()
    }

    redefine tran restore() {
        inline for (port in ports) {
            inline port.restore()
        }

        inline for (variable in variables) {
            inline variable.restore()
        }

        inline for (region in regions) {
            inline region.restore()
        }
    }

    // TODO: would be easier to implement if we had ...any { } and ...all { } lambda functions that could compose expressions
    tran assumeNoTransitionEnabled() {
        inline for (region in regions) {
            inline region.assumeNoTransitionEnabled()
        }
    }
}

class Region {
    contains states: State[0..*] opposite parentRegion
    container parentStatechart: Statechart[0..1] opposite regions
    container parentState: State[0..1] opposite regions

    refers statechart: Statechart = if (parentState == nothing) then parentStatechart as Statechart else parentState.statechart

    contains abstractTransitions: AbstractTransition[0..*] opposite parentRegion
    contains transitions: Transition[0..*] subsets abstractTransitions
    contains entryTransitions: EntryTransition[0..*] subsets abstractTransitions
    contains shallowHistory: ShallowHistory[0..1] opposite parentRegion

    @Control
    var activeState: states[0..1] := nothing

    tran restore() {
        activeState := nothing
        inline for (history in shallowHistory) {
            inline history.restore()
        }
        inline for (state in states) {
            inline for (region in state.regions) {
                inline region.restore()
            }
        }
    }

    tran activateRecursive() {
        inline if (entryTransitions == nothing) {
            inline for (history in shallowHistory) {
                inline history.enterRegion()
            }
        } else {
            inline for (transition in entryTransitions) {
                inline transition.main()
            }
        }
    }

    tran exitRecursive() {
        inline for (state in states) {
            inline state.exitRecursive()
        }
    }

    tran activateOrthogonalRegions() {
        inline for (region in parentState.regions) {
            inline if (region != self) {
                inline region.activateRecursive()
            }
        }
    }

    tran exitOrthogonalRegions() {
        inline for (region in parentState.regions) {
            inline if (region != self) {
                inline region.exitRecursive()
            }
        }
    }

    tran saveGuards() {
        inline for (transition in transitions) {
            inline transition.saveGuard()
        }
        inline for (state in states) {
            inline for (region in state.regions) {
                inline region.saveGuards()
            }
        }
    }

    tran fire() {
        inline if (statechart.regionSchedule == RegionSchedule::BottomUp) {
            choice {
                // fire state transitions if inner transitions are not enabled (bottom-up)
                inline assumeNoInnerTransitionEnabled()
                inline fireLocalTransitions()
            } or {
                inline fireInnerTransitions()
            }
        } else {
            choice {
                inline fireLocalTransitions()
            } or {
                // fire inner transitions if local transitions are not enabled (top-down)
                inline assumeNoLocalTransitionEnabled()
                inline fireInnerTransitions()
            }
        }
    }

    tran fireLocalTransitions() {
        inline if (statechart.transitionPriority == TransitionPriority::OrderBased) {
            var fired: bool := false
            inline for (transition in transitions) {
                if (!fired && transition.isEnabled()) {
                    fired := true
                    inline transition.fire()
                }
            }
            assume(fired)
        } else {
            inline for choice (transition in transitions) {
                inline if (statechart.transitionPriority == TransitionPriority::ValueBased) {
                    inline transition.assumeNoHigherPriorityEnabled()
                }
                inline transition.main()
            } else {
                assume(false)
            }
        }
    }

    tran fireInnerTransitions() {
        inline for choice (state in states) {
            inline state.fireTransitions()
        } else {
            assume(false)
        }
    }

    tran assumeNoLocalTransitionEnabled() {
        inline for (transition in transitions) {
            assume(!transition.isEnabled())
        }
    }

    tran assumeNoInnerTransitionEnabled() {
        inline for (state in states) {
            inline state.assumeNoTransitionEnabled()
        }
    }

    tran assumeNoTransitionEnabled() {
        inline assumeNoLocalTransitionEnabled()
        inline assumeNoInnerTransitionEnabled()
    }
}

abstract class TransitionTarget {
    abstract tran receive(transition: Transition)

    abstract tran enterFrom(top: State)
}

class State : TransitionTarget {
    container parentRegion: Region[1] opposite states
    contains regions: Region[0..*] opposite parentState

    refers parentState: State[0..1] = parentRegion.parentState // as pattern parentState
    refers statechart: Statechart = parentRegion.statechart
    contains entryActions: Action[0..*]
    contains exitActions: Action[0..*]

    contains transitionScheduler: TransitionScheduler {
        redefine refers innerRegions: Region[0..*] = regions
    }

    prop isActive(): bool {
        return parentRegion.activeState == self
    }

    tran enterOwn() {
        parentRegion.activeState := self
        inline for (history in parentRegion.shallowHistory) {
            history.lastState := nothing
        }

        inline for (action in entryActions) {
            inline action.main()
        }
    }

    tran enter() {
        inline enterOwn()

        inline for (region in regions) {
            inline region.activateRecursive()
        }
    }

    tran exitOwn() {
        inline for (action in exitActions) {
            inline action.main()
        }

        inline for (history in parentRegion.shallowHistory) {
            history.lastState := self
        }
        parentRegion.activeState := nothing
    }

    tran exitRecursive() {
        if (isActive()) {
            inline for (region in regions) {
                inline region.exitRecursive()
            }

            inline exitOwn()
        }
    }

    // the order of the levels and their orthogonal regions is Gamma's, ExitActionRetriever and EntryActionRetriever
    tran exitUpTo(top: State) {
        inline exitRecursive()

        inline if (self != top) {
            inline parentRegion.exitOrthogonalRegions()
            inline exitAncestorsUpTo(top)
        }
    }

    tran exitAncestorsUpTo(top: State) {
        inline if (self != top) {
            inline if (parentState != top) {
                inline parentState.parentRegion.exitOrthogonalRegions()
            }
            inline parentState.exitOwn()
            inline parentState.exitAncestorsUpTo(top)
        }
    }

    redefine tran receive(transition: Transition) {
        inline transition.fireBetween(transition.from, self, self)
    }

    redefine tran enterFrom(top: State) {
        inline if (self != top) {
            inline enterAncestorsFrom(top)
            inline enter()
            inline parentRegion.activateOrthogonalRegions()
        } else {
            inline enter()
        }
    }

    tran enterAncestorsFrom(top: State) {
        inline if (self != top) {
            inline parentState.enterAncestorsFrom(top)
            inline if (parentState != top) {
                inline parentState.parentRegion.activateOrthogonalRegions()
            }
            inline parentState.enterOwn()
        }
    }

    tran fireTransitions() {
        inline if (regions == nothing) {
            assume(false)
        } else {
            inline transitionScheduler.fireTransitions()
        }
    }

    tran assumeNoTransitionEnabled() {
        inline for (region in regions) {
            inline region.assumeNoTransitionEnabled()
        }
    }
}

class Guard {
    contains expression: Expression[1]

    prop isOpen(): bool {
        return expression.evaluate() as bool
    }
}

abstract class AbstractTransition {
    container parentRegion: Region[1] opposite abstractTransitions

    abstract prop isEnabled(): bool

    abstract tran fire()

    redefine tran {
        assume(isEnabled())
        inline fire()
    }
}

class EntryTransition : AbstractTransition {
    refers to: State[1]

    contains actions: Action[0..*]

    redefine prop isEnabled(): bool {
        return true
    }

    redefine tran fire() {
        inline for (action in actions) {
            inline action.main()
        }
        inline to.enter()
    }
}

class Transition : AbstractTransition {
    refers from: State[1]
    refers to: TransitionTarget[1]
    refers statechart: Statechart = parentRegion.statechart
    refers priority: int = 0

    contains trigger: Trigger[1]
    contains guard: Guard[1] { // default guard is true
        redefine contains expression: LiteralBooleanExpression {
            redefine refers value: bool = true
        }
    }

    contains actions: Action[0..*]

    var guardAtStepStart: bool := false

    prop isTriggeredAndOpen(): bool {
        return trigger.isTriggered() && guard.isOpen()
    }

    redefine prop isEnabled(): bool {
        return from.isActive() && (if (statechart.guardEvaluation == GuardEvaluation::BeginningOfStep) then guardAtStepStart else isTriggeredAndOpen())
    }

    tran saveGuard() {
        guardAtStepStart := isTriggeredAndOpen()
    }

    tran assumeNoHigherPriorityEnabled() {
        inline for (other in parentRegion.transitions) {
            inline if (other.priority > priority) {
                assume(!other.isEnabled())
            }
        }
    }

    @Trace
    redefine tran fire() {
        inline to.receive(self)
    }

    tran fireBetween(sourceAncestor: State, targetAncestor: State, targetStart: State) {
        inline if (sourceAncestor.parentRegion == targetAncestor.parentRegion) {
            inline from.exitUpTo(sourceAncestor)
            inline for (action in actions) {
                inline action.main()
            }
            inline to.enterFrom(targetAncestor)
        } else {
            inline if (targetAncestor.parentState != nothing) {
                inline fireBetween(sourceAncestor, targetAncestor.parentState as State, targetStart)
            } else {
                inline fireBetween(sourceAncestor.parentState as State, targetStart, targetStart)
            }
        }
    }
}

class ShallowHistory : TransitionTarget {
    container parentRegion: Region[1] opposite shallowHistory

    refers to: State[1]

    @Control
    var lastState: State[0..1] := nothing

    tran restore() {
        lastState := nothing
    }

    tran enterRegion() {
        if (lastState == nothing) {
            inline to.enter()
        } else {
            inline for (state in parentRegion.states) {
                if (lastState == state) {
                    inline state.enter()
                }
            }
        }
    }

    redefine tran receive(transition: Transition) {
        inline transition.fireBetween(transition.from, parentRegion.parentState as State, parentRegion.parentState as State)
    }

    redefine tran enterFrom(top: State) {
        inline parentRegion.parentState.enterAncestorsFrom(top)
        inline parentRegion.parentState.enterOwn()
        inline for (region in parentRegion.parentState.regions) {
            inline if (region == parentRegion) {
                inline enterRegion()
            } else {
                inline region.activateRecursive()
            }
        }
        inline if (parentRegion.parentState != top) {
            inline parentRegion.parentState.parentRegion.activateOrthogonalRegions()
        }
    }
}

class IsStateActiveExpression : Expression {
    refers state: State

    redefine prop evaluate(): bool {
        return state.isActive()
    }
}
