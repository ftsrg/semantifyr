package semantifyr::gamma::ports

import semantifyr::gamma::events

class Interface {
    contains events: Event[0..*]
    contains inputEvents: Event[0..*] subsets events
    contains outputEvents: Event[0..*] subsets events
}

class Port {
    contains interface: Interface[1]

    refers inputEvents: Event[0..*]
    refers outputEvents: Event[0..*]

    prop hasInputEvent(event: Event): bool {
        return event.isRaised
    }

    tran setInputEvent(event: Event) {
        event.isRaised := true
    }

    @Trace
    tran setOutputEvent(event: Event) {
        event.isRaised := true
    }

    tran resetInputEvents() {
        inline for (event in inputEvents) {
            inline event.reset()
        }
    }

    tran resetOutputEvents() {
        inline for (event in outputEvents) {
            inline event.reset()
        }
    }

    tran havocInputEvents() {
        inline for (event in inputEvents) {
            choice {
                inline event.reset()
            } or {
                inline raiseInputEvent(event)
                inline event.havocParameters()
            }
        }
    }

    @Trace
    tran raiseInputEvent(event: Event) {
        event.isRaised := true
    }

    tran transferOutputEvents(target: Port) {
        inline for (event in outputEvents) {
            inline for (targetEvent in target.inputEvents) {
                inline if (event.declaration == targetEvent.declaration) {
                    if (event.isRaised) {
                        inline target.setInputEvent(targetEvent)
                        inline targetEvent.copyParametersFrom(event)
                    }
                }
            }
        }
    }
}

class RequiredPort : Port {
    // required ports flip the direction
    redefine refers inputEvents: Event[0..*] = interface.outputEvents
    redefine refers outputEvents: Event[0..*] = interface.inputEvents
}

class ProvidedPort : Port {
    redefine refers inputEvents: Event[0..*] = interface.inputEvents
    redefine refers outputEvents: Event[0..*] = interface.outputEvents
}
