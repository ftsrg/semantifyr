package semantifyr::gamma::components

import semantifyr::gamma::events
import semantifyr::gamma::ports

abstract class Component {
    contains ports: Port[0..*]
    contains timeouts: Timeout[0..*]

    redefine tran {
        inline schedule()
    }

    abstract tran schedule()

    tran resetInputEvents() {
        inline for (port in ports) {
            inline port.resetInputEvents()
        }
    }

    tran havocInputEvents() {
        inline for (port in ports) {
            inline port.havocInputEvents()
        }
    }

    tran resetOutputEvents() {
        inline for (port in ports) {
            inline port.resetOutputEvents()
        }
    }

    tran passTime() {
        inline for (timeout in timeouts) {
            inline timeout.passTime()
        }
    }

    // timeouts are left as Gamma's initializing action leaves them, a state sets its own when entered
    tran restore() {
        inline for (port in ports) {
            inline port.restore()
        }
    }
}

class Channel {
    refers inputPort: Port[1]
    refers outputPort: Port[1]

    redefine tran {
        inline inputPort.transferOutputEvents(outputPort)
        inline outputPort.transferOutputEvents(inputPort)
    }

    tran resetOutputEventsOf(component: Component) {
        inline for (port in component.ports) {
            inline if (port == inputPort) {
                inline inputPort.resetOutputEvents()
            }
            inline if (port == outputPort) {
                inline outputPort.resetOutputEvents()
            }
        }
    }

    tran transferOutputEventsOf(component: Component) {
        inline for (port in component.ports) {
            inline if (port == inputPort) {
                inline inputPort.transferOutputEvents(outputPort)
            }
            inline if (port == outputPort) {
                inline outputPort.transferOutputEvents(inputPort)
            }
        }
    }
}

abstract class CompositeComponent : Component {
    contains components: Component[0..*]
    contains channels: Channel[0..*]

    redefine init {
        inline for (component in components) {
            inline component.init()
        }

        inline for (channel in channels) {
            inline channel.main()
        }
    }

    redefine tran passTime() {
        inline for (timeout in timeouts) {
            inline timeout.passTime()
        }

        inline for (component in components) {
            inline component.passTime()
        }
    }

    redefine tran restore() {
        inline for (port in ports) {
            inline port.restore()
        }

        inline for (component in components) {
            inline component.restore()
        }
    }
}

class SyncComponent : CompositeComponent {
    redefine tran schedule() {
        inline for (component in components) {
            inline component.resetOutputEvents()
            inline component.main()
        }

        inline for (channel in channels) {
            inline channel.main()
        }

        inline resetInputEvents()
    }
}

class ExecutionStep {
    refers component: Component[1]
}

class CascadeComponent : CompositeComponent {
    contains executionSteps: ExecutionStep[0..*]

    // a channel delivers at the raise; its source's outputs are not state in Gamma, so they are cleared before the source runs again
    redefine tran schedule() {
        inline for (step in executionSteps) {
            inline for (channel in channels) {
                inline channel.resetOutputEventsOf(step.component)
            }

            inline step.component.main()

            inline for (channel in channels) {
                inline channel.transferOutputEventsOf(step.component)
            }
        }
    }
}
