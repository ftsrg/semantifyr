package crossroads_verification

import "Blinking.gcd"

verification case StateBlinkingYellowReachable {
    component system : BlinkingPhase
    property {
        EF isActive(system.Main.BlinkingYellow)
    }
}

verification case StateBlackReachable {
    component system : BlinkingPhase
    property {
        EF isActive(system.Main.Black)
    }
}
