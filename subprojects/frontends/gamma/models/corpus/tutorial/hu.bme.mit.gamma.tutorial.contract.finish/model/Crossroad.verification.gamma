package tutorial_verification

import "Crossroad.gcd"

verification case ControllerOperatingReachable {
    component system : Crossroad
    property {
        EF isActive(system.controller.main_region.Operating)
    }
}

verification case ControllerPriorityPreparesReachable {
    component system : Crossroad
    property {
        EF isActive(system.controller.main_region.Operating.operating.PriorityPrepares)
    }
}

