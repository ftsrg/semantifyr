package validation::package_d_23::stm_verification

import validation::package_d_23

verification case StateS0Reachable of statemachine {
    EF state Main.S0
}

verification case StateS1Reachable of statemachine {
    EF state Main.S1
}

verification case StateS11Reachable of statemachine {
    EF state R1.S11
}

verification case FourOutputsOfOneStepAllVisible of statemachine {
    EF (raise output.a and raise output.b and raise output.c and raise output.d)
}
