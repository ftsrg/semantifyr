package validation::package_c_11::stm_verification

import validation::package_c_11

verification case StateS0Reachable of statemachine {
    EF state Main.S0
}

verification case StateS1Reachable of statemachine {
    EF state Main.S1
}

verification case TransitionOutputVisibleAfterStep of statemachine {
    EF raise output.x
}

verification case ExitTransitionAndEntryOutputsOfOneStepAllVisible of statemachine {
    EF (raise output.b and raise output.x and raise output.c)
}
