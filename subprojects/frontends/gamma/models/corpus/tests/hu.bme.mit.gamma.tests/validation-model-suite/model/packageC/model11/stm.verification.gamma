package package_c_11_verification

import "stm.gcd"

verification case StateS0Reachable {
    component system : statemachine
    property {
        EF isActive(system.Main.S0)
    }
}

verification case StateS1Reachable {
    component system : statemachine
    property {
        EF isActive(system.Main.S1)
    }
}

verification case TransitionOutputVisibleAfterStep {
    component system : statemachine
    property {
        EF system.output.x
    }
}

verification case ExitTransitionAndEntryOutputsOfOneStepAllVisible {
    component system : statemachine
    property {
        EF (system.output.b and system.output.x and system.output.c)
    }
}
