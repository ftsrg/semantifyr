package monitoredcrossroad_verification

import "MonitoredCrossroad.gcd"

verification case CrossroadControllerOperatingReachable {
    component system : MonitoredCrossroad
    property {
        EF isActive(system.crossroad.controller.main_region.Operating)
    }
}

