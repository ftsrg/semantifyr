package crossroads::trafficlightctrl::asynchronous::AsynchronousTrafficLightCtrl_verification

import crossroads::trafficlightctrl::asynchronous

verification case StateInterruptedReachable of TrafficLightCtrl {
    EF state Main_region.Interrupted
}

verification case StateBlackReachable of TrafficLightCtrl {
    EF state interrupted.Black
}

verification case StateBlinkingYellowReachable of TrafficLightCtrl {
    EF state interrupted.BlinkingYellow
}

verification case StateNormalReachable of TrafficLightCtrl {
    EF state Main_region.Normal
}

verification case StateYellowReachable of TrafficLightCtrl {
    EF state normal.Yellow
}

verification case StateRedReachable of TrafficLightCtrl {
    EF state normal.Red
}

verification case StateGreenReachable of TrafficLightCtrl {
    EF state normal.Green
}
