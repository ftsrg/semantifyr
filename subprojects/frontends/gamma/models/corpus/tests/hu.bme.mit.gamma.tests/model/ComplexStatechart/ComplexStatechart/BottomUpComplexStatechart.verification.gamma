package complex_verification

import "BottomUpComplexStatechart.gcd"

verification case StateAReachable {
    component system : BottomUp
    property {
        EF isActive(system.main.A_)
    }
}

verification case StateAAReachable {
    component system : BottomUp
    property {
        EF isActive(system.main.A_.A.AA)
    }
}

verification case StateABReachable {
    component system : BottomUp
    property {
        EF isActive(system.main.A_.A.AB)
    }
}

verification case StateABAAReachable {
