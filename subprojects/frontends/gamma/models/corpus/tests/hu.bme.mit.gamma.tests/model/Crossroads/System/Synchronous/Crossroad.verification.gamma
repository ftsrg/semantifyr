package synccrossroads_verification

import "Crossroad.gcd"

verification case ControllerOperatingReachable {
    component system : Crossroad
    property {
        EF isActive(system.controller.main_region.Operating)
    }
}

verification case ControllerInitReachable {
    component system : Crossroad
    property {
        EF isActive(system.controller.main_region.Operating.operating.Init)
    }
}

verification case ControllerGReachable {
    component system : Crossroad
    property {
        EF isActive(system.controller.main_region.Operating.operating.Init.r.G_)
    }
}

verification case ControllerSecondaryPreparesReachable {
    component system : Crossroad
    property {
        EF isActive(system.controller.main_region.Operating.operating.SecondaryPrepares)
    }
}

verification case ControllerPriorityPreparesReachable {
    component system : Crossroad
    property {
        EF isActive(system.controller.main_region.Operating.operating.PriorityPrepares)
    }
}

verification case ControllerPriorityReachable {
    component system : Crossroad
    property {
        EF isActive(system.controller.main_region.Operating.operating.Priority)
    }
}

verification case ControllerSecondaryReachable {
    component system : Crossroad
    property {
        EF isActive(system.controller.main_region.Operating.operating.Secondary)
    }
}

verification case PriorInterruptedReachable {
    component system : Crossroad
    property {
        EF isActive(system.prior.Main_region.Interrupted)
    }
}

verification case PriorBlackReachable {
    component system : Crossroad
    property {
        EF isActive(system.prior.Main_region.Interrupted.interrupted.Black)
    }
}

verification case PriorBlinkingYellowReachable {
    component system : Crossroad
    property {
        EF isActive(system.prior.Main_region.Interrupted.interrupted.BlinkingYellow)
    }
}

verification case PriorNormalReachable {
    component system : Crossroad
    property {
        EF isActive(system.prior.Main_region.Normal)
    }
}

verification case PriorYellowReachable {
    component system : Crossroad
    property {
        EF isActive(system.prior.Main_region.Normal.normal.Yellow)
    }
}

verification case PriorRedReachable {
    component system : Crossroad
    property {
        EF isActive(system.prior.Main_region.Normal.normal.Red)
    }
}

verification case PriorGreenReachable {
    component system : Crossroad
    property {
        EF isActive(system.prior.Main_region.Normal.normal.Green)
    }
}

verification case SecondInterruptedReachable {
    component system : Crossroad
    property {
        EF isActive(system.second.Main_region.Interrupted)
    }
}

verification case SecondBlackReachable {
    component system : Crossroad
    property {
        EF isActive(system.second.Main_region.Interrupted.interrupted.Black)
    }
}

verification case SecondBlinkingYellowReachable {
    component system : Crossroad
    property {
        EF isActive(system.second.Main_region.Interrupted.interrupted.BlinkingYellow)
    }
}

verification case SecondNormalReachable {
    component system : Crossroad
    property {
        EF isActive(system.second.Main_region.Normal)
    }
}

verification case SecondYellowReachable {
    component system : Crossroad
    property {
        EF isActive(system.second.Main_region.Normal.normal.Yellow)
    }
}

verification case SecondRedReachable {
    component system : Crossroad
    property {
        EF isActive(system.second.Main_region.Normal.normal.Red)
    }
}

verification case SecondGreenReachable {
    component system : Crossroad
    property {
        EF isActive(system.second.Main_region.Normal.normal.Green)
    }
}

verification case PriorityGreenOutputVisible {
    component system : Crossroad
    property {
        EF system.priorityOutput.displayGreen
    }
}

verification case BothLightsShowGreen {
    component system : Crossroad
    property {
        EF (system.priorityOutput.displayGreen and system.secondaryOutput.displayGreen)
    }
}

verification case ControllerAheadOfSecondaryLight {
    component system : Crossroad
    property {
        EF (isActive(system.controller.main_region.Operating.operating.SecondaryPrepares) and isActive(system.second.Main_region.Normal.normal.Red) and not system.secondaryOutput.displayRed)
    }
}
