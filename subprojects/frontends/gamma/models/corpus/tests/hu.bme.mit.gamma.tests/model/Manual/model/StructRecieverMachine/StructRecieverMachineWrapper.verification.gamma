package StructRecieverMachine_verification

import "StructRecieverMachineWrapper.gcd"

verification case StructRecieverMachineStructRecieverMachineStateReachable {
    component system : StructRecieverMachineWrapper
    property {
        EF isActive(system.structRecieverMachine.StructRecieverMachine_.StructRecieverMachine__State)
    }
}

verification case RecordParameterAddedToBoth {
    component system : StructRecieverMachineWrapper
    property {
        EF (system.structRecieverMachine.cnt = 5 and system.structRecieverMachine.ss.val = 5)
    }
}

verification case RecordParameterAddedUnequally {
    component system : StructRecieverMachineWrapper
    property {
        EF (system.structRecieverMachine.cnt = 1 and system.structRecieverMachine.ss.val = 2)
    }
}
