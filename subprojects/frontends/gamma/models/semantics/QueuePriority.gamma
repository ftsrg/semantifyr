package QueuePriority

interface Go {
    in event go
}

interface Signals {
    out event first
    out event second
}

@Asynchronous
statechart Sender capacity (1) [
    port control : provides Go,
    port signals : provides Signals
] {
    region Main {
        initial MainInitial
        state Idle
        state Sent
    }

    transition from MainInitial to Idle
    transition from Idle to Sent when control.go / raise signals.first; raise signals.second;
}

@TransitionPriority = order-based
statechart Receiver [
    port signals : requires Signals
] {
    region Main {
        initial MainInitial
        state Waiting
        state GotFirst
        state GotSecond
        state FirstThenSecond
        state SecondThenFirst
    }

    transition from MainInitial to Waiting
    transition from Waiting to GotFirst when signals.first
    transition from Waiting to GotSecond when signals.second
    transition from GotFirst to FirstThenSecond when signals.second
    transition from GotSecond to SecondThenFirst when signals.first
}

adapter PrioritizedQueues of component receiver : Receiver {
    when any / run
    queue low (priority = 1, capacity = 1) {
        signals.first
    }
    queue high (priority = 2, capacity = 1) {
        signals.second
    }
}

async Prioritized [
    port control : provides Go
] {
    component sender : Sender
    component receiver : PrioritizedQueues
    bind control -> sender.control
    channel [ sender.signals ] -o)- [ receiver.signals ]
}

verification case TheHigherPriorityQueueIsServedFirst of Prioritized {
    EF state receiver -> receiver.Main.SecondThenFirst
}

verification case TheDeclaredFirstQueueIsServedFirstUnreachable of Prioritized {
    EF state receiver -> receiver.Main.FirstThenSecond
}
