package History

interface Control {
    in event start
    in event stop
}

statechart Resuming [
    port control : provides Control
] {
    var left : boolean := false

    region Main {
        initial MainInitial
        state Working {
            exit / left := true;
            region Progress {
                initial ProgressInitial
                shallow history ProgressHistory
                state First
                state Second
            }
        }
        state Paused
    }

    transition from MainInitial to Working
    transition from ProgressInitial to First
    transition from ProgressHistory to First
    transition from First to Second when control.start [not left]
    transition from Working to Paused when control.stop
    transition from Paused to ProgressHistory when control.stop
}

statechart Restarting [
    port control : provides Control
] {
    var left : boolean := false

    region Main {
        initial MainInitial
        state Working {
            exit / left := true;
            region Progress {
                initial ProgressInitial
                shallow history ProgressHistory
                state First
                state Second
            }
        }
        state Paused
    }

    transition from MainInitial to Working
    transition from ProgressInitial to First
    transition from ProgressHistory to First
    transition from First to Second when control.start [not left]
    transition from Working to Paused when control.stop
    transition from Paused to Working when control.stop
}

statechart LateHistory [
    port control : provides Control
] {
    region Main {
        initial MainInitial
        state Idle
        state Working {
            region Progress {
                shallow history ProgressHistory
                state First
                state Second
            }
        }
    }

    transition from MainInitial to Idle
    transition from ProgressHistory to Second
    transition from Idle to Working when control.start
}

verification case TransitionToTheHistoryNodeRestoresTheLastState of Resuming {
    EF (variable left and state Progress.Second)
}

verification case InitialNodeBeatsTheHistoryNodeRestoredStateUnreachable of Restarting {
    EF (variable left and state Progress.Second)
}

verification case NeverActiveHistoryRegionTakesTheNodesTransition of LateHistory {
    EF state Progress.Second
}

verification case NeverActiveHistoryRegionOtherStateUnreachable of LateHistory {
    EF state Progress.First
}
