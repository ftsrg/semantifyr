package TransitionPriority

interface Control {
    in event go
}

@TransitionPriority = order-based
statechart OrderBased [
    port control : provides Control
] {
    region Main {
        initial MainInitial
        state Idle
        state First
        state Second
    }

    transition from MainInitial to Idle
    transition from Idle to First when control.go
    transition from Idle to Second when control.go
}

@TransitionPriority = off
statechart Off [
    port control : provides Control
] {
    region Main {
        initial MainInitial
        state Idle
        state First
        state Second
    }

    transition from MainInitial to Idle
    transition from Idle to First when control.go
    transition from Idle to Second when control.go
}

@TransitionPriority = value-based
statechart ValueBased [
    port control : provides Control
] {
    region Main {
        initial MainInitial
        state Idle
        state Low
        state High
        state AlsoHigh
    }

    transition from MainInitial to Idle
    transition (1) from Idle to Low when control.go
    transition (2) from Idle to High when control.go
    transition (2) from Idle to AlsoHigh when control.go
}

@TransitionPriority = off
statechart WrittenUnderOff [
    port control : provides Control
] {
    region Main {
        initial MainInitial
        state Idle
        state Low
        state High
    }

    transition from MainInitial to Idle
    transition (1) from Idle to Low when control.go
    transition (2) from Idle to High when control.go
}

verification case OrderBasedFirstDeclaredFires of OrderBased {
    EF state Main.First
}

verification case OrderBasedSecondDeclaredUnreachable of OrderBased {
    EF state Main.Second
}

verification case PriorityOffSecondDeclaredFires of Off {
    EF state Main.Second
}

verification case ValueBasedHighestPriorityFires of ValueBased {
    EF state Main.High
}

verification case ValueBasedEqualPrioritiesBothFire of ValueBased {
    EF state Main.AlsoHigh
}

verification case ValueBasedLowerPriorityUnreachable of ValueBased {
    EF state Main.Low
}

verification case LowerWrittenPriorityFiresUnderPriorityOff of WrittenUnderOff {
    EF state Main.Low
}

verification case HigherWrittenPriorityBlocksTheLowerUnderPriorityOffViolated of WrittenUnderOff {
    AG not state Main.Low
}
