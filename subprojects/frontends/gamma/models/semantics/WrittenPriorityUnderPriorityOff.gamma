package WrittenPriorityUnderPriorityOff

interface Control {
    in event go
}

@TransitionPriority = off
statechart Machine [
    port control : provides Control
] {
    region Main {
        initial MainInitial
        state Idle
        state Low
        state High
    }

    transition from MainInitial to Idle
    transition (1) from Idle to Low when control.go
    transition (2) from Idle to High when control.go
}

verification case LowerWrittenPriorityFires of Machine {
    EF state Main.Low
}

verification case HigherWrittenPriorityFires of Machine {
    EF state Main.High
}

verification case HigherWrittenPriorityBlocksTheLowerViolated of Machine {
    AG not state Main.Low
}
