package Events

interface Control {
    in event start
}

interface Signals {
    out event first
    out event second
}

statechart Sender [
    port control : provides Control,
    port output : provides Signals
] {
    region Main {
        initial MainInitial
        state Idle
        state Sent
        state Done
    }

    transition from MainInitial to Idle
    transition from Idle to Sent when control.start / raise output.first; raise output.second;
    transition from Sent to Done when control.start
}

verification case BothEventsOfAPortAreRaisedInOneStep of Sender {
    EF (raise output.first and raise output.second)
}

verification case OneEventOfAPortRaisedWithoutTheOtherUnreachable of Sender {
    EF (raise output.first and not raise output.second)
}

verification case OutputIsVisibleAfterTheStepThatRaisedIt of Sender {
    EF (state Main.Sent and raise output.first)
}

verification case OutputKeptBeyondTheNextStepUnreachable of Sender {
    EF (state Main.Done and raise output.first)
}
