package RegionSchedule

interface Control {
    in event go
}

@RegionSchedule = top-down
statechart TopDown [
    port control : provides Control
] {
    region Main {
        initial MainInitial
        state Parent {
            region Inner {
                initial InnerInitial
                state First
                state Second
            }
        }
        state Outside
    }

    transition from MainInitial to Parent
    transition from InnerInitial to First
    transition from Parent to Outside when control.go
    transition from First to Second when control.go
}

@RegionSchedule = bottom-up
statechart BottomUp [
    port control : provides Control
] {
    region Main {
        initial MainInitial
        state Parent {
            region Inner {
                initial InnerInitial
                state First
                state Second
            }
        }
        state Outside
    }

    transition from MainInitial to Parent
    transition from InnerInitial to First
    transition from Parent to Outside when control.go
    transition from First to Second when control.go
}

verification case BottomUpInnerTransitionFiresFirst of BottomUp {
    EF state Inner.Second
}

verification case TopDownInnerTransitionUnreachable of TopDown {
    EF state Inner.Second
}
