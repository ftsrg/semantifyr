package Cascade

interface Control {
    in event start
}

interface Link {
    in event ask
    out event answer
}

interface Finishing {
    in event start
    out event done
}

statechart Asker [
    port control : provides Control,
    port link : requires Link
] {
    region Main {
        initial MainInitial
        state Idle
        state Sent
        state Answered
    }

    transition from MainInitial to Idle
    transition from Idle to Sent when control.start / raise link.ask;
    transition from Sent to Answered when link.answer
}

statechart Answerer [
    port link : provides Link
] {
    region Main {
        initial MainInitial
        state Waiting
        state Asked
    }

    transition from MainInitial to Waiting
    transition from Waiting to Asked when link.ask / raise link.answer;
}

cascade Conversation [
    port control : provides Control
] {
    component asker : Asker
    component answerer : Answerer
    bind control -> asker.control
    channel [ answerer.link ] -o)- [ asker.link ]
    execute asker, answerer
}

cascade RepeatedConversation [
    port control : provides Control
] {
    component asker : Asker
    component answerer : Answerer
    bind control -> asker.control
    channel [ answerer.link ] -o)- [ asker.link ]
    execute asker, answerer, asker
}

statechart Counter [
    port link : provides Link
] {
    region Main {
        initial MainInitial
        state Waiting
        state Once
        state Twice
    }

    transition from MainInitial to Waiting
    transition from Waiting to Once when link.ask
    transition from Once to Twice when link.ask
}

cascade CountedConversation [
    port control : provides Control
] {
    component asker : Asker
    component counter : Counter
    bind control -> asker.control
    channel [ counter.link ] -o)- [ asker.link ]
    execute asker, counter
}

statechart Finisher [
    port control : provides Finishing
] {
    region Main {
        initial MainInitial
        state Idle
        state Finished
    }

    transition from MainInitial to Idle
    transition from Idle to Finished when control.start / raise control.done;
}

cascade TwiceFinishing [
    port control : provides Finishing
] {
    component finisher : Finisher
    bind control -> finisher.control
    execute finisher, finisher
}

sync SynchronousFinishing [
    port control : provides Finishing
] {
    component finisher : Finisher
    bind control -> finisher.control
}

cascade TwiceSynchronousFinishing [
    port control : provides Finishing
] {
    component inner : SynchronousFinishing
    bind control -> inner.control
    execute inner, inner
}

verification case LaterInstanceSeesTheEventInTheSameCycle of Conversation {
    AG (not state asker.Main.Sent or state answerer.Main.Asked)
}

verification case EarlierInstanceSeesTheReplyInALaterCycle of Conversation {
    EF state asker.Main.Answered
}

verification case ReplyInTheSameCycleWithoutASecondRunViolated of Conversation {
    AG (not state answerer.Main.Asked or state asker.Main.Answered)
}

verification case InstanceListedTwiceRunsTwiceInACycle of RepeatedConversation {
    AG (not state answerer.Main.Asked or state asker.Main.Answered)
}

verification case LaterInstanceMissingTheEventOfItsCycleUnreachable of Conversation {
    EF (state asker.Main.Sent and state answerer.Main.Waiting)
}

verification case RaiseIsDeliveredOnce of CountedConversation {
    EF state counter.Main.Once
}

verification case RaiseDeliveredTwiceUnreachable of CountedConversation {
    EF state counter.Main.Twice
}

verification case CascadeKeepsTheOutputOfAnEarlierRun of TwiceFinishing {
    EF raise finisher.control.done
}

verification case SynchronousCompositeRunTwiceKeepingTheOutputUnreachable of TwiceSynchronousFinishing {
    EF raise inner -> finisher.control.done
}
