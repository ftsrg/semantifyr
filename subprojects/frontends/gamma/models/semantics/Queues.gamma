package Queues

interface Go {
    in event go
}

interface Signals {
    out event first
    out event second
}

@Asynchronous
statechart Sender capacity (1) [
    port control : provides Go,
    port signals : provides Signals
] {
    region Main {
        initial MainInitial
        state Idle
        state Sent
    }

    transition from MainInitial to Idle
    transition from Idle to Sent when control.go / raise signals.first; raise signals.second;
}

@TransitionPriority = order-based
statechart Receiver [
    port signals : requires Signals
] {
    region Main {
        initial MainInitial
        state Waiting
        state GotFirst
        state GotSecond
        state FirstThenSecond
        state SecondThenFirst
    }

    transition from MainInitial to Waiting
    transition from Waiting to GotFirst when signals.first
    transition from Waiting to GotSecond when signals.second
    transition from GotFirst to FirstThenSecond when signals.second
    transition from GotSecond to SecondThenFirst when signals.first
}

adapter OneQueue of component receiver : Receiver {
    when any / run
    queue messages (priority = 1, capacity = 2) {
        signals.any
    }
}

adapter FullQueue of component receiver : Receiver {
    when any / run
    queue messages (priority = 1, capacity = 1) {
        signals.any
    }
}

adapter ReplacingQueue of component receiver : Receiver {
    when any / run
    queue messages (priority = 1, capacity = 1, discard = oldest) {
        signals.any
    }
}

async Ordered [
    port control : provides Go
] {
    component sender : Sender
    component receiver : OneQueue
    bind control -> sender.control
    channel [ sender.signals ] -o)- [ receiver.signals ]
}

async Dropping [
    port control : provides Go
] {
    component sender : Sender
    component receiver : FullQueue
    bind control -> sender.control
    channel [ sender.signals ] -o)- [ receiver.signals ]
}

async Replacing [
    port control : provides Go
] {
    component sender : Sender
    component receiver : ReplacingQueue
    bind control -> sender.control
    channel [ sender.signals ] -o)- [ receiver.signals ]
}

verification case MessagesAreReceivedInTheirOrder of Ordered {
    EF state receiver -> receiver.Main.FirstThenSecond
}

verification case MessagesAreReceivedInReverseUnreachable of Ordered {
    EF state receiver -> receiver.Main.SecondThenFirst
}

verification case AFullQueueDropsTheIncomingMessage of Dropping {
    AG not state receiver -> receiver.Main.FirstThenSecond
}

verification case AFullQueueDropsTheOldestMessageUnreachable of Dropping {
    EF state receiver -> receiver.Main.GotSecond
}

verification case AFullQueueDiscardingTheOldestKeepsTheNewestMessage of Replacing {
    EF state receiver -> receiver.Main.GotSecond
}

verification case AFullQueueDiscardingTheOldestKeepingItUnreachable of Replacing {
    EF state receiver -> receiver.Main.GotFirst
}
