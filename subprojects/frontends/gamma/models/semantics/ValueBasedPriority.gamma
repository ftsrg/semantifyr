package ValueBasedPriority

interface Control {
    in event go
}

@TransitionPriority = value-based
statechart Machine [
    port control : provides Control
] {
    region Main {
        initial MainInitial
        state Idle
        state Low
        state High
        state AlsoHigh
    }

    transition from MainInitial to Idle
    transition (1) from Idle to Low when control.go
    transition (2) from Idle to High when control.go
    transition (2) from Idle to AlsoHigh when control.go
}

verification case LowerPriorityNeverFires of Machine {
    AG not state Main.Low
}

verification case HighestPriorityFires of Machine {
    EF state Main.High
}

verification case EqualPrioritiesChooseNondeterministically of Machine {
    EF state Main.AlsoHigh
}
