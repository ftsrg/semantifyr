package Timeouts

statechart Machine {
    timeout short
    timeout long

    region Fast {
        initial FastInitial
        state FastWaiting {
            entry / set short := 1500 ms;
        }
        state FastDone
    }

    region Slow {
        initial SlowInitial
        state SlowWaiting {
            entry / set long := 3 s;
        }
        state SlowDone
    }

    transition from FastInitial to FastWaiting
    transition from SlowInitial to SlowWaiting
    transition from FastWaiting to FastDone when timeout short
    transition from SlowWaiting to SlowDone when timeout long
}

statechart Delayed {
    timeout tick
    timeout delay
    var seconds : integer := 0

    region Clock {
        initial ClockInitial
        state Ticking {
            entry / set tick := 1000 ms;
        }
    }

    region Main {
        initial MainInitial
        state Waiting {
            entry / set delay := 2000 ms;
        }
        state Done
        state StillUp
    }

    transition from ClockInitial to Ticking
    transition from Ticking to Ticking when timeout tick [seconds < 4] / seconds := seconds + 1;
    transition from MainInitial to Waiting
    transition from Waiting to Done when timeout delay
    transition from Done to StillUp when timeout delay
}

statechart Stepped {
    timeout beat
    timeout delay
    var steps : integer := 0
    scheduling-constraint {
        minimum-orchestrating-period : 1 s
        maximum-orchestrating-period : 1 s
    }

    region Counter {
        initial CounterInitial
        state Counting {
            entry / set beat := 500 ms;
        }
    }

    region Main {
        initial MainInitial
        state Waiting {
            entry / set delay := 2 s;
        }
        state Done
    }

    transition from CounterInitial to Counting
    transition from Counting to Counting when timeout beat [steps < 4] / steps := steps + 1;
    transition from MainInitial to Waiting
    transition from Waiting to Done when timeout delay
}

verification case TheShorterTimeoutIsUpFirst of Machine {
    EF (state Fast.FastDone and state Slow.SlowWaiting)
}

verification case TheLongerTimeoutUpFirstUnreachable of Machine {
    EF (state Slow.SlowDone and state Fast.FastWaiting)
}

verification case TimeoutIsUpAfterItsValue of Delayed {
    EF (state Main.Done and variable seconds = 2)
}

verification case OneStepPassesTheValuesOfBothTimeouts of Delayed {
    EF (state Main.Done and variable seconds = 1)
}

verification case TimeoutUpBeforeItsValueUnreachable of Delayed {
    EF (state Main.Done and variable seconds = 0)
}

verification case TimeoutStaysUpOnceUp of Delayed {
    EF (state Main.StillUp and variable seconds = 3)
}

verification case TimeoutResetOnceItFiredUnreachable of Delayed {
    EF (state Main.Done and variable seconds = 4)
}

verification case ATimeoutBelowItsValueStays of Stepped {
    EF (state Main.Waiting and variable steps = 1)
}

verification case ATimeoutExpiringBelowItsValueUnreachable of Stepped {
    EF (state Main.Done and variable steps = 1)
}

verification case ATimeoutAtItsValueMayExpire of Stepped {
    EF (state Main.Done and variable steps = 2)
}

verification case ATimeoutAtItsValueAlwaysExpiringViolated of Stepped {
    AG (not (variable steps = 2) or state Main.Done)
}

verification case ATimeoutAboveItsValueHasExpired of Stepped {
    AG (not (variable steps = 3) or state Main.Done)
}

verification case ATimeoutStayingAboveItsValueUnreachable of Stepped {
    EF (state Main.Waiting and variable steps = 3)
}
