package Timeouts

statechart Machine {
    timeout short
    timeout long

    region Fast {
        initial FastInitial
        state FastWaiting {
            entry / set short := 1500 ms;
        }
        state FastDone
    }

    region Slow {
        initial SlowInitial
        state SlowWaiting {
            entry / set long := 3 s;
        }
        state SlowDone
    }

    transition from FastInitial to FastWaiting
    transition from SlowInitial to SlowWaiting
    transition from FastWaiting to FastDone when timeout short
    transition from SlowWaiting to SlowDone when timeout long
}

verification case TheShorterTimeoutIsUpFirst of Machine {
    EF (state Fast.FastDone and state Slow.SlowWaiting)
}

verification case TheLongerTimeoutUpFirstUnreachable of Machine {
    EF (state Slow.SlowDone and state Fast.FastWaiting)
}
