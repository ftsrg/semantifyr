package Channels

interface Control {
    in event start
}

interface Request {
    in event ask
    out event answer
}

statechart Server [
    port clients : provides Request
] {
    region Main {
        initial MainInitial
        state Waiting
        state Asked
    }

    transition from MainInitial to Waiting
    transition from Waiting to Asked when clients.ask / raise clients.answer;
}

statechart Client [
    port control : provides Control,
    port server : requires Request
] {
    region Main {
        initial MainInitial
        state Idle
        state Sent
        state Answered
    }

    transition from MainInitial to Idle
    transition from Idle to Sent when control.start / raise server.ask;
    transition from Sent to Answered when server.answer
}

sync System [
    port control : provides Control
] {
    component server : Server
    component client : Client
    bind control -> client.control
    channel [ server.clients ] -o)- [ client.server ]
}

verification case RequiredPortsRaiseReachesTheProvidedPort of System {
    EF state server.Main.Asked
}

verification case ProvidedPortsRaiseReachesTheRequiredPort of System {
    EF state client.Main.Answered
}
