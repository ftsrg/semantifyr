package GuardEvaluation

interface Control {
    in event go
    in event again
}

@GuardEvaluation = beginning-of-step
statechart BeginningOfStep [
    port control : provides Control
] {
    var written : boolean := false

    region Main {
        initial MainInitial
        state Running {
            region Writer {
                initial WriterInitial
                state Waiting
                state Written
            }
            region Reader {
                initial ReaderInitial
                state Idle
                state Seen
            }
        }
    }

    transition from MainInitial to Running
    transition from WriterInitial to Waiting
    transition from ReaderInitial to Idle
    transition from Waiting to Written when control.go / written := true;
    transition from Idle to Seen when control.go [written]
}

@GuardEvaluation = on-the-fly
statechart OnTheFly [
    port control : provides Control
] {
    var written : boolean := false

    region Main {
        initial MainInitial
        state Running {
            region Writer {
                initial WriterInitial
                state Waiting
                state Written
            }
            region Reader {
                initial ReaderInitial
                state Idle
                state Seen
            }
        }
    }

    transition from MainInitial to Running
    transition from WriterInitial to Waiting
    transition from ReaderInitial to Idle
    transition from Waiting to Written when control.go / written := true;
    transition from Idle to Seen when control.go [written]
}

statechart Leaving [
    port control : provides Control
] {
    var left : boolean := false
    var looped : boolean := false

    region Main {
        initial MainInitial
        state Waiting {
            exit / left := true;
        }
        state Done
    }

    transition from MainInitial to Waiting
    transition from Waiting to Waiting when control.again / looped := true;
    transition from Waiting to Done when control.go [left]
}

verification case BeginningOfStepGuardMissesTheWriteOfItsStep of BeginningOfStep {
    EF (state Writer.Written and state Reader.Idle)
}

verification case OnTheFlyGuardMissingTheWriteOfItsStepUnreachable of OnTheFly {
    EF (state Writer.Written and state Reader.Idle)
}

verification case GuardSeesTheExitActionOfAnEarlierStep of Leaving {
    EF state Main.Done
}

verification case GuardSeeingTheExitActionOfItsOwnTransitionUnreachable of Leaving {
    EF (state Main.Done and not variable looped)
}
