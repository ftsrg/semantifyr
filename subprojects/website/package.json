{
  "name": "@ftsrg/semantifyr-website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --incremental --tsBuildInfoFile build/tsconfig.tsbuildinfo",
    "lint": "eslint --format json --output-file build/eslint.json || eslint",
    "test": "vitest run --reporter=default --reporter=junit --outputFile.junit=build/test-results/unit.xml",
    "fences": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/plugins/extractFences.ts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "assemble": "docusaurus build --out-dir build/docusaurus",
    "dev": "docusaurus start --no-open"
  },
  "dependencies": {
    "@docusaurus/core": "^3.7.0",
    "@docusaurus/faster": "^3.7.0",
    "@docusaurus/plugin-content-docs": "^3.7.0",
    "@docusaurus/plugin-content-pages": "^3.7.0",
    "@docusaurus/plugin-sitemap": "^3.7.0",
    "@docusaurus/theme-classic": "^3.7.0",
    "@docusaurus/theme-common": "^3.7.0",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@mdx-js/react": "^3.1.0",
    "@semantifyr/editor-common": "workspace:*",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shiki": "^4.6.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.7.0",
    "@docusaurus/types": "^3.7.0",
    "@docusaurus/utils": "3.10.2",
    "@mdx-js/mdx": "3.1.1",
    "@slorber/remark-comment": "1.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/mdast": "4.0.4",
    "@types/node": "^22.13.14",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "jsdom": "^29.0.0",
    "remark-directive": "3.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "vitest": "^5.0.5"
  }
}
