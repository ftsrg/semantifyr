{
  "name": "@ftsrg/semantifyr-website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc",
    "typecheck:watch": "tsc --watch",
    "lint": "eslint",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "assemble": "docusaurus build --out-dir build/docusaurus",
    "build": "npm run check && npm run assemble",
    "dev": "docusaurus start --no-open",
    "serve": "docusaurus serve --dir build/docusaurus --no-open",
    "docusaurus": "docusaurus"
  },
  "dependencies": {
    "@docusaurus/core": "^3.7.0",
    "@docusaurus/faster": "^3.7.0",
    "@docusaurus/plugin-content-docs": "^3.7.0",
    "@docusaurus/plugin-content-pages": "^3.7.0",
    "@docusaurus/plugin-sitemap": "^3.7.0",
    "@docusaurus/theme-classic": "^3.7.0",
    "@docusaurus/theme-common": "^3.7.0",
    "@mdx-js/react": "^3.1.0",
    "@semantifyr/editor-common": "*",
    "clsx": "^2.1.1",
    "lightningcss": "^1.29.3",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@codingame/monaco-vscode-api": "~37.6.1",
    "@codingame/monaco-vscode-textmate-service-override": "~37.6.1",
    "@docusaurus/module-type-aliases": "^3.7.0",
    "@docusaurus/types": "^3.7.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.13.14",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "jsdom": "^29.0.0",
    "vitest": "^5.0.5"
  }
}
