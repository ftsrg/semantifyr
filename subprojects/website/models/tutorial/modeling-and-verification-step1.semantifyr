/**
 * A traffic light that turns green for a waiting car, modelled directly in one class.
 */

enum LightColor {
    Red,
    Green,
}

class TrafficLight {
    var color: LightColor := LightColor::Red
    var carWaiting: bool := false

    redefine tran {
        havoc(carWaiting)
        choice {
            assume(color == LightColor::Red && carWaiting)
            color := LightColor::Green
        } or {
            assume(color == LightColor::Green)
            color := LightColor::Red
        } or {
        }
    }
}

@VerificationCase
class LightCanTurnGreen : TrafficLight {
    redefine prop {
        return EF (color == LightColor::Green)
    }
}
