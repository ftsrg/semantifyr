/**
 * A statechart library with time and nested states: the colors of a traffic light are substates of an operating state, beside a standby state.
 * A traffic light goes from operating to standby and back at any time.
 */

abstract class Condition {
    abstract prop isActive(): bool
}

class Sensor : Condition {
    var detects: bool := false

    redefine prop isActive(): bool {
        return detects
    }
}

class Statechart : Condition {
    contains states: State[0..*] opposite parent
    contains transitions: Transition[0..*]
    refers initial: State[0..1]

    var activeState: states[0..1] := nothing

    redefine prop isActive(): bool {
        return true
    }

    redefine init {
        inline initial?.activate()
    }

    tran passTime() {
        inline for (state in states) {
            inline state.passTime()
        }
    }

    redefine tran {
        choice {
            inline for choice (transition in transitions) {
                inline transition.main()
            }
        } or {
        }
    }
}

class State : Statechart {
    container parent: Statechart opposite states
    refers minimum: int = 0

    var time: int := 0

    redefine prop isActive(): bool {
        return parent.activeState == self
    }

    prop hasLasted(): bool {
        return time >= minimum
    }

    tran activate() {
        parent.activeState := self
        time := 0
        inline initial?.activate()
    }

    redefine tran passTime() {
        if (isActive() && time < minimum) {
            time := time + 1
        }
        inline for (state in states) {
            inline state.passTime()
        }
    }
}

class Transition {
    refers from: State
    refers to: State
    refers guards: Condition[0..*]

    @Trace
    redefine tran {
        assume(from.isActive() && from.hasLasted())
        inline for (guard in guards) {
            assume(guard.isActive())
        }
        inline to.activate()
    }
}

class System {
    contains sensors: Sensor[0..*]
    contains parts: Statechart[0..*]

    redefine init {
        inline for (part in parts) {
            inline part.init()
        }
    }

    redefine tran {
        inline for (sensor in sensors) {
            havoc(sensor.detects)
        }
        inline for (part in parts) {
            inline part.passTime()
        }
        inline for choice (part in parts) {
            inline part.main()
        }
    }
}

class TrafficLight : Statechart {
    refers sensor: Sensor
    refers waitsFor: State[0..*]

    contains operating: State subsets states {
        contains red: State subsets states
        contains yellow: State subsets states
        contains green: State subsets states {
            redefine refers minimum: int = 3
        }

        redefine refers initial: State[0..1] = red
    }
    contains standby: State subsets states

    redefine refers initial: State[0..1] = operating

    contains redToGreen: Transition subsets transitions {
        redefine refers from: State = operating.red
        redefine refers to: State = operating.green
        refers carWaiting: Condition subsets guards = sensor
        refers crossingClear: Condition[0..*] subsets guards = waitsFor
    }
    contains greenToYellow: Transition subsets transitions {
        redefine refers from: State = operating.green
        redefine refers to: State = operating.yellow
    }
    contains yellowToRed: Transition subsets transitions {
        redefine refers from: State = operating.yellow
        redefine refers to: State = operating.red
    }
    contains operatingToStandby: Transition subsets transitions {
        redefine refers from: State = operating
        redefine refers to: State = standby
    }
    contains standbyToOperating: Transition subsets transitions {
        redefine refers from: State = standby
        redefine refers to: State = operating
    }
}

class PedestrianLight : Statechart {
    refers button: Sensor
    refers trafficStopped: State

    contains stop: State subsets states
    contains walk: State subsets states

    redefine refers initial: State[0..1] = stop

    contains stopToWalk: Transition subsets transitions {
        redefine refers from: State = stop
        redefine refers to: State = walk
        refers pressed: Condition subsets guards = button
        refers trafficClear: Condition subsets guards = trafficStopped
    }
    contains walkToStop: Transition subsets transitions {
        redefine refers from: State = walk
        redefine refers to: State = stop
    }
}

class Junction : System {
    contains northSensor: Sensor subsets sensors
    contains eastSensor: Sensor subsets sensors
    contains pushButton: Sensor subsets sensors

    contains north: TrafficLight subsets parts {
        redefine refers sensor: Sensor = northSensor
        refers eastStopped: State subsets waitsFor = east.operating.red
    }
    contains east: TrafficLight subsets parts {
        redefine refers sensor: Sensor = eastSensor
        refers northStopped: State subsets waitsFor = north.operating.red
        refers pedestriansStopped: State subsets waitsFor = pedestrians.stop
    }
    contains pedestrians: PedestrianLight subsets parts {
        redefine refers button: Sensor = pushButton
        redefine refers trafficStopped: State = east.operating.red
    }
}

@VerificationCase
class NorthCanTurnGreen : Junction {
    redefine prop {
        return EF north.operating.green.isActive()
    }
}

@VerificationCase
class NeverBothGreen : Junction {
    redefine prop {
        return AG !(north.operating.green.isActive() && east.operating.green.isActive())
    }
}

@VerificationCase
class NorthGreenOnlyWhileEastRed : Junction {
    redefine prop {
        return AG (!north.operating.green.isActive() || east.operating.red.isActive())
    }
}

@VerificationCase
class PedestriansCanWalk : Junction {
    redefine prop {
        return EF pedestrians.walk.isActive()
    }
}

@VerificationCase
class WalkOnlyWhileEastRed : Junction {
    redefine prop {
        return AG (!pedestrians.walk.isActive() || east.operating.red.isActive())
    }
}

@VerificationCase
class NorthGreenForThreeSteps {
    contains junction: Junction
    refers required: int = 3

    var stepsGreen: int := 0
    var leftGreenEarly: bool := false

    redefine init {
        inline junction.init()
    }

    redefine tran {
        var wasGreen: bool := junction.north.operating.green.isActive()
        inline junction.main()
        if (junction.north.operating.green.isActive()) {
            if (stepsGreen < required) {
                stepsGreen := stepsGreen + 1
            }
        } else {
            if (wasGreen && stepsGreen < required) {
                leftGreenEarly := true
            }
            stepsGreen := 0
        }
    }

    redefine prop {
        return AG !leftGreenEarly
    }
}

@VerificationCase
class NorthCanTurnYellow : Junction {
    redefine prop {
        return EF north.operating.yellow.isActive()
    }
}

@VerificationCase
class NorthCanStandBy : Junction {
    redefine prop {
        return EF north.standby.isActive()
    }
}

@VerificationCase
class NorthNeverGreenInStandby : Junction {
    redefine prop {
        return AG !(north.standby.isActive() && north.operating.green.isActive())
    }
}
