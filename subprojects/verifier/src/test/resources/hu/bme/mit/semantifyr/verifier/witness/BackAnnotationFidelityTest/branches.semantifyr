package semantifyr::verification::report::branches

@VerificationCase
class ChoiceBranchReach {
    var branch: int := 0

    redefine tran {
        choice {
            branch := 1
        } or {
            branch := 2
        }
    }

    redefine prop {
        return EF branch == 1
    }
}
