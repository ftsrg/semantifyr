package semantifyr::verification::report::nested_calls

class Lamp {
    var on: bool := false

    @Trace
    tran toggle() {
        on := !on
    }
}

class Panel {
    contains first: Lamp
    contains second: Lamp

    @Trace
    tran press() {
        inline second.toggle()
        inline first.toggle()
    }
}

@VerificationCase
class PanelPress {
    contains panel: Panel

    redefine tran {
        inline panel.press()
    }

    redefine prop {
        return EF (panel.first.on)
    }
}
