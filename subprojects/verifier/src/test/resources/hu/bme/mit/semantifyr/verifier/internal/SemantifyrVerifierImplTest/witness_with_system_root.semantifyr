witness of semantifyr::verification::simple::Incrementing

var step: int := 0

contains system: semantifyr::verification::simple::Incrementing

init {
    assume(step == 0)
    inline system.init()
    assume(system.x == 1)
    step := 1
}

tran {
    assume(step == 1)
    inline system.main()
    assume(system.x == 2)
    step := 2
}

prop {
    system.prop()
}
