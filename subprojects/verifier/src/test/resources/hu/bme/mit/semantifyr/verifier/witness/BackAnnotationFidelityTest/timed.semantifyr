package semantifyr::verification::report::timed

class Timer {
    var elapsed: clock := 0
    var fired: bool := false

    tran fire() {
        assume(elapsed >= 2)
        fired := true
    }
}

@VerificationCase
class TimerFires {
    contains timer: Timer

    redefine tran {
        inline timer.fire()
    }

    redefine prop {
        return EF (timer.fired)
    }
}
