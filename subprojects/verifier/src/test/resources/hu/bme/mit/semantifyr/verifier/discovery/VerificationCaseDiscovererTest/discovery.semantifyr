package verifier::discovery

class Counter {
    var count: int := 0
}

@VerificationCase
@Tag("expect-pass")
class Passing {
    redefine prop {
        return AG true
    }
}

@VerificationCase
@Tag("expect-fail")
class Failing {
    redefine prop {
        return AG false
    }
}
