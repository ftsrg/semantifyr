{
  "name": "@ftsrg/semantifyr-live-frontend",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "typecheck": "tsc",
    "typecheck:watch": "tsc --watch",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "vitest run --config vitest.smoke.config.ts",
    "screens": "vitest run --config vitest.screen.config.ts",
    "load-test": "node --disable-warning=ExperimentalWarning src/__load__/main.ts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "assemble": "vite build",
    "build": "npm run check && npm run assemble",
    "dev": "vite",
    "preview": "vite preview --port 5173 --host"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@semantifyr/editor-common": "*",
    "iso8601-duration": "^2.1.3",
    "monaco-editor": "npm:@codingame/monaco-vscode-editor-api@~37.6.1",
    "monaco-languageclient": "~11.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vscode": "npm:@codingame/monaco-vscode-extension-api@~37.6.1",
    "vscode-languageclient": "~10.1.2",
    "vscode-ws-jsonrpc": "~4.0.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/browser-playwright": "^5.0.5",
    "jsdom": "^29.0.0",
    "playwright": "^1.65.0",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "monaco-editor": "npm:@codingame/monaco-vscode-editor-api@~37.6.1"
  }
}
