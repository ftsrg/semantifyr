package concurrent

@VerificationCase
class ReachesThree {
    var x: int := 0

    redefine tran {
        if (x < 3) {
            x := x + 1
        }
    }

    redefine prop {
        return EF x == 3
    }
}

@VerificationCase
class ReachesTwo {
    var x: int := 0

    redefine tran {
        if (x < 2) {
            x := x + 1
        }
    }

    redefine prop {
        return EF x == 2
    }
}

@VerificationCase
class StaysBelowThree {
    var x: int := 0

    redefine tran {
        if (x < 3) {
            x := x + 1
        }
    }

    redefine prop {
        return AG x < 3
    }
}
