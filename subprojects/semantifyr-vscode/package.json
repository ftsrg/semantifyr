{
  "name": "semantifyr",
  "displayName": "Semantifyr",
  "description": "Edit and verify OXSTS and Gamma models with Semantifyr, a framework to support the declarative definition of engineering model semantics.",
  "version": "0.0.0",
  "type": "module",
  "publisher": "ftsrg",
  "license": "EPL-2.0",
  "author": {
    "name": "The Semantifyr Authors",
    "url": "https://github.com/ftsrg/semantifyr/blob/main/CONTRIBUTORS.md"
  },
  "homepage": "https://semantifyr.org/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ftsrg/semantifyr.git",
    "directory": "subprojects/semantifyr-vscode"
  },
  "bugs": {
    "url": "https://github.com/ftsrg/semantifyr/issues"
  },
  "icon": "icons/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters",
    "Testing"
  ],
  "keywords": [
    "semantifyr",
    "oxsts",
    "gamma",
    "formal verification",
    "model checking",
    "theta",
    "language server"
  ],
  "files": [
    "dist/extension.cjs",
    "bin",
    "syntaxes/*.json",
    "language-configuration.json",
    "icons/icon.png",
    "icons/semantifyr-file-icon.png",
    "icons/gamma-file-icon.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "workspaceContains:**/*.oxsts",
    "workspaceContains:**/*.gamma"
  ],
  "contributes": {
    "commands": [
      {
        "command": "semantifyr.gamma.compile",
        "title": "Compile Gamma File",
        "category": "Semantifyr"
      },
      {
        "command": "semantifyr.witness.show",
        "title": "Show Witness",
        "category": "Semantifyr"
      },
      {
        "command": "semantifyr.witness.validate",
        "title": "Validate Witness",
        "category": "Semantifyr"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "semantifyr.gamma.compile",
          "when": "resourceExtname == .gamma",
          "group": "semantifyr"
        }
      ],
      "commandPalette": [
        {
          "command": "semantifyr.witness.show",
          "when": "false"
        },
        {
          "command": "semantifyr.witness.validate",
          "when": "false"
        }
      ],
      "testing/item/context": [
        {
          "command": "semantifyr.witness.show",
          "when": "controllerId == oxsts.verification || controllerId == gamma.verification"
        },
        {
          "command": "semantifyr.witness.validate",
          "when": "controllerId == oxsts.verification || controllerId == gamma.verification"
        }
      ],
      "testing/message/content": [
        {
          "command": "semantifyr.witness.show",
          "when": "testMessage =~ /^semantifyr\\.witness/"
        },
        {
          "command": "semantifyr.witness.validate",
          "when": "testMessage == semantifyr.witness.validatable"
        }
      ],
      "testing/message/context": [
        {
          "command": "semantifyr.witness.show",
          "when": "testMessage =~ /^semantifyr\\.witness/"
        },
        {
          "command": "semantifyr.witness.validate",
          "when": "testMessage == semantifyr.witness.validatable"
        }
      ]
    },
    "languages": [
      {
        "id": "oxsts",
        "extensions": [
          ".oxsts"
        ],
        "aliases": [
          "OXSTS",
          "oxsts"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/semantifyr-file-icon.png",
          "dark": "./icons/semantifyr-file-icon.png"
        }
      },
      {
        "id": "gamma",
        "extensions": [
          ".gamma"
        ],
        "aliases": [
          "Gamma",
          "gamma"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/gamma-file-icon.png",
          "dark": "./icons/gamma-file-icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "oxsts",
        "scopeName": "source.oxsts",
        "path": "./syntaxes/oxsts.tmLanguage.json"
      },
      {
        "language": "gamma",
        "scopeName": "source.gamma",
        "path": "./syntaxes/gamma.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Semantifyr",
      "properties": {
        "semantifyr.portfolio": {
          "type": "string",
          "default": "smart",
          "enum": [
            "smart",
            "all-agree",
            "theta",
            "theta-cegar-expl",
            "theta-cegar-expl-pred-combined",
            "theta-cegar-pred-cart",
            "theta-bounded-kinduction",
            "theta-bounded-bmc",
            "theta-bounded-imc",
            "theta-ic3",
            "uppaal-default",
            "uppaal-breadth-first",
            "uppaal-depth-first",
            "uppaal-random-depth-first",
            "uppaal-over-approximation",
            "uppaal-under-approximation",
            "uppaal-under-approximation-large",
            "uppaal-aggressive-inclusion",
            "nuxmv-ic3-invar",
            "nuxmv-bmc-invar",
            "nuxmv-bdd-invar",
            "spin-exhaustive-dfs",
            "spin-exhaustive-bfs",
            "spin-safe-dfs",
            "spin-fast-dfs",
            "spin-collapse",
            "spin-bitstate",
            "spin-hash-compact"
          ],
          "markdownDescription": "The portfolio a verification runs, the strategy for the backend runs. The default `smart` runs the installed backends side by side and takes the first trusted answer, so one backend is enough; `all-agree` runs every installed backend and requires their trusted answers to agree; each other entry runs one configuration of one backend. A witness is validated on `semantifyr.verification.validationPortfolio`, which is this portfolio unless it names another."
        },
        "semantifyr.timeoutSeconds": {
          "type": "number",
          "default": 300,
          "minimum": 1,
          "markdownDescription": "Wall-clock timeout per case, in seconds. It covers the case's compilation, every backend run of the portfolio and the back-annotation of the witness."
        },
        "semantifyr.verification.autoValidate": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Validate the witness of every result that carries one, right after the verification: the witness is verified again on `semantifyr.verification.validationPortfolio`, and the result goes into the test message and the trace."
        },
        "semantifyr.verification.validationPortfolio": {
          "type": "string",
          "default": "",
          "markdownDescription": "The portfolio that validates a witness, by id as `semantifyr.portfolio` takes it. Empty uses `semantifyr.portfolio`."
        },
        "semantifyr.theta.executor": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "shell",
            "docker"
          ],
          "markdownDescription": "Which Theta executor to use. `auto` picks shell first then Docker; `shell` requires `theta-xsts-cli` on PATH; `docker` uses the configured image."
        },
        "semantifyr.theta.dockerImage": {
          "type": "string",
          "default": "ftsrg/theta-xsts-cli:8.6.0",
          "markdownDescription": "Docker image reference (repository:tag or @digest) for the Theta image. Only used when `semantifyr.theta.executor` is `docker`."
        },
        "semantifyr.artifacts.location": {
          "type": "string",
          "default": "temporary",
          "enum": [
            "temporary",
            "workspace"
          ],
          "markdownDescription": "Where the language servers write the artifacts of a verification. `temporary`: one temporary directory per language server, deleted when it exits; `workspace`: `<workspace>/.artifacts/`, kept."
        },
        "semantifyr.artifacts.preset": {
          "type": "string",
          "default": "all",
          "enum": [
            "none",
            "all",
            "debug"
          ],
          "markdownDescription": "Which artifacts are written: `none`, `all` (the models, the witness, the trace, the mapping and the report), or `debug`, which also writes the model after every compiler pass and is slow."
        },
        "semantifyr.optimization.level": {
          "type": "string",
          "default": "all",
          "enum": [
            "none",
            "all"
          ],
          "markdownDescription": "Compiler optimization preset. `none` turns off the optional passes, while the simplification of each inlined call and the normalization of the property still run; `all` enables the default bundle."
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc",
    "typecheck:watch": "tsc --watch",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node src/__integration__/run.mjs",
    "check": "npm run typecheck && npm run lint && npm run test",
    "assemble": "node esbuild.mjs",
    "assemble:watch": "node esbuild.mjs --watch",
    "assemble:production": "node esbuild.mjs --minify",
    "build": "npm run check && npm run assemble",
    "bundle": "npm run assemble:production && vsce package --no-dependencies --out build/",
    "dev": "concurrently -k \"npm run typecheck:watch\" \"npm run assemble:watch\""
  },
  "dependencies": {
    "@semantifyr/editor-common": "*",
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "@types/vscode": "~1.109.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.2",
    "concurrently": "^9.0.0",
    "esbuild": "^0.25.0",
    "vitest": "^5.0.5",
    "vscode-jsonrpc": "^10.0.0",
    "vscode-languageserver-protocol": "^3.18.5"
  }
}
