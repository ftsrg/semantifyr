{
  "scopeName": "source.oxsts",
  "name": "Oxsts",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#string"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#literals"
    }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.oxsts",
          "match": "\\b(AG|EF|abstract|annotation|as|assume|choice|class|container|contains|datatype|derived\\s+refers|else|enum|extern|features|for|global\\s+containment|global\\s+reference|havoc|if|import|in|init|inline|inlined|of|opposite|or|oxsts|package|prop|record|redefine|redefines|refers|return|seq|subsets|then|tran|var|witness)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.oxsts",
          "match": "(==|!=|<=|>=|&&|\\|\\||\\^\\^|\\.\\.<|\\.\\.|\\?\\.|<|>|\\+|-|\\*|/|!)"
        },
        {
          "name": "keyword.operator.assignment.oxsts",
          "match": ":="
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.numeric.oxsts",
          "match": "\\b(\\d+\\.\\d+|\\d+)\\b"
        },
        {
          "name": "constant.language.boolean.oxsts",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.contextual.oxsts",
          "match": "\\b(nothing|self)\\b"
        }
      ]
    },
    "string": {
      "comment": "\"begin\" & \"end\" can create a multi-line region",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.languageId"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.languageId"
        }
      },
      "name": "string.quoted.double.languageId",
      "patterns": [
        {
          "comment": "Quad backslash required to match one literal backslash",
          "match": "\\\\.",
          "name": "constant.character.escape.languageId"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.oxsts",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.oxsts",
          "match": "//.*$"
        }
      ]
    }
  }
}
