{
  "scopeName": "source.gamma",
  "name": "gamma",
  "patterns": [
    {
      "include": "#annotations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#types"
    },
    {
      "include": "#literals"
    },
    {
      "include": "#comments"
    }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.xsts",
          "match": "\\b(package|import|type|record|interface|extends|in|out|inout|transient|persistent|event|sync|cascade|execute|component|provides|requires|port|bind|channel|statechart|var|timeout|region|initial|shallow|history|state|entry|exit|transition|from|to|when|raise|set|ms|s|verification|case|property|trace|of|step|act|assert|reset|schedule|elapse|variable|self|and|or|not|AG|EF)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.xsts",
          "match": "(-o\\)-|->|::|==|!=|/=|<=|>=|<|>|=|\\+|-|\\*|/|!)"
        },
        {
          "name": "keyword.operator.assignment.xsts",
          "match": ":="
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.xsts",
          "match": "\\b(integer|boolean)\\b"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.numeric.xsts",
          "match": "\\b\\d+\\b"
        },
        {
          "name": "constant.language.boolean.xsts",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.xsts",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.xsts",
          "match": "//.*$"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "storage.modifier.annotation.gamma",
          "match": "@(RegionSchedule|TransitionPriority|GuardEvaluation)\\b|@\\("
        },
        {
          "name": "constant.language.gamma",
          "match": "\\b(top-down|bottom-up|off|order-based|value-based|on-the-fly|beginning-of-step)\\b"
        }
      ]
    }
  }
}
