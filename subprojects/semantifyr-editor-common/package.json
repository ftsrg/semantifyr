{
  "name": "@semantifyr/editor-common",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./examples": "./src/examples/examples.ts",
    "./marks": "./src/look/marks.tsx",
    "./marks.css": "./src/look/marks.css",
    "./syntax": "./src/look/syntax.ts",
    "./terms": "./src/terms/terms.ts",
    "./tokens.css": "./src/look/tokens.css"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --incremental --tsBuildInfoFile build/tsconfig.tsbuildinfo",
    "typecheck:watch": "tsc --watch",
    "lint": "eslint --format json --output-file build/eslint.json || eslint",
    "test": "vitest run --reporter=default --reporter=junit --outputFile.junit=build/test-results/unit.xml",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
