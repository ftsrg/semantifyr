/*
 * The standard library, in scope in every file without an import. It declares the primitive datatypes, `Anything`, and the annotations the tools read.
 */
package semantifyr

/*
 * The supertype of every type: every value fits where `any` stands.
 */
extern datatype any

/*
 * The mathematical integers, with no fixed width.
 */
extern datatype int

/*
 * The real numbers.
 */
extern datatype real

/*
 * The Boolean values `true` and `false`.
 */
extern datatype bool

/*
 * Strings of characters, such as `"hello"`.
 */
extern datatype string

/*
 * A clock measures time: it starts at 0, advances by the wait before every main step, is reset to 0 by assignment, and is read only in comparisons with integers known at compile time.
 */
extern datatype clock

/*
 * The implicit superclass of every class.
 */
class Anything {
    /*
     * The main transition every class inherits, which defines the steps of the system.
     */
    tran {
    }

    /*
     * The `init` every class inherits, which initializes the system.
     */
    init {
    }

    /*
     * The property every class inherits, which a verification case checks.
     */
    prop {
        return AG true
    }
}

/*
 * Marks a class as a verification case. The optional `summary` is shown for the case in place of its name.
 */
annotation VerificationCase(summary: string[0..1])

/*
 * Gives a verification case a category, such as `@Tag("slow")`, by which the command line selects and skips cases.
 */
annotation Tag(category: string)

/*
 * Marks a variable a backend may track from the start of its search: a hint for speed that changes neither the verdict nor the trace.
 */
annotation Control

/*
 * Marks a containment whose one instance is shared by every instance of the declaring class, instead of one each.
 */
annotation Shared

/*
 * Marks a transition whose calls the trace lists, each in the step it fired in, with its receiver's path from the root instance, such as `root.kitchen.lamp`, and its arguments' values. No argument of a call to a traced transition may be a record.
 */
annotation Trace

/*
 * Keeps a variable from the optimizations that could remove or fold it, so that it stays in the compiled model and the witness.
 */
annotation NonOptimizable
