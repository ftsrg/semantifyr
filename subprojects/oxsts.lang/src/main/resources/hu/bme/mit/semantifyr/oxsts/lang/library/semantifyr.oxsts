/*
 * The standard library, in scope in every file without an import, below the file's own package and its imports. It declares the primitive datatypes, `Anything`, the base class of every class, and the annotations the tools read.
 */
package semantifyr

/*
 * The supertype of every type.
 */
extern datatype any

/*
 * Integer numbers.
 */
extern datatype int

/*
 * Real numbers.
 */
extern datatype real

/*
 * The Boolean values `true` and `false`.
 */
extern datatype bool

/*
 * Sequences of characters.
 */
extern datatype string

/*
 * The implicit supertype of every class. Its `init` and its main transition do nothing, and a class that declares its own replaces them, with or without `redefine`.
 */
class Anything {
    // contains children: Anything[0..*] opposite parent;
    // container parent: Anything[0..1] opposite children;
    /*
     * The base main transition.
     */
    tran {
    }

    /*
     * The base init transition.
     */
    init {
    }
}

/*
 * Marks a class as a verification case, which the tools find and verify. The optional `summary` is the text the editors show for the case in place of its name.
 */
annotation VerificationCase(summary: string[0..1])

/*
 * Gives a verification case a category, such as `@Tag("slow")`, by which the command line selects and skips cases.
 */
annotation Tag(category: string)

/*
 * Marks a variable that a backend may track from the start of its search. It is a hint for the backend's speed and changes neither the verdict nor the trace.
 */
annotation Control

/*
 * Marks a containment feature whose instance is created once in a model and shared by every instance of the class that declares the feature, instead of once for each.
 */
annotation Shared

/*
 * Marks a transition whose calls the trace lists: each call that fired, in the step it fired in, with its receiver's path from the root instance, such as `root.kitchen.lamp`, and the values of its arguments at the call site.
 * 
 * The trace records the arguments as the compiler evaluates them, so every argument of a call to a traced transition must be evaluable at compile time (`OXSTS.EXPRESSION_MODALITY_TOO_HIGH`), and none may be a record (`OXSTS.UNSUPPORTED_FEATURE`).
 */
annotation Trace

/*
 * Marks a variable as a clock, which a backend with clocks may represent as one. Like every variable, a clock carries an initializer.
 */
annotation Clock

/*
 * Excludes a variable from the optimizer passes that could remove or fold it, so that it stays in the model a backend receives and in the witness.
 */
annotation NonOptimizable
