package test

class Item
class Port {
    refers capacity: int
    contains first: Item
    var fixedItems: Item[0..2] := [nothing, nothing]
    var items: Item[0..capacity] := [nothing, ...]
    var index: int := 0
    redefine tran {
        var current: Item[0..1] := first
        fixedItems[0] := nothing
        fixedItems[index] := current
        items[index] := nothing
        items[0] := current
    }
}
