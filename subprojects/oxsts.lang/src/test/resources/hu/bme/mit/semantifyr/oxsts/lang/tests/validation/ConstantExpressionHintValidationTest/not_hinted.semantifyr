package test

enum LightColor {
    Red,
    Green
}

class Counter {
    refers size: int = 3
    refers offset: int = -3
    refers doubleSize: int = size * 2
    var color: LightColor := LightColor::Red
    var count: int := 0

    redefine tran {
        count := size
        count := count + 1
        color := LightColor::Green
        inline for (index in 0..2) {
            count := index
        }
    }
}
