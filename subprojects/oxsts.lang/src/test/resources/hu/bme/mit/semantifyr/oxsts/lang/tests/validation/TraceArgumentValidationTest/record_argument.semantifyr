package test

record Point {
    var x: int := 0
}
class Port {
    var item: int := 0
    @Trace
    tran send(point: Point) {
        item := point.x
    }
}
class Host {
    var position: Point := Point { x = 1 }
    contains port: Port
    tran relay(point: Point) {
        inline port.send(point)
    }
    redefine tran {
        inline port.send(Point { x = 2 })
        inline port.send(position)
        inline relay(position)
    }
}
