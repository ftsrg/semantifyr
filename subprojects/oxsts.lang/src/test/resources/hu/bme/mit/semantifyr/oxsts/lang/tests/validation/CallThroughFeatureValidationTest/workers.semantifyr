package test

class Worker {
    var done: bool := false
    tran step() {
        done := true
    }
    prop isDone(): bool {
        return done
    }
}
class Team {
    contains workers: Worker[0..*]
    contains first: Worker subsets workers
    contains second: Worker subsets workers
    contains spare: Worker[0..1]
}
