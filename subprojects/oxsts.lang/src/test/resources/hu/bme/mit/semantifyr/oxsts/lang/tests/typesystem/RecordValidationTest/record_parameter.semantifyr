package test

record Point {
    var x: int := 0
}
record Size {
    var x: int := 0
}
class Holder {
    var position: Point := Point { x = 1 }
    var size: Size := Size { x = 1 }
    var sum: int := 0
    tran add(point: Point) {
        sum := sum + point.x
    }
    redefine tran {
        inline add(position)
        inline add(Point { x = 2 })
        inline add(size)
    }
}
