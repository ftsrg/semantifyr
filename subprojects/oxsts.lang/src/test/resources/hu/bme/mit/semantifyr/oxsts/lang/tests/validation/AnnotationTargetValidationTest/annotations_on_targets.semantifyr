package test

class Item {
}
@VerificationCase
@Tag("slow")
class Case {
    @Shared
    contains item: Item
    @Control
    @NonOptimizable
    var count: int := 0
    @Trace
    tran step() {
        count := count + 1
    }
    redefine prop {
        return AG count >= 0
    }
}
