class Factory {
    contains workers: Worker[2]
    var count: int := 0

    redefine tran {
        inline if (1 < 2) {
            count := 1
        }
        inline for (worker in workers) {
            inline worker.step()
        }
        inline for choice (index in 0..2) {
            count := index
        }
    }
}
