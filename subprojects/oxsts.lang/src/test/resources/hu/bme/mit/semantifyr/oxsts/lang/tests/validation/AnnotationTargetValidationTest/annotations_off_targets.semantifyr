package test

class Item {
}
@Control
class Holder {
    @VerificationCase
    var count: int := 0
    @Shared
    refers other: Item[0..1]
    @Trace
    prop positive(): bool {
        return count > 0
    }
    @Tag("slow")
    tran step() {
        count := count + 1
    }
}
