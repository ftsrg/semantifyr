package untemporal

@VerificationCase
class Untemporal {
    var counter: int := 0

    redefine tran {
        counter := 1
    }

    redefine prop {
        return counter == 1
    }
}

@VerificationCase
class Temporal {
    var counter: int := 0

    redefine tran {
        counter := 1
    }

    redefine prop {
        return EF counter == 1
    }
}
