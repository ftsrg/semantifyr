package example::library

annotation Brightness(level: int, label: string)

enum LightColor {
    Red,
    Green
}

class Lamp {
    var on: bool := false
    var level: int := 0

    tran toggle() {
        self.on := !self.on
    }

    tran set(level: int, step: int) {
        self.level := level + step
    }

    prop isOn(): bool {
        return self.on
    }

    prop isAt(level: int): bool {
        return self.level == level
    }
}
