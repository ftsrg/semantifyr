@VerificationCase
class Host {
    contains workers: Worker[0..*]
    contains first: Worker[1] subsets workers
    contains second: Worker[1] subsets workers
    var current: workers[0..1] := nothing
    tran run(worker: Worker[0..1]) {
        inline worker?.step()
    }
    redefine init {
        current := first
    }
    redefine tran {
        inline run(current)
    }
    redefine prop {
        return EF first.done
    }
}
