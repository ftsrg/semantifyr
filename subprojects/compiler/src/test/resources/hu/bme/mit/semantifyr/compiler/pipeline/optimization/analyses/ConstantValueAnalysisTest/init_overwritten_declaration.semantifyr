inlined oxsts of semantifyr::Anything
var overwritten: int := 0
var copy: int := 3
init {
    choice {
        overwritten := 3
    } or {
        overwritten := 3
    }
}
tran {
    copy := overwritten
}
prop {
    AG (copy == 3)
}
