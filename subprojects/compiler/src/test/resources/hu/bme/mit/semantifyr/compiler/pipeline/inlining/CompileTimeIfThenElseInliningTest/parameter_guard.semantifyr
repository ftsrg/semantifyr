package inlining::tests::compile_time_if_then_else_parameters

@VerificationCase
class Case {
    var value: int := 0
    var result: int := 0
    tran put(limit: int) {
        result := if limit > 0 then 1 else 2
    }
    prop above(limit: int): bool {
        return if limit > 0 then result == 1 else result == 2
    }
    redefine tran {
        havoc(value)
        inline put(3)
        inline put(value)
    }
    redefine prop {
        return AG (above(value) || above(1))
    }
}
