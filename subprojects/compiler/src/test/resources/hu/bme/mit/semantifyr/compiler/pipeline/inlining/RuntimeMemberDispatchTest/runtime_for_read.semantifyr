@VerificationCase
class Host {
    contains workers: Worker[0..*]
    contains first: Worker[1] subsets workers
    contains second: Worker[1] subsets workers
    var count: int := 0
    redefine tran {
        for (worker in workers) {
            if (worker.done) {
                count := count + 1
            }
        }
    }
    redefine prop {
        return EF count == 2
    }
}
