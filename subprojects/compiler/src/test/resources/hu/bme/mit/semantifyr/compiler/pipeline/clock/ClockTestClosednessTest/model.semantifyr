package clock::tests::closedness

class Timer {
    var elapsed: clock := 0
    var early: bool := false

    tran restart() {
        elapsed := 0
    }

    tran check() {
        if (elapsed < 1) {
            early := true
        }
    }
}

@VerificationCase
class DispatchedDeadline {
    contains first: Timer
    contains second: Timer
    var current: Timer := first

    redefine tran {
        assume(current.elapsed <= 5)
        choice {
            current := first
        } or {
            current := second
        }
    }

    redefine prop {
        return AG true
    }
}

@VerificationCase
class DispatchedStrictTest {
    contains first: Timer
    contains second: Timer
    var current: Timer := first

    redefine tran {
        assume(current.elapsed < 5)
    }

    redefine prop {
        return AG true
    }
}

@VerificationCase
class RestartThenCheck {
    contains timer: Timer

    redefine tran {
        inline timer.restart()
        inline timer.check()
    }

    redefine prop {
        return AG true
    }
}
