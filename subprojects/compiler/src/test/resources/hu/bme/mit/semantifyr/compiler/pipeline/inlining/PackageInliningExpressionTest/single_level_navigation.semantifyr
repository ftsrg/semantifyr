package inlining::tests::expr_single_nav

class Worker {
    var done: bool := false
    prop isDone(): bool {
        return done
    }
}
@VerificationCase
class Host {
    contains worker: Worker[1]
    redefine tran {
        worker.done := true
    }
    redefine prop {
        return EF worker.isDone()
    }
}
