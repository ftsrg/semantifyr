package inlining::tests

class Leaf {
    var value: int := 0
    tran bump() {
        value := value + 1
    }
}
class Middle {
    contains leaf: Leaf[1]
}
@VerificationCase
class Host {
    contains middle: Middle[1]
    redefine tran {
        inline middle.leaf.bump()
    }
    redefine prop {
        return EF middle.leaf.value == 1
    }
}
