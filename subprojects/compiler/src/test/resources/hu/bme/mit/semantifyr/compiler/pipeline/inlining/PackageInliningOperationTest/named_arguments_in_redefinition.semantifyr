package inlining::tests

abstract class Base {
    abstract tran set(first: int, second: int)
}
class Leaf : Base {
    var left: int := 0
    var right: int := 0
    redefine tran set(first: int, second: int) {
        left := first
        right := second
    }
}
@VerificationCase
class Host {
    contains leaf: Leaf[1]
    redefine tran {
        inline leaf.set(second = 2, first = 1)
    }
    redefine prop {
        return EF leaf.left == 1
    }
}
