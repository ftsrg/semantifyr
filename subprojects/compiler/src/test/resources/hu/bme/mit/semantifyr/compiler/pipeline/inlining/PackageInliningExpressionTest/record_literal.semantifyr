package inlining::tests::record_literal

record Point {
    var x: int := 0
    var y: int := 0
}
@VerificationCase
class Host {
    var position: Point := Point { x = 0 }
    prop next(): int {
        return position.x + 1
    }
    tran moveTo(target: Point) {
        position := target
    }
    redefine tran {
        inline moveTo(Point { x = next() })
    }
    redefine prop {
        return AG position != Point { x = next(), y = 2 }
    }
}
