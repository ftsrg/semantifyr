inlined oxsts of semantifyr::Anything
var observed: int := 0
var guard: int := 0
init {
}
tran {
    assume(guard == 1)
    choice {
        observed := 1
    } or {
        observed := 2
    }
}
prop {
    AG (observed == 1)
}
