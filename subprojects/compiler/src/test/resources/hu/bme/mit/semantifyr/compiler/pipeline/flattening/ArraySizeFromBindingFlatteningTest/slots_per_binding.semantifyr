@VerificationCase
class Host {
    contains one: Store {
        redefine refers capacity: int = 1
    }
    contains three: Store {
        redefine refers capacity: int = 3
    }
    redefine tran {
        inline one.put(1)
        inline three.put(2)
    }
    redefine prop {
        return AG one.slots[0] != 5
    }
}
