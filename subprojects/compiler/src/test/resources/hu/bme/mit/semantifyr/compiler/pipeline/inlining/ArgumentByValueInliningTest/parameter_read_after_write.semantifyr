package inlining::tests

@VerificationCase
class Host {
    var counter: int := 0
    var previous: int := 0
    tran increment(old: int) {
        counter := counter + 1
        previous := old
    }
    redefine tran {
        inline increment(counter)
    }
    redefine prop {
        return AG previous < counter
    }
}
