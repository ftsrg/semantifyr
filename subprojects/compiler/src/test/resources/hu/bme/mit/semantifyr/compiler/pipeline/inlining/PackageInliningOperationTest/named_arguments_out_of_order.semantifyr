package inlining::tests

@VerificationCase
class Host {
    var left: int := 0
    var right: int := 0
    tran set(first: int, second: int) {
        left := first
        right := second
    }
    redefine tran {
        inline set(second = 2, first = 1)
    }
    redefine prop {
        return EF left == 1
    }
}
