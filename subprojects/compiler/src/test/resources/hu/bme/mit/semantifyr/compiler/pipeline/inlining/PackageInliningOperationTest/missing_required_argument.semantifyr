package inlining::tests

abstract class Base {
    abstract tran set()
}
class Leaf : Base {
    var counter: int := 0
    redefine tran set(value: int) {
        counter := value
    }
}
@VerificationCase
class Host {
    contains leaf: Leaf[1]
    redefine tran {
        inline leaf.set()
    }
    redefine prop {
        return EF leaf.counter == 1
    }
}
