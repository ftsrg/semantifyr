package flattening::size_from_binding

class Store {
    refers capacity: int
    var slots: int[capacity] := [1, 2, 3, ...]
}
@VerificationCase
class Host {
    contains store: Store {
        redefine refers capacity: int = 0
    }
    var count: int := 0
    redefine tran {
        count := count + 1
    }
    redefine prop {
        return AG count >= 0
    }
}
