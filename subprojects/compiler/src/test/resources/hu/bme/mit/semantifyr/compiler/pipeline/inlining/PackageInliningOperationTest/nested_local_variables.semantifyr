package inlining::tests

@VerificationCase
class Host {
    var counter: int := 0
    tran step() {
        var scratch: int := 0
        scratch := 1
        counter := counter + scratch
    }
    redefine tran {
        inline step()
        inline step()
    }
    redefine prop {
        return EF counter == 2
    }
}
