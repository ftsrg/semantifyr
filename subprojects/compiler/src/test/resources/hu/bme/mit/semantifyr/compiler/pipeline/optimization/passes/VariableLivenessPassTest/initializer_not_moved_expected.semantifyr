inlined oxsts of semantifyr::Anything
var source: int := 0
var seen: int := 0
init {
}
tran {
    var snapshot: int := source
    choice {
        source := 1
    } or {
    }
    seen := snapshot
}
prop {
    AG (seen != source)
}
