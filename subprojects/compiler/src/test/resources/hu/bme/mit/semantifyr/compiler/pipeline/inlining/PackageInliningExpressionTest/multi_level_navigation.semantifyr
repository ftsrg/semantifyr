package inlining::tests::expr_multi_nav

class Leaf {
    var value: int := 0
    prop isBig(): bool {
        return value > 10
    }
}
class Middle {
    contains leaf: Leaf[1]
}
@VerificationCase
class Host {
    contains middle: Middle[1]
    redefine tran {
        middle.leaf.value := middle.leaf.value + 1
    }
    redefine prop {
        return EF middle.leaf.isBig()
    }
}
