package inlining::tests

class Worker {
    var done: bool := false
    tran step() {
        done := true
    }
}
global containment worker: Worker[1]
global reference alias: Worker[1] = worker
@VerificationCase
class Host {
    redefine tran {
        inline alias.step()
    }
    redefine prop {
        return AG true
    }
}
