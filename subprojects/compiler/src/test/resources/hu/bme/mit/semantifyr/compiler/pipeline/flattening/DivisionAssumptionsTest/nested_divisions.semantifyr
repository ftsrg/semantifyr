package flattening::division

@VerificationCase
class Host {
    var divisor: int := 0
    var result: int := 0
    redefine tran {
        havoc(divisor)
        result := 12 / (6 / divisor)
        if (result / divisor > 1) {
            result := 0
        }
    }
    redefine prop {
        return AG result >= 0
    }
}
