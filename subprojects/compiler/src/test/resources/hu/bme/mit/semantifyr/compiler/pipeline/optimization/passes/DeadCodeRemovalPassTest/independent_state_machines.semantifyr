inlined oxsts of semantifyr::Anything
var stateA: int := 0
var stateB: int := 0
var event: int := 0
init {
}
tran {
    havoc(event)
    choice {
        assume(event == 1)
        stateA := 1
    } or {
        assume(event == 2)
        stateB := 1
    }
}
prop {
    AG (stateA != 1)
}
