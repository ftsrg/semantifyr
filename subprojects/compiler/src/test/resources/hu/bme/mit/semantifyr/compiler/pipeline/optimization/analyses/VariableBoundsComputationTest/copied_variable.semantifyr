inlined oxsts of semantifyr::Anything
var counter: int := 0
var doubled: int := 0
init {
}
tran {
    if (counter < 10) {
        counter := counter + 1
    } else {
        counter := 0
    }
    doubled := counter * 2
}
prop {
    AG (doubled <= 20)
}
