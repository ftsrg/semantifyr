package inlining::tests

class Base {
    tran act() {
    }
}
class Middle : Base {
    var middleValue: int := 0
    redefine tran act() {
        middleValue := 1
    }
}
class Leaf : Middle {
    var leafValue: int := 0
    redefine tran act() {
        leafValue := 2
    }
}
@VerificationCase
class Testing {
    contains bases: Base[0..*]
    contains leaf: Leaf[1] subsets bases
    redefine tran {
        inline bases.act()
    }
    redefine prop {
        return EF leaf.leafValue == 2
    }
}
