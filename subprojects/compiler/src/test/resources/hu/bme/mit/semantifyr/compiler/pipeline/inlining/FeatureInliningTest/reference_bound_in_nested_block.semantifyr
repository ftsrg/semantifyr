package inlining::tests

class Lamp {
    var on: bool := false
    tran switchOn() {
        on := true
    }
}
class Switch {
    refers lamp: Lamp[1]
    tran press() {
        inline lamp.switchOn()
    }
}
@VerificationCase
class Host {
    contains kitchen: Lamp[1]
    contains hall: Lamp[1]
    contains button: Switch[1] {
        redefine refers lamp: Lamp[1] = kitchen
    }
    redefine tran {
        inline button.press()
    }
    redefine prop {
        return AG true
    }
}
