inlined oxsts of semantifyr::Anything
var divisor: int := 0
var quotient: int := 0
init {
}
tran {
    choice {
        divisor := 0
    } or {
        divisor := 2
    }
    quotient := 10 / divisor
}
prop {
    AG (quotient <= 10)
}
