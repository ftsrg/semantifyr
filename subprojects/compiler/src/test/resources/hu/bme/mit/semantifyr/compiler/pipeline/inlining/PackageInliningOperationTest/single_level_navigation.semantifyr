package inlining::tests

class Worker {
    var done: bool := false
    tran step() {
        done := true
    }
}
@VerificationCase
class Host {
    contains worker: Worker[1]
    redefine tran {
        inline worker.step()
    }
    redefine prop {
        return EF worker.done
    }
}
