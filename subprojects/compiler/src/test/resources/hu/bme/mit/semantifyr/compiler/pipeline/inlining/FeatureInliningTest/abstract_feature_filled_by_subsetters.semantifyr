package inlining::tests

class Item {
    var hits: int := 0
    tran act() {
        hits := hits + 1
    }
}
@VerificationCase
class Host {
    features items: Item[0..*]
    contains first: Item[1] subsets items
    contains second: Item[1] subsets items
    contains other: Item[1]
    redefine tran {
        inline for (item in items) {
            inline item.act()
        }
    }
    redefine prop {
        return AG true
    }
}
