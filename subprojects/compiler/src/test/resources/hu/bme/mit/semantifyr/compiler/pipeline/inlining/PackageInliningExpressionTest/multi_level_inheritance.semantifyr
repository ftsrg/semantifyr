package inlining::tests::expr_multi_inheritance

class Base {
    prop marker(): bool {
        return false
    }
}
class Middle : Base {
    var middleValue: int := 0
    redefine prop marker(): bool {
        return middleValue == 1
    }
}
class Leaf : Middle {
    var leafValue: int := 0
    redefine prop marker(): bool {
        return leafValue == 2
    }
}
@VerificationCase
class Testing {
    contains bases: Base[0..*]
    contains leaf: Leaf[1] subsets bases
    redefine tran {
        leaf.leafValue := 2
    }
    redefine prop {
        return EF bases.marker()
    }
}
