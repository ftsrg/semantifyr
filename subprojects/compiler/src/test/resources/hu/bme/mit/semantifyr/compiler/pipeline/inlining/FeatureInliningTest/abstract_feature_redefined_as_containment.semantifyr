package inlining::tests

class Item {
    var hits: int := 0
    tran act() {
        hits := hits + 1
    }
}
abstract class Slot {
    features payload: Item
    tran run() {
        inline payload.act()
    }
}
class FilledSlot : Slot {
    redefine contains payload: Item[1]
}
@VerificationCase
class Host {
    contains slot: FilledSlot[1]
    redefine tran {
        inline slot.run()
    }
    redefine prop {
        return AG true
    }
}
