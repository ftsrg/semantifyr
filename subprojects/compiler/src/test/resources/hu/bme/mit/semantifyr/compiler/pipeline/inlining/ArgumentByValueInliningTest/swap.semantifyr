package inlining::tests

@VerificationCase
class Host {
    var x: int := 1
    var y: int := 2
    tran swap(first: int, second: int) {
        x := second
        y := first
    }
    redefine tran {
        inline swap(x, y)
    }
    redefine prop {
        return EF x == 2 && y == 1
    }
}
