package inlining::tests::traced_runtime_argument

class Port {
    var item: int := 0

    @Trace
    tran send(value: int) {
        item := value
    }
}

enum Mode {
    Off,
    On,
}

class Switch {
    var mode: Mode := Mode::Off
    var enabled: bool := false

    @Trace
    tran set(next: Mode) {
        mode := next
    }

    @Trace
    tran enable(value: bool) {
        enabled := value
    }
}

class Display {
    var reading: real := 0.0
    var label: string := ""
    var seen: bool := false

    @Trace
    tran show(value: real) {
        reading := value
    }

    @Trace
    tran write(text: string) {
        label := text
    }

    @Trace
    tran note(value: any) {
        seen := true
    }
}

class Lamp {
    var on: bool := false

    @Trace
    tran toggle(partner: Lamp) {
        on := !on
    }
}

@VerificationCase
class IntegerArgument {
    contains port: Port
    var count: int := 0

    redefine tran {
        choice {
            count := 1
        } or {
            count := 2
        }
        inline port.send(count)
    }

    redefine prop {
        return AG port.item >= 0
    }
}

@VerificationCase
class BooleanArgument {
    contains device: Switch
    var requested: bool := false

    redefine tran {
        havoc(requested)
        inline device.enable(requested)
    }

    redefine prop {
        return AG true
    }
}

@VerificationCase
class EnumArgument {
    contains device: Switch
    var requested: Mode := Mode::Off

    redefine tran {
        choice {
            requested := Mode::Off
        } or {
            requested := Mode::On
        }
        inline device.set(requested)
    }

    redefine prop {
        return AG true
    }
}

@VerificationCase
class RealArgument {
    contains display: Display
    var level: real := 0.5

    redefine tran {
        inline display.show(level)
    }

    redefine prop {
        return AG true
    }
}

@VerificationCase
class StringArgument {
    contains display: Display
    var name: string := "a"

    redefine tran {
        inline display.write(name)
    }

    redefine prop {
        return AG true
    }
}

@VerificationCase
class AnyArgument {
    contains display: Display
    var requested: bool := false

    redefine tran {
        havoc(requested)
        inline display.note(requested)
    }

    redefine prop {
        return AG true
    }
}

@VerificationCase
class ForwardedAnyArgument {
    contains display: Display
    var requested: bool := false

    tran relay(value: any) {
        inline display.note(value)
    }

    redefine tran {
        havoc(requested)
        inline relay(requested)
    }

    redefine prop {
        return AG true
    }
}

@VerificationCase
class AnyVariableArgument {
    contains display: Display
    var stored: any := 0

    redefine tran {
        havoc(stored)
        inline display.note(stored)
    }

    redefine prop {
        return AG true
    }
}

@VerificationCase
class AnyLocalArgument {
    contains display: Display
    var requested: bool := false

    redefine tran {
        var held: any := 0
        havoc(requested)
        held := requested
        inline display.note(held)
    }

    redefine prop {
        return AG true
    }
}

@VerificationCase
class InstanceArgument {
    contains first: Lamp
    contains second: Lamp
    var current: Lamp := first

    redefine tran {
        choice {
            current := first
        } or {
            current := second
        }
        inline first.toggle(current)
    }

    redefine prop {
        return AG true
    }
}
@VerificationCase
class FeatureTypedArgument {
    features lamps: Lamp
    contains first: Lamp[1] subsets lamps
    contains second: Lamp[1] subsets lamps
    var current: Lamp := first

    @Trace
    tran pick(chosen: lamps) {
    }

    redefine tran {
        choice {
            current := first
        } or {
            current := second
        }
        inline pick(current)
    }

    redefine prop {
        return AG true
    }
}

record Point {
    var x: int := 0
}

@VerificationCase
class ForwardedRecordArgument {
    contains display: Display
    var point: Point := Point {
        x = 0
    }

    tran relay(value: any) {
        inline display.note(value)
    }

    redefine tran {
        havoc(point.x)
        inline relay(point)
    }

    redefine prop {
        return AG true
    }
}
