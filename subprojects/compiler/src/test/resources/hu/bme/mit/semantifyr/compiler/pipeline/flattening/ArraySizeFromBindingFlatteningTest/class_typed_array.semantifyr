package flattening::size_from_binding

class Job {
    var done: bool := false
    tran finish() {
        done := true
    }
}
class Queue {
    refers capacity: int
    contains first: Job
    contains second: Job
    var jobs: Job[capacity] := [first, second, ...]
    tran run(index: int) {
        inline jobs[index].finish()
    }
}
@VerificationCase
class Host {
    contains queue: Queue {
        redefine refers capacity: int = 3
    }
    var index: int := 0
    redefine tran {
        havoc(queue.jobs)
        inline queue.run(index)
    }
    redefine prop {
        return EF queue.jobs[2] == queue.second
    }
}
