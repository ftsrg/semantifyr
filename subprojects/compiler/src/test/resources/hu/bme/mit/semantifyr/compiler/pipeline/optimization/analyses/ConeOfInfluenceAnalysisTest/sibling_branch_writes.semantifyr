inlined oxsts of semantifyr::Anything
var observed: int := 0
var unrelated: int := 0
var siblingGuard: int := 0
init {
}
tran {
    choice {
        observed := 1
    } or {
        assume(siblingGuard == 7)
        unrelated := 5
    }
}
prop {
    AG (observed == 1)
}
