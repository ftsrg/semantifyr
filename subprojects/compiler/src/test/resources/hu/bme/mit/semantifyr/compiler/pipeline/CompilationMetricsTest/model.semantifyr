package compilation::metrics

class Counter {
    var count: int := 0

    tran step() {
        if (count < 3) {
            count := count + 1
        }
    }
}

@VerificationCase
class Host {
    contains first: Counter
    contains second: Counter

    redefine tran {
        inline first.step()
        inline second.step()
    }

    redefine prop {
        return EF (first.count == 3 && second.count == 3)
    }
}
