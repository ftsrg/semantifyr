package inlining::tests

class Worker {
}
@VerificationCase
class Host {
    contains worker: Worker[1]
    var current: Worker[0..1] := worker
    tran select(target: Worker[0..1]) {
        current := target
    }
    redefine tran {
        inline select()
    }
    redefine prop {
        return EF current == nothing
    }
}
