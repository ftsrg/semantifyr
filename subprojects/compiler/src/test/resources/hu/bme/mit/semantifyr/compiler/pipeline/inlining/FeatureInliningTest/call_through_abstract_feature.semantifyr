package inlining::tests

class Item {
    var hits: int := 0
    tran act() {
        hits := hits + 1
    }
}
abstract class Slot {
    features payload: Item[0..1]
    tran run() {
        inline payload?.act()
    }
}
class FilledSlot : Slot {
    contains item: Item[1] subsets payload
}
@VerificationCase
class Host {
    contains slot: FilledSlot[1]
    redefine tran {
        inline slot.run()
    }
    redefine prop {
        return AG true
    }
}
