inlined oxsts of semantifyr::Anything
var observed: int := 0
var outerGuard: int := 0
var ifGuard: int := 0
var innerGuard: int := 0
init {
}
tran {
    choice {
        assume(outerGuard == 0)
        if (ifGuard == 1) {
            choice {
                assume(innerGuard == 1)
                observed := 1
            } or {
                assume(innerGuard == 2)
                observed := 2
            }
        } else {
            observed := 3
        }
    } or {
        assume(outerGuard != 0)
        observed := 4
    }
}
prop {
    AG (observed == 1)
}
