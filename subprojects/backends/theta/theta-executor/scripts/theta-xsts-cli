#!/bin/bash

#
# SPDX-FileCopyrightText: 2026 The Semantifyr Authors
#
# SPDX-License-Identifier: EPL-2.0
#

set -e
SCRIPTDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
JAVA=java
if [ -n "$JAVA_HOME" ]; then
    JAVA="$JAVA_HOME/bin/java"
fi
if [ "$1" = "--version" ]; then
    LD_LIBRARY_PATH="$SCRIPTDIR/lib" DYLD_LIBRARY_PATH="$SCRIPTDIR/lib" "$JAVA" "-Djava.library.path=$SCRIPTDIR/lib" -jar "$SCRIPTDIR/jars/theta-xsts-cli.jar" CEGAR --version
    exit
fi
LD_LIBRARY_PATH="$SCRIPTDIR/lib" DYLD_LIBRARY_PATH="$SCRIPTDIR/lib" "$JAVA" ${THETA_JAVA_OPTS:--Xss512M -Xms1G -Xmx4G} "-Djava.library.path=$SCRIPTDIR/lib" -jar "$SCRIPTDIR/jars/theta-xsts-cli.jar" "$@"
