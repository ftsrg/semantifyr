inlined oxsts of semantifyr::Anything
var counter: int := 0
init {
}
tran {
    assume(counter < 3)
    choice {
        counter := 1
    } or {
    }
    if (counter < 3) {
        counter := 1
    } else {
        counter := 2
    }
    if (counter > 3) {
        counter := 3
    }
}
prop {
    AG true
}
