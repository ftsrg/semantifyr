inlined oxsts of semantifyr::Anything
var bounded: int := 0
var large: int := 0
var huge: int := 1
var unbounded: int := 0
init {
}
tran {
    if (bounded < 3) {
        bounded := bounded + 1
    }
    if (large < 100000) {
        large := large + 25000
    }
    if (huge < 100000) {
        huge := huge * 100000
    }
    unbounded := unbounded + 1
}
prop {
    AG bounded <= 3
}
