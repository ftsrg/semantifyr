inlined oxsts of semantifyr::Anything
var counter: int := 0
var step: int := 0
init {
}
tran {
    assume(step == 0)
    choice {
        counter := 1
    } or {
        counter := 2
    }
    step := 1
} or {
    assume(step == 1)
    choice {
        counter := 3
    } or {
        counter := 4
    }
    step := 2
}
prop {
    AG true
}
