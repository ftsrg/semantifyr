inlined oxsts of semantifyr::Anything
var counter: int := 0
var flag: bool := false
var color: test::colors::Color := test::colors::Color::Red
var elapsed: clock := 0
init {
    havoc(flag)
}
tran {
    choice {
        assume(counter < 3)
        assume(elapsed <= 2)
        counter := counter + 1
        elapsed := 0
    } or {
        if (flag) {
            color := test::colors::Color::Green
        }
    }
}
prop {
    AG (counter <= 3 && (if flag then true else color == test::colors::Color::Red))
}
